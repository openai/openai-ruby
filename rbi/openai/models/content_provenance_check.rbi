      module Result
        extend OpenAI::Internal::Type::Union

        Variants = T.type_alias {
          T.any(OpenAI::ContentProvenanceCheck::Result::C2PA, OpenAI::ContentProvenanceCheck::Result::SynthID)
        }

        class C2PA < OpenAI::Internal::Type::BaseModel
          OrHash = T.type_alias do
            T.any(
              OpenAI::ContentProvenanceCheck::Result::C2PA,
              OpenAI::Internal::AnyHash
            )
          end

          # The UTC RFC 3339 timestamp recorded by the provenance signal for when the asset
          # was generated, when available.
          sig { returns(T.nilable(String)) }
          attr_accessor :generated_at

          # The C2PA manifest issuer, when available.
          sig { returns(T.nilable(String)) }
          attr_accessor :issuer

          # The OpenAI model recorded by the provenance signal, when available.
          sig { returns(T.nilable(String)) }
          attr_accessor :model

          # Whether a supported OpenAI C2PA provenance signal was detected. If
          # `not_detected`, it means the tool did not find supported signals in the uploaded
          # file. The content could still have been generated by OpenAI if the metadata was
          # stripped or has evidence of tampering, the watermark was degraded, it comes from
          # a legacy generation model, or it was created before provenance signals were
          # available. Content could also still be AI-generated by another company's model,
          # which the tool currently does not detect.
          sig { returns(OpenAI::ContentProvenanceCheck::Result::C2PA::Outcome::TaggedSymbol) }
          attr_accessor :outcome

          # The provenance signal type. Always `c2pa`.
          sig { returns(Symbol) }
          attr_accessor :type

          # The validation status of the C2PA manifest in the uploaded image.
          sig { returns(OpenAI::ContentProvenanceCheck::Result::C2PA::ValidationState::TaggedSymbol) }
          attr_accessor :validation_state

          sig do
            params(

              generated_at: T.nilable(String),

              issuer: T.nilable(String),

              model: T.nilable(String),

              outcome: OpenAI::ContentProvenanceCheck::Result::C2PA::Outcome::OrSymbol,

              validation_state: OpenAI::ContentProvenanceCheck::Result::C2PA::ValidationState::OrSymbol,

              type: Symbol
            )
              .returns(T.attached_class)
          end
          def self.new(

            # The UTC RFC 3339 timestamp recorded by the provenance signal for when the asset
            # was generated, when available.
            generated_at:,

            # The C2PA manifest issuer, when available.
            issuer:,

            # The OpenAI model recorded by the provenance signal, when available.
            model:,

            # Whether a supported OpenAI C2PA provenance signal was detected. If
            # `not_detected`, it means the tool did not find supported signals in the uploaded
            # file. The content could still have been generated by OpenAI if the metadata was
            # stripped or has evidence of tampering, the watermark was degraded, it comes from
            # a legacy generation model, or it was created before provenance signals were
            # available. Content could also still be AI-generated by another company's model,
            # which the tool currently does not detect.
            outcome:,

            # The validation status of the C2PA manifest in the uploaded image.
            validation_state:,

            # The provenance signal type. Always `c2pa`.

            type: :c2pa
          )
          end

          sig do
            override.returns(
              {
                generated_at: T.nilable(String),
                issuer: T.nilable(String),
                model: T.nilable(String),
                outcome: OpenAI::ContentProvenanceCheck::Result::C2PA::Outcome::TaggedSymbol,
                type: Symbol,
                validation_state: OpenAI::ContentProvenanceCheck::Result::C2PA::ValidationState::TaggedSymbol
              }
            )
          end
          def to_hash
          end

          # Whether a supported OpenAI C2PA provenance signal was detected. If
          # `not_detected`, it means the tool did not find supported signals in the uploaded
          # file. The content could still have been generated by OpenAI if the metadata was
          # stripped or has evidence of tampering, the watermark was degraded, it comes from
          # a legacy generation model, or it was created before provenance signals were
          # available. Content could also still be AI-generated by another company's model,
          # which the tool currently does not detect.
          module Outcome
            extend OpenAI::Internal::Type::Enum

            TaggedSymbol = T.type_alias { T.all(Symbol, OpenAI::ContentProvenanceCheck::Result::C2PA::Outcome) }
            OrSymbol = T.type_alias { T.any(Symbol, String) }

            DETECTED = T.let(:detected, OpenAI::ContentProvenanceCheck::Result::C2PA::Outcome::TaggedSymbol)
            NOT_DETECTED = T.let(:not_detected, OpenAI::ContentProvenanceCheck::Result::C2PA::Outcome::TaggedSymbol)

            sig { override.returns(T::Array[OpenAI::ContentProvenanceCheck::Result::C2PA::Outcome::TaggedSymbol]) }
            def self.values
            end
          end

          # The validation status of the C2PA manifest in the uploaded image.
          module ValidationState
            extend OpenAI::Internal::Type::Enum

            TaggedSymbol = T.type_alias {
              T.all(Symbol, OpenAI::ContentProvenanceCheck::Result::C2PA::ValidationState)
            }
            OrSymbol = T.type_alias { T.any(Symbol, String) }

            TRUSTED = T.let(:trusted, OpenAI::ContentProvenanceCheck::Result::C2PA::ValidationState::TaggedSymbol)
            VALID = T.let(:valid, OpenAI::ContentProvenanceCheck::Result::C2PA::ValidationState::TaggedSymbol)
