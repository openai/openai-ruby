      module Object
        extend OpenAI::Internal::Type::Enum

        TaggedSymbol = T.type_alias { T.all(Symbol, OpenAI::ContentProvenanceCheck::Object) }
        OrSymbol = T.type_alias { T.any(Symbol, String) }

        CONTENT_PROVENANCE_CHECK = T.let(
          :content_provenance_check,
          OpenAI::ContentProvenanceCheck::Object::TaggedSymbol
        )

        sig { override.returns(T::Array[OpenAI::ContentProvenanceCheck::Object::TaggedSymbol]) }
