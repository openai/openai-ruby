# typed: strong

module OpenAI
  module Models
    ChatCompletionStoreMessage = Chat::ChatCompletionStoreMessage

    module Chat
      class ChatCompletionStoreMessage < OpenAI::Models::Chat::ChatCompletionMessage
        OrHash =
          T.type_alias do
