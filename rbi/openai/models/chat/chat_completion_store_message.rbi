              OpenAI::Chat::ChatCompletionStoreMessage,
              OpenAI::Internal::AnyHash
            )
          end

        # The identifier of the chat message.
        sig { returns(String) }
        attr_accessor :id

        # If a content parts array was provided, this is an array of `text` and
