module OpenAI
  module Resources
    class Audio
      class VoiceConsents
        def create: (
          language: String,
          name: String,
          recording: OpenAI::Internal::file_input,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::Audio::VoiceConsent

        def retrieve: (
          String consent_id,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::Audio::VoiceConsent

        def update: (
          String consent_id,
          name: String,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::Audio::VoiceConsent

        def list: (
          ?after: String,
          ?limit: Integer,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::Internal::CursorPage[OpenAI::Audio::VoiceConsent]

        def delete: (
          String consent_id,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::Audio::VoiceConsentDeleted

        def initialize: (client: OpenAI::Client) -> void
      end
    end
  end
end
