module OpenAI
  module Resources
    class Audio
      class Voices
        def create: (
          body: OpenAI::Models::Audio::VoiceCreateParams::body
          | {
            audio_sample: OpenAI::Internal::file_input,
            consent: String,
            name: String,
            ?type: OpenAI::Models::Audio::VoiceCreateParams::Body::AudioSample::type_
          }
          | {
            name: String,
            prompt: String,
            type: OpenAI::Models::Audio::VoiceCreateParams::Body::Prompt::type_,
            ?model: String | :auto | :"2026-10-08",
            ?script_hint: String
          },
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::Audio::Voice

        def initialize: (client: OpenAI::Client) -> void
      end
    end
  end
end
