module OpenAI
  module Resources
    class Models
      def with_raw_response: -> Models::WithRawResponse
      def retrieve: (
        String model,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Model

      def list: (
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Internal::Page[OpenAI::Model]

      def delete: (
        String model,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::ModelDeleted

      def initialize: (client: OpenAI::Internal::Transport::_RequestClient) -> void

      class WithRawResponse
        def retrieve: (
        String model,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Model]

        def list: (?request_options: OpenAI::request_opts) -> OpenAI::RawResponse[OpenAI::Internal::Page[OpenAI::Model]]

        def delete: (
        String model,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::ModelDeleted]

        def initialize: (resource: Models) -> void
      end
    end
  end
end
