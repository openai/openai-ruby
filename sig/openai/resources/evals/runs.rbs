        ) -> OpenAI::Models::Evals::RunCancelResponse

        def initialize: (client: OpenAI::Internal::Transport::_RequestClient) -> void

        class WithRawResponse
          attr_reader output_items: OpenAI::Resources::Evals::Runs::OutputItems::WithRawResponse

          def create: (
          String eval_id,
