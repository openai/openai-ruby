          def list: (
          String eval_id,
          ?after: String,
          ?limit: Integer,
          ?order: OpenAI::Models::Evals::RunListParams::order,
          ?status: OpenAI::Models::Evals::RunListParams::status,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::RawResponse[OpenAI::Internal::CursorPage[OpenAI::Models::Evals::RunListResponse]]

