module OpenAI
  module Resources
    class Skills
      def with_raw_response: -> Skills::WithRawResponse
      attr_reader content: OpenAI::Resources::Skills::Content

      attr_reader versions: OpenAI::Resources::Skills::Versions

      def create: (
        ?files: OpenAI::Models::SkillCreateParams::files,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Skill

      def retrieve: (
        String skill_id,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Skill

      def update: (
        String skill_id,
        default_version: String,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Skill

      def list: (
        ?after: String,
        ?limit: Integer,
        ?order: OpenAI::Models::SkillListParams::order,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Internal::CursorPage[OpenAI::Skill]

      def delete: (
        String skill_id,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::DeletedSkill

      def initialize: (client: OpenAI::Internal::Transport::_RequestClient) -> void

      class WithRawResponse
        attr_reader content: OpenAI::Resources::Skills::Content::WithRawResponse

        attr_reader versions: OpenAI::Resources::Skills::Versions::WithRawResponse

        def create: (
        ?files: OpenAI::Models::SkillCreateParams::files,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Skill]

        def retrieve: (
        String skill_id,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Skill]

        def update: (
        String skill_id,
        default_version: String,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Skill]

        def list: (
        ?after: String,
        ?limit: Integer,
        ?order: OpenAI::Models::SkillListParams::order,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Internal::CursorPage[OpenAI::Skill]]

        def delete: (
        String skill_id,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::DeletedSkill]

        def initialize: (resource: Skills) -> void
      end
    end
  end
end
