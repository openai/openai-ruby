module OpenAI
  module Resources
    class Uploads
      def with_raw_response: -> Uploads::WithRawResponse
      attr_reader parts: OpenAI::Resources::Uploads::Parts

      def create: (
        bytes: Integer,
        filename: String,
        mime_type: String,
        purpose: OpenAI::Models::file_purpose,
        ?expires_after: OpenAI::UploadCreateParams::ExpiresAfter,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Upload

      def cancel: (
        String upload_id,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Upload

      def complete: (
        String upload_id,
        part_ids: ::Array[String],
        ?md5: String,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::Upload

      def initialize: (client: OpenAI::Internal::Transport::_RequestClient) -> void

      class WithRawResponse
        attr_reader parts: OpenAI::Resources::Uploads::Parts::WithRawResponse

        def create: (
        bytes: Integer,
        filename: String,
        mime_type: String,
        purpose: OpenAI::Models::file_purpose,
        ?expires_after: OpenAI::UploadCreateParams::ExpiresAfter,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Upload]

        def cancel: (
        String upload_id,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Upload]

        def complete: (
        String upload_id,
        part_ids: ::Array[String],
        ?md5: String,
        ?request_options: OpenAI::request_opts
      ) -> OpenAI::RawResponse[OpenAI::Upload]

        def initialize: (resource: Uploads) -> void
      end
    end
  end
end
