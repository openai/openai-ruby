          ) -> OpenAI::Admin::Organization::OrganizationUser

          def list: (
            ?after: String,
            ?emails: ::Array[String],
            ?limit: Integer,
            ?request_options: OpenAI::request_opts
          ) -> OpenAI::Internal::ConversationCursorPage[OpenAI::Admin::Organization::OrganizationUser]

          def delete: (
            String user_id,
            ?request_options: OpenAI::request_opts
          ) -> OpenAI::Models::Admin::Organization::UserDeleteResponse

          def initialize: (client: OpenAI::Internal::Transport::_RequestClient) -> void

          class WithRawResponse
            attr_reader roles: OpenAI::Resources::Admin::Organization::Users::Roles::WithRawResponse

            def retrieve: (
