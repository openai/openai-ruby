module OpenAI
  class Client
    # @api private
    def with_websocket_connection_request: (
      request: OpenAI::Internal::Transport::BaseClient::request_components,
      ?websocket_base_url: String?,
      ?options: OpenAI::request_opts?,
      ?recovery_request: untyped
    ) {
      (
        OpenAI::Internal::Transport::BaseClient::request_input request,
        ^-> void mark_handshake_completed
      ) -> top
    } -> top
  end

  module WebSocket
    module RecoveryConnection
      # @api private
      def update_recovery_url: (URI::Generic url) -> nil
      def reconnecting?: -> bool
      def pending_messages: -> Array[String]
      def take_pending_messages: -> Array[String]
      def flush_pending: -> nil
    end

    module Resource
      def connect: (
        *untyped path_arguments,
        ?query: Hash[untyped, untyped],
        ?websocket_base_url: String?,
        ?request_options: untyped,
        ?transport: untyped,
        ?transport_options: Hash[untyped, untyped]
      ) {
        (TypedConnection[untyped, untyped]) -> untyped
      } -> untyped
    end

    module TypedResource[WebSocketClientEvent, WebSocketServerEvent]
      include Resource

      def connect: (
        *untyped path_arguments,
        ?query: Hash[untyped, untyped],
        ?websocket_base_url: String?,
        ?request_options: untyped,
        ?transport: untyped,
        ?transport_options: Hash[untyped, untyped]
      ) {
        (TypedConnection[WebSocketClientEvent, WebSocketServerEvent]) -> untyped
      } -> untyped
    end

    class TypedConnection[in ClientEvent, out Elem]
      include Enumerable[Elem]

      attr_reader url: URI::Generic
      def receive: -> Elem?
      def send_event: (
        ClientEvent | Hash[String | Symbol, untyped] event
      ) -> void
      def each: -> Enumerator[Elem, self] | { (Elem) -> void } -> self
      def close: (?code: Integer, ?reason: String) -> void
      def closed?: -> bool
    end
  end

  module Errors
    class WebSocketQueueFullError < OpenAI::Errors::Error
      def initialize: (?String message) -> void
    end
    class WebSocketReconnectError < OpenAI::Errors::Error
      attr_reader unsent_messages: Array[String]
      attr_reader uncertain_message: String?

      # @api private
      def initialize: (
        message: String,
        ?unsent_messages: Array[String],
        ?uncertain_message: String?
      ) -> void
    end
    class WebSocketConnectionError < OpenAI::Errors::Error
      attr_reader url: URI::Generic
      attr_reader http_status: Integer?
      def cause: -> Exception?
      def initialize: (
        url: URI::Generic,
        ?message: String?,
        ?cause: Exception?,
        ?http_status: Integer?
      ) -> void
    end

    class WebSocketProtocolError < OpenAI::Errors::Error
    end
  end
end
