module OpenAI
  module Resources
    class VectorStores
      class Files
        def create_and_poll: (
          String vector_store_id,
          file_id: String,
          ?attributes: ::Hash[Symbol, OpenAI::Models::VectorStores::FileCreateParams::attribute]?,
          ?chunking_strategy: OpenAI::Models::file_chunking_strategy_param,
          ?poll_interval: (Integer | Float)?,
          ?timeout: (Integer | Float)?,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::VectorStores::VectorStoreFile

        def poll: (
          String file_id,
          vector_store_id: String,
          ?poll_interval: (Integer | Float)?,
          ?timeout: (Integer | Float)?,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::VectorStores::VectorStoreFile

        def upload: (
          String vector_store_id,
          file: OpenAI::Internal::file_input,
          ?attributes: ::Hash[Symbol, OpenAI::Models::VectorStores::FileCreateParams::attribute]?,
          ?chunking_strategy: OpenAI::Models::file_chunking_strategy_param,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::VectorStores::VectorStoreFile

        def upload_and_poll: (
          String vector_store_id,
          file: OpenAI::Internal::file_input,
          ?attributes: ::Hash[Symbol, OpenAI::Models::VectorStores::FileCreateParams::attribute]?,
          ?chunking_strategy: OpenAI::Models::file_chunking_strategy_param,
          ?poll_interval: (Integer | Float)?,
          ?timeout: (Integer | Float)?,
          ?request_options: OpenAI::request_opts
        ) -> OpenAI::VectorStores::VectorStoreFile
      end
    end
  end
end
