module OpenAI
  module Models
    module Realtime
      class AudioSession
        def start: -> self
        def mute: -> self
        def unmute: -> self
        def state: -> (:ready | :running | :closing | :closed | :failed)
        def close: -> nil
        def wait: -> nil
        def respond: -> nil
        def start_turn: -> OpenAI::Realtime::AudioSession::InputTurn
        def interrupt: -> OpenAI::Realtime::AudioSession::Interruption
        def send_text: (String text) -> nil
        def submit_tool_output: (call_id: String, output: String) -> nil
        type event =
          OpenAI::Models::Realtime::connection_server_event
          | OpenAI::Realtime::AudioSession::PlaybackStarted
          | OpenAI::Realtime::AudioSession::PlaybackFinished
          | OpenAI::Realtime::AudioSession::PlaybackInterrupted
          | OpenAI::Realtime::AudioSession::InputStateChanged
          | OpenAI::Realtime::AudioSession::Closed
        def each: ?{ (event) -> void } -> (Enumerator[event, self] | self)
        class InputTurn
          def commit: -> nil
          def discard: -> nil
        end
        class PlaybackStarted
          def initialize: (
            response_id: String,
            item_id: String,
            content_index: Integer
          ) -> void
          attr_reader response_id: String
          attr_reader item_id: String
          attr_reader content_index: Integer
        end
        class PlaybackFinished
          def initialize: (
            response_id: String,
            item_id: String,
            content_index: Integer,
            position: OpenAI::LocalAudio::PlaybackPosition
          ) -> void
          attr_reader response_id: String
          attr_reader item_id: String
          attr_reader content_index: Integer
          attr_reader position: OpenAI::LocalAudio::PlaybackPosition
        end
        class PlaybackInterrupted
          def initialize: (
            response_id: String,
            item_id: String,
            content_index: Integer,
            position: OpenAI::LocalAudio::PlaybackPosition,
            reason: Symbol
          ) -> void
          attr_reader response_id: String
          attr_reader item_id: String
          attr_reader content_index: Integer
          attr_reader position: OpenAI::LocalAudio::PlaybackPosition
          attr_reader reason: Symbol
        end
        class ItemPosition
          def initialize: (
            response_id: String,
            item_id: String,
            content_index: Integer,
            position: OpenAI::LocalAudio::PlaybackPosition
          ) -> void
          attr_reader response_id: String
          attr_reader item_id: String
          attr_reader content_index: Integer
          attr_reader position: OpenAI::LocalAudio::PlaybackPosition
        end
        class Interruption
          def initialize: (
            items: Array[OpenAI::Realtime::AudioSession::ItemPosition]
          ) -> void
          attr_reader items: Array[OpenAI::Realtime::AudioSession::ItemPosition]
        end
        class InputStateChanged
          def initialize: (capturing: bool, muted: bool, reason: Symbol) -> void
          attr_reader capturing: bool
          attr_reader muted: bool
          attr_reader reason: Symbol
        end
        class Closed
          def initialize: (reason: :local | :remote) -> void
          attr_reader reason: :local | :remote
        end
      end
    end
  end
  module Errors
    class RealtimeAudioSessionError < OpenAI::Errors::Error
    end
    class RealtimeAudioTurnError < OpenAI::Errors::RealtimeAudioSessionError
      attr_reader event: OpenAI::Realtime::RealtimeErrorEvent

      # @api private
      def initialize: (event: OpenAI::Realtime::RealtimeErrorEvent) -> void
    end
    class RealtimeAudioStateError < OpenAI::Errors::RealtimeAudioSessionError
    end
    class RealtimeAudioConsumerTooSlowError < OpenAI::Errors::RealtimeAudioSessionError
    end
  end
  module Resources
    class Realtime
      def connect_audio: [U] (
        model: String,
        voice: String,
        ?mode: :server_vad | :semantic_vad | :push_to_talk,
        ?input_device: (String | OpenAI::LocalAudio::Device)?,
        ?output_device: (String | OpenAI::LocalAudio::Device)?,
        ?playback_policy: :duplex | :half_duplex,
        ?turn_detection: Hash[Symbol | String, untyped],
        ?session: Hash[Symbol | String, untyped],
        ?audio_options: Hash[Symbol | String, untyped],
        ?websocket_base_url: String?,
        ?request_options: OpenAI::request_opts?,
        ?transport_options: Hash[Symbol | String, untyped]
      ) {
        (OpenAI::Realtime::AudioSession) -> U
      } -> U
    end
  end
end
