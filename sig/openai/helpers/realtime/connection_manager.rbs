module OpenAI
  module Models
    module Realtime
      class ConnectionManager
        # @api private
        def initialize: (
          client: OpenAI::Client,
          query: ::Hash[String, String],
          websocket_base_url: String?,
          transport: untyped,
          request_options: OpenAI::request_opts?,
          transport_options: ::Hash[Symbol, untyped],
          ?connection_class: singleton(OpenAI::Realtime::Connection)
        ) -> void

        # @api private
        def open: { (OpenAI::Realtime::Connection connection) -> top } -> top
      end
    end
  end
end
