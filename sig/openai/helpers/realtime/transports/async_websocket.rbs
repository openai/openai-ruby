module OpenAI
  module Models
    module Realtime
      module Transports
        class AsyncWebSocket
          def initialize: ?{
            (OpenSSL::SSL::SSLContext context) -> void
          } -> void

          def open: (
            url: URI::Generic,
            headers: ::Hash[String, String],
            timeout: Float?,
            **top endpoint_options
          ) {
            (top socket) -> top
          } -> top
        end
      end
    end
  end
end
