module OpenAI
  module Helpers
    module Beta
      module Agents
        class TurnResult
          attr_reader turn: OpenAI::Models::Beta::Agents::Sessions::Turn
          attr_reader messages: Array[OpenAI::Models::Beta::AgentSessionMessage]
          def session_id: -> String
          def turn_id: -> String
          def output_text: -> String
          def output_parsed: -> untyped
          def parse: (
            output_type: singleton(OpenAI::Helpers::StructuredOutput::BaseModel)
          ) -> ParsedTurnResult
        end

        class ResultError < OpenAI::Errors::Error
          attr_reader reason: Symbol
          attr_reader session_id: String?
          attr_reader turn: OpenAI::Models::Beta::Agents::Sessions::Turn?
          attr_reader messages: Array[OpenAI::Models::Beta::AgentSessionMessage]
          attr_reader required_actions: Array[OpenAI::Models::Beta::AgentSession::required_action
          | Hash[Symbol, untyped]]
          def turn_id: -> String?
        end

        # @api private
        class ResultCollector
          def initialize: (
            ?session_id: String?,
            ?handler_names: Array[String]
          ) -> void
          def enable: -> void
          def observe: (
            OpenAI::Models::Beta::agent_session_event
            | Hash[Symbol, untyped] event,
            ?current_root: bool?
          ) -> void
          def select_turn: (
            OpenAI::Models::Beta::Agents::Sessions::Turn? turn
          ) -> void
          def observe_pending_action: (untyped action) -> void
          def recover: (
            turn: OpenAI::Models::Beta::Agents::Sessions::Turn?,
            items: Enumerable[untyped],
            failed: bool
          ) -> void
          def stopped?: -> bool?
          def observe_recovery_error: (StandardError error) -> void
          def observe_error: (StandardError error) -> void
          def result: -> TurnResult
        end

        class ParsedTurnResult < TurnResult
          attr_reader raw_result: TurnResult
          attr_reader output_parsed: untyped
        end

        class OutputParseError < OpenAI::Errors::Error
          attr_reader raw_result: TurnResult
        end

        # @api private
        class OutputParser
          def initialize: (
            singleton(OpenAI::Helpers::StructuredOutput::BaseModel) model
          ) -> void
          def prepare_request: (Hash[Symbol, untyped] params) -> void
          def parse: (TurnResult result) -> ParsedTurnResult
        end

        class CreationStream < OpenAI::Internal::Stream[OpenAI::Models::Beta::agent_session_event]
          def get_final_result: -> TurnResult
          def with_result_collection: -> self

          # @api private
          def configure_output_parser: (OutputParser? parser) -> self
        end
      end
    end
  end
end
