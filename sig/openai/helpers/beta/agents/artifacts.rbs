module OpenAI
  module Helpers
    module Beta
      module Agents
        class ResultArtifacts
          def initialize: (
            artifacts: OpenAI::Resources::Beta::Agents::Sessions::Artifacts,
            client: OpenAI::Client,
            result: TurnResult
          ) -> void
          def download: (
            path: String,
            to: untyped,
            ?request_options: OpenAI::request_opts
          ) -> OpenAI::Models::Beta::Agents::Sessions::SessionArtifact
        end
      end
    end
  end
end

module OpenAI
  module Resources
    class Beta
      class Agents
        class Sessions
          class Artifacts
            # Beta result-scoped downloads.
            def for_result: (
              OpenAI::Helpers::Beta::Agents::TurnResult result
            ) -> OpenAI::Helpers::Beta::Agents::ResultArtifacts
          end
        end
      end
    end
  end
end
