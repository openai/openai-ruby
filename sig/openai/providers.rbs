module OpenAI
  module Providers
    def self.azure: (
      ?endpoint: String?,
      ?api_key: String?,
      ?token_provider: (^-> String)?
    ) -> OpenAI::Provider

    def self.vertex: (
      ?project: String?,
      ?location: String?,
      ?base_url: String?,
      ?token_provider: (^-> String)?,
      ?credentials: untyped
    ) -> OpenAI::Provider

    def self.bedrock: (
      ?endpoint: (:mantle | :runtime | "mantle" | "runtime")?,
      ?region: String?,
      ?base_url: String?,
      ?api_key: String?,
      ?token_provider: (^-> String)?,
      ?access_key_id: String?,
      ?secret_access_key: String?,
      ?session_token: String?,
      ?profile: String?,
      ?credentials_provider: untyped
    ) -> OpenAI::Provider
  end
end
