module OpenAI
  module Models
    module Audio
      type transcription_text_segment_event =
        {
          id: String,
          end_: Float,
          speaker: String,
          start: Float,
          text: String,
          ?type: :"transcript.text.segment"
        }

      class TranscriptionTextSegmentEvent < OpenAI::Internal::Type::BaseModel
        # Unique identifier for the segment.
        attr_accessor id: String

        # End timestamp of the segment in seconds.
        attr_accessor end_: Float

        # Speaker label for this segment.
        attr_accessor speaker: String

        # Start timestamp of the segment in seconds.
        attr_accessor start: Float

        # Transcript text for this segment.
        attr_accessor text: String

        # The type of the event. Always `transcript.text.segment`.
        attr_accessor type: :"transcript.text.segment"

        # @param id
        #   Unique identifier for the segment.
        # @param end_
        #   End timestamp of the segment in seconds.
        # @param speaker
        #   Speaker label for this segment.
        # @param start
        #   Start timestamp of the segment in seconds.
        # @param text
        #   Transcript text for this segment.
        # @param type
        #   The type of the event. Always `transcript.text.segment`.
        def initialize: (
          id: String,
          end_: Float,
          speaker: String,
          start: Float,
          text: String,
          ?type: :"transcript.text.segment"
        ) -> void

        def to_hash: -> {
          id: String,
          end_: Float,
          speaker: String,
          start: Float,
          text: String,
          ?type: :"transcript.text.segment"
        }
      end
    end
  end
end
