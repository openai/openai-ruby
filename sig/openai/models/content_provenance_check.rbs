            validation_state: OpenAI::Models::ContentProvenanceCheck::Result::C2PA::validation_state
          }

          type outcome = :detected | :not_detected

          module Outcome
            extend OpenAI::Internal::Type::Enum

            DETECTED: :detected
            NOT_DETECTED: :not_detected

            def self?.values: -> ::Array[OpenAI::Models::ContentProvenanceCheck::Result::C2PA::outcome]
