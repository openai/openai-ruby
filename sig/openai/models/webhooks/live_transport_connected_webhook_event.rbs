module OpenAI
  module Models
    module Webhooks
      type live_transport_connected_webhook_event =
        {
          id: String,
          created_at: Integer,
          data: OpenAI::Webhooks::LiveTransportConnectedWebhookEvent::Data,
          ?object: :event,
          ?type: :"live.transport.connected"
        }

      class LiveTransportConnectedWebhookEvent < OpenAI::Internal::Type::BaseModel
        # The webhook event ID.
        attr_accessor id: String

        # Unix time in seconds when the event was created.
        attr_accessor created_at: Integer

        attr_accessor data: OpenAI::Webhooks::LiveTransportConnectedWebhookEvent::Data

        attr_accessor object: :event

        attr_accessor type: :"live.transport.connected"

        # @param id
        #   The webhook event ID.
        # @param created_at
        #   Unix time in seconds when the event was created.
        def initialize: (
          id: String,
          created_at: Integer,
          data: OpenAI::Webhooks::LiveTransportConnectedWebhookEvent::Data,
          ?object: :event,
          ?type: :"live.transport.connected"
        ) -> void

        def to_hash: -> {
          id: String,
          created_at: Integer,
          data: OpenAI::Webhooks::LiveTransportConnectedWebhookEvent::Data,
          ?object: :event,
          ?type: :"live.transport.connected"
        }

        type data = { session_id: String, ?type: :webrtc }

        class Data < OpenAI::Internal::Type::BaseModel
          # The Live session ID to use with the sideband attach endpoint.
          attr_accessor session_id: String

          # The session transport.
          attr_accessor type: :webrtc

          # @param session_id
          #   The Live session ID to use with the sideband attach endpoint.
          # @param type
          #   The session transport.
          def initialize: (session_id: String, ?type: :webrtc) -> void

          def to_hash: -> { session_id: String, ?type: :webrtc }
        end
      end
    end
  end
end
