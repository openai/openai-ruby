module OpenAI
  module Models
    module Webhooks
      type webhook_endpoint_with_secret =
        {
          id: String,
          created_at: Integer,
          event_types: ::Array[String],
          name: String,
          ?object: :webhook_endpoint,
          signing_secret: String,
          signing_secret_hint: String?,
          url: String,
          ?updated_at: Integer
        }

      class WebhookEndpointWithSecret < OpenAI::Internal::Type::BaseModel
        # The unique ID of the webhook endpoint.
        attr_accessor id: String

        # The Unix timestamp when the endpoint was created.
        attr_accessor created_at: Integer

        # The event types that trigger deliveries to this endpoint.
        attr_accessor event_types: ::Array[String]

        # The human-readable name of the endpoint.
        attr_accessor name: String

        # The object type, which is always webhook_endpoint.
        attr_accessor object: :webhook_endpoint

        # The endpoint's signing secret. This is returned only when the endpoint is
        # created or the secret is rotated.
        attr_accessor signing_secret: String

        # A masked hint for the endpoint's signing secret.
        attr_accessor signing_secret_hint: String?

        # The HTTPS URL that receives webhook deliveries.
        attr_accessor url: String

        # The Unix timestamp of the last endpoint configuration or signing-secret change.
        # Initialized at creation; tests and unchanged updates do not advance it.
        attr_reader updated_at: Integer?

        # The Unix timestamp of the last endpoint configuration or signing-secret change.
        # Initialized at creation; tests and unchanged updates do not advance it.
        def updated_at=: (Integer) -> Integer

        # @param id
        #   The unique ID of the webhook endpoint.
        # @param created_at
        #   The Unix timestamp when the endpoint was created.
        # @param event_types
        #   The event types that trigger deliveries to this endpoint.
        # @param name
        #   The human-readable name of the endpoint.
        # @param signing_secret
        #   The endpoint's signing secret. This is returned only when the endpoint is
        #   created or the secret is rotated.
        # @param signing_secret_hint
        #   A masked hint for the endpoint's signing secret.
        # @param url
        #   The HTTPS URL that receives webhook deliveries.
        # @param updated_at
        #   The Unix timestamp of the last endpoint configuration or signing-secret change.
        #   Initialized at creation; tests and unchanged updates do not advance it.
        # @param object
        #   The object type, which is always webhook_endpoint.
        def initialize: (
          id: String,
          created_at: Integer,
          event_types: ::Array[String],
          name: String,
          signing_secret: String,
          signing_secret_hint: String?,
          url: String,
          ?updated_at: Integer,
          ?object: :webhook_endpoint
        ) -> void

        def to_hash: -> {
          id: String,
          created_at: Integer,
          event_types: ::Array[String],
          name: String,
          ?object: :webhook_endpoint,
          signing_secret: String,
          signing_secret_hint: String?,
          url: String,
          ?updated_at: Integer
        }
      end
    end
  end
end
