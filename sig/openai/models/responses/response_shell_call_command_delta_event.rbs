module OpenAI
  module Models
    module Responses
      type response_shell_call_command_delta_event =
        {
          command_index: Integer,
          delta: String,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.shell_call_command.delta",
          ?obfuscation: String
        }

      class ResponseShellCallCommandDeltaEvent < OpenAI::Internal::Type::BaseModel
        # The index of the shell command that was updated.
        attr_accessor command_index: Integer

        # The shell command delta that was appended.
        attr_accessor delta: String

        # The index of the output item that was updated.
        attr_accessor output_index: Integer

        # The sequence number of the event that was emitted.
        attr_accessor sequence_number: Integer

        # The type of the event, always `response.shell_call_command.delta`.
        attr_accessor type: :"response.shell_call_command.delta"

        # An obfuscation string that was added to pad the event payload.
        attr_reader obfuscation: String?

        # An obfuscation string that was added to pad the event payload.
        def obfuscation=: (String) -> String

        # @param command_index
        #   The index of the shell command that was updated.
        # @param delta
        #   The shell command delta that was appended.
        # @param output_index
        #   The index of the output item that was updated.
        # @param sequence_number
        #   The sequence number of the event that was emitted.
        # @param obfuscation
        #   An obfuscation string that was added to pad the event payload.
        # @param type
        #   The type of the event, always `response.shell_call_command.delta`.
        def initialize: (
          command_index: Integer,
          delta: String,
          output_index: Integer,
          sequence_number: Integer,
          ?obfuscation: String,
          ?type: :"response.shell_call_command.delta"
        ) -> void

        def to_hash: -> {
          command_index: Integer,
          delta: String,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.shell_call_command.delta",
          ?obfuscation: String
        }
      end
    end
  end
end
