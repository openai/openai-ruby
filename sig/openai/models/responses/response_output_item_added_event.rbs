module OpenAI
  module Models
    module Responses
      type response_output_item_added_event =
        {
          item: OpenAI::Models::Responses::response_output_item,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_item.added"
        }

      class ResponseOutputItemAddedEvent < OpenAI::Internal::Type::BaseModel
        # The output item that was added. For reasoning items, `encrypted_content` may be
        # incomplete while the item is in progress. Use the reasoning item from the
        # corresponding `response.output_item.done` event when passing it as input to a
        # subsequent request.
        attr_accessor item: OpenAI::Models::Responses::response_output_item

        # The index of the output item that was added.
        attr_accessor output_index: Integer

        # The sequence number of this event.
        attr_accessor sequence_number: Integer

        # The type of the event. Always `response.output_item.added`.
        attr_accessor type: :"response.output_item.added"

        # @param item
        #   The output item that was added. For reasoning items, `encrypted_content` may be
        #   incomplete while the item is in progress. Use the reasoning item from the
        #   corresponding `response.output_item.done` event when passing it as input to a
        #   subsequent request.
        # @param output_index
        #   The index of the output item that was added.
        # @param sequence_number
        #   The sequence number of this event.
        # @param type
        #   The type of the event. Always `response.output_item.added`.
        def initialize: (
          item: OpenAI::Models::Responses::response_output_item,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_item.added"
        ) -> void

        def to_hash: -> {
          item: OpenAI::Models::Responses::response_output_item,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_item.added"
        }
      end
    end
  end
end
