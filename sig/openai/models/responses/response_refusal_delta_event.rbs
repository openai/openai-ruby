module OpenAI
  module Models
    module Responses
      type response_refusal_delta_event =
        {
          content_index: Integer,
          delta: String,
          item_id: String,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.refusal.delta"
        }

      class ResponseRefusalDeltaEvent < OpenAI::Internal::Type::BaseModel
        # The index of the content part that the refusal text is added to.
        attr_accessor content_index: Integer

        # The refusal text that is added.
        attr_accessor delta: String

        # The ID of the output item that the refusal text is added to.
        attr_accessor item_id: String

        # The index of the output item that the refusal text is added to.
        attr_accessor output_index: Integer

        # The sequence number of this event.
        attr_accessor sequence_number: Integer

        # The type of the event. Always `response.refusal.delta`.
        attr_accessor type: :"response.refusal.delta"

        # @param content_index
        #   The index of the content part that the refusal text is added to.
        # @param delta
        #   The refusal text that is added.
        # @param item_id
        #   The ID of the output item that the refusal text is added to.
        # @param output_index
        #   The index of the output item that the refusal text is added to.
        # @param sequence_number
        #   The sequence number of this event.
        # @param type
        #   The type of the event. Always `response.refusal.delta`.
        def initialize: (
          content_index: Integer,
          delta: String,
          item_id: String,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.refusal.delta"
        ) -> void

        def to_hash: -> {
          content_index: Integer,
          delta: String,
          item_id: String,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.refusal.delta"
        }
      end
    end
  end
end
