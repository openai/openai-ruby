module OpenAI
  module Models
    module Responses
      type container_reference =
        { container_id: String, ?type: :container_reference }

      class ContainerReference < OpenAI::Internal::Type::BaseModel
        # The ID of the referenced container.
        attr_accessor container_id: String

        # References a container created with the /v1/containers endpoint
        attr_accessor type: :container_reference

        # @param container_id
        #   The ID of the referenced container.
        # @param type
        #   References a container created with the /v1/containers endpoint
        def initialize: (
          container_id: String,
          ?type: :container_reference
        ) -> void

        def to_hash: -> { container_id: String, ?type: :container_reference }
      end
    end
  end
end
