      class ResponseShellCallOutputContentDeltaEvent < OpenAI::Internal::Type::BaseModel
        # The index of the shell command that produced output.
        attr_accessor command_index: Integer

        # The stdout/stderr delta that was emitted.
        attr_accessor delta: OpenAI::Responses::ResponseShellCallOutputContentDeltaEvent::Delta

        # The ID of the output item that was updated.
        attr_accessor item_id: String

        # The index of the output item that was updated.
        attr_accessor output_index: Integer

        # The sequence number of the event that was emitted.
        attr_accessor sequence_number: Integer

        # The type of the event, always `response.shell_call_output_content.delta`.
        attr_accessor type: :"response.shell_call_output_content.delta"

        # @param command_index
        #   The index of the shell command that produced output.
        # @param delta
