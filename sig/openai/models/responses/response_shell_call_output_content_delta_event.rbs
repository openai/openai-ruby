        type delta = { ?stderr: String, ?stdout: String }

        class Delta < OpenAI::Internal::Type::BaseModel
          # The stderr delta that was emitted.
          attr_reader stderr: String?

          # The stderr delta that was emitted.
          def stderr=: (String) -> String

          # The stdout delta that was emitted.
          attr_reader stdout: String?

