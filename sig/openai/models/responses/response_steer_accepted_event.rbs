module OpenAI
  module Models
    module Responses
      type response_steer_accepted_event =
        {
          sequence_number: Integer,
          steer: OpenAI::Responses::ResponseSteerAcceptedEvent::Steer,
          ?type: :"response.steer.accepted",
          ?stream_id: String
        }

      class ResponseSteerAcceptedEvent < OpenAI::Internal::Type::BaseModel
        # The sequence number for this event.
        attr_accessor sequence_number: Integer

        # The accepted steering submission.
        attr_accessor steer: OpenAI::Responses::ResponseSteerAcceptedEvent::Steer

        # The event discriminator. Always `response.steer.accepted`.
        attr_accessor type: :"response.steer.accepted"

        # The WebSocket lane that emitted this event. This field is present when the
        # target response's `response.create` event supplied a `stream_id`.
        attr_reader stream_id: String?

        # The WebSocket lane that emitted this event. This field is present when the
        # target response's `response.create` event supplied a `stream_id`.
        def stream_id=: (String) -> String

        # @param sequence_number
        #   The sequence number for this event.
        # @param steer
        #   The accepted steering submission.
        # @param stream_id
        #   The WebSocket lane that emitted this event. This field is present when the
        #   target response's `response.create` event supplied a `stream_id`.
        # @param type
        #   The event discriminator. Always `response.steer.accepted`.
        def initialize: (
          sequence_number: Integer,
          steer: OpenAI::Responses::ResponseSteerAcceptedEvent::Steer,
          ?stream_id: String,
          ?type: :"response.steer.accepted"
        ) -> void

        def to_hash: -> {
          sequence_number: Integer,
          steer: OpenAI::Responses::ResponseSteerAcceptedEvent::Steer,
          ?type: :"response.steer.accepted",
          ?stream_id: String
        }

        type steer = { id: String, previous_response_id: String }

        class Steer < OpenAI::Internal::Type::BaseModel
          # The ID assigned to the steering submission.
          attr_accessor id: String

          # The ID of the response being steered.
          attr_accessor previous_response_id: String

          # @param id
          #   The ID assigned to the steering submission.
          # @param previous_response_id
          #   The ID of the response being steered.
          def initialize: (id: String, previous_response_id: String) -> void

          def to_hash: -> { id: String, previous_response_id: String }
        end
      end
    end
  end
end
