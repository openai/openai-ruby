module OpenAI
  module Models
    module Responses
      type compacted_response =
        {
          id: String,
          created_at: Integer,
          ?object: :"response.compaction",
          output: ::Array[OpenAI::Models::Responses::response_output_item],
          usage: OpenAI::Responses::ResponseUsage,
          ?image: OpenAI::Responses::CompactedResponse::Image
        }

      class CompactedResponse < OpenAI::Internal::Type::BaseModel
        # The unique identifier for the compacted response.
        attr_accessor id: String

        # Unix timestamp (in seconds) when the compacted conversation was created.
        attr_accessor created_at: Integer

        # The object type. Always `response.compaction`.
        attr_accessor object: :"response.compaction"

        # The compacted list of output items. This is a list of all user messages,
        # followed by a single compaction item.
        attr_accessor output: ::Array[OpenAI::Models::Responses::response_output_item]

        # Token accounting for the compaction pass, including cached, reasoning, and total
        # tokens.
        attr_accessor usage: OpenAI::Responses::ResponseUsage

        attr_reader image: OpenAI::Responses::CompactedResponse::Image?

        def image=: (
          OpenAI::Responses::CompactedResponse::Image
        ) -> OpenAI::Responses::CompactedResponse::Image

        # @param id
        #   The unique identifier for the compacted response.
        # @param created_at
        #   Unix timestamp (in seconds) when the compacted conversation was created.
        # @param output
        #   The compacted list of output items. This is a list of all user messages,
        #   followed by a single compaction item.
        # @param usage
        #   Token accounting for the compaction pass, including cached, reasoning, and total
        #   tokens.
        # @param object
        #   The object type. Always `response.compaction`.
        def initialize: (
          id: String,
          created_at: Integer,
          output: ::Array[OpenAI::Models::Responses::response_output_item],
          usage: OpenAI::Responses::ResponseUsage,
          ?image: OpenAI::Responses::CompactedResponse::Image,
          ?object: :"response.compaction"
        ) -> void

        def to_hash: -> {
          id: String,
          created_at: Integer,
          ?object: :"response.compaction",
          output: ::Array[OpenAI::Models::Responses::response_output_item],
          usage: OpenAI::Responses::ResponseUsage,
          ?image: OpenAI::Responses::CompactedResponse::Image
        }

        type image =
          {
            context_compression: OpenAI::Models::Responses::CompactedResponse::Image::context_compression
          }

        class Image < OpenAI::Internal::Type::BaseModel
          # Effective image context optimization policy.
          attr_accessor context_compression: OpenAI::Models::Responses::CompactedResponse::Image::context_compression

          # @param context_compression
          #   Effective image context optimization policy.
          def initialize: (
            context_compression: OpenAI::Models::Responses::CompactedResponse::Image::context_compression
          ) -> void

          def to_hash: -> {
            context_compression: OpenAI::Models::Responses::CompactedResponse::Image::context_compression
          }

          type context_compression = :enabled | :disabled

          module ContextCompression
            extend OpenAI::Internal::Type::Enum

            ENABLED: :enabled
            DISABLED: :disabled

            def self?.values: -> ::Array[OpenAI::Models::Responses::CompactedResponse::Image::context_compression]
          end
        end
      end
    end
  end
end
