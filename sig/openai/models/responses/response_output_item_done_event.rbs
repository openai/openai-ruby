module OpenAI
  module Models
    module Responses
      type response_output_item_done_event =
        {
          item: OpenAI::Models::Responses::response_output_item,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_item.done"
        }

      class ResponseOutputItemDoneEvent < OpenAI::Internal::Type::BaseModel
        # The output item that was marked done.
        attr_accessor item: OpenAI::Models::Responses::response_output_item

        # The index of the output item that was marked done.
        attr_accessor output_index: Integer

        # The sequence number of this event.
        attr_accessor sequence_number: Integer

        # The type of the event. Always `response.output_item.done`.
        attr_accessor type: :"response.output_item.done"

        # @param item
        #   The output item that was marked done.
        # @param output_index
        #   The index of the output item that was marked done.
        # @param sequence_number
        #   The sequence number of this event.
        # @param type
        #   The type of the event. Always `response.output_item.done`.
        def initialize: (
          item: OpenAI::Models::Responses::response_output_item,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_item.done"
        ) -> void

        def to_hash: -> {
          item: OpenAI::Models::Responses::response_output_item,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_item.done"
        }
      end
    end
  end
end
