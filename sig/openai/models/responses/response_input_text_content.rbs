module OpenAI
  module Models
    module Responses
      type response_input_text_content =
        {
          text: String,
          ?type: :input_text,
          ?prompt_cache_breakpoint: OpenAI::Responses::ResponseInputTextContent::PromptCacheBreakpoint?
        }

      class ResponseInputTextContent < OpenAI::Internal::Type::BaseModel
        # The text input to the model.
        attr_accessor text: String

        # The type of the input item. Always `input_text`.
        attr_accessor type: :input_text

        # Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        # from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        # token block.
        attr_accessor prompt_cache_breakpoint: OpenAI::Responses::ResponseInputTextContent::PromptCacheBreakpoint?

        # @param text
        #   The text input to the model.
        # @param prompt_cache_breakpoint
        #   Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        #   from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        #   token block.
        # @param type
        #   The type of the input item. Always `input_text`.
        def initialize: (
          text: String,
          ?prompt_cache_breakpoint: OpenAI::Responses::ResponseInputTextContent::PromptCacheBreakpoint?,
          ?type: :input_text
        ) -> void

        def to_hash: -> {
          text: String,
          ?type: :input_text,
          ?prompt_cache_breakpoint: OpenAI::Responses::ResponseInputTextContent::PromptCacheBreakpoint?
        }

        type prompt_cache_breakpoint =
          {
            ?mode: :explicit,
            ?ttl: OpenAI::Models::Responses::ResponseInputTextContent::PromptCacheBreakpoint::ttl
          }

        class PromptCacheBreakpoint < OpenAI::Internal::Type::BaseModel
          # The breakpoint mode. Always `explicit`.
          attr_accessor mode: :explicit

          # The minimum lifetime of this cache breakpoint. Defaults to the request TTL.
          attr_reader ttl: OpenAI::Models::Responses::ResponseInputTextContent::PromptCacheBreakpoint::ttl?

          # The minimum lifetime of this cache breakpoint. Defaults to the request TTL.
          def ttl=: (
            OpenAI::Models::Responses::ResponseInputTextContent::PromptCacheBreakpoint::ttl
          ) -> OpenAI::Models::Responses::ResponseInputTextContent::PromptCacheBreakpoint::ttl

          # @param ttl
          #   The minimum lifetime of this cache breakpoint. Defaults to the request TTL.
          # @param mode
          #   The breakpoint mode. Always `explicit`.
          def initialize: (
            ?ttl: OpenAI::Models::Responses::ResponseInputTextContent::PromptCacheBreakpoint::ttl,
            ?mode: :explicit
          ) -> void

          def to_hash: -> {
            ?mode: :explicit,
            ?ttl: OpenAI::Models::Responses::ResponseInputTextContent::PromptCacheBreakpoint::ttl
          }

          type ttl = :"30m" | :"12h"

          module Ttl
            extend OpenAI::Internal::Type::Enum

            TTL_30M: :"30m"
            TTL_12H: :"12h"

            def self?.values: -> ::Array[OpenAI::Models::Responses::ResponseInputTextContent::PromptCacheBreakpoint::ttl]
          end
        end
      end
    end
  end
end
