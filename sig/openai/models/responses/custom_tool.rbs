module OpenAI
  module Models
    module Responses
      type custom_tool =
        {
          name: String,
          ?type: :custom,
          ?allowed_callers: ::Array[OpenAI::Models::Responses::CustomTool::allowed_caller]?,
          ?async: bool,
          ?defer_loading: bool,
          ?description: String,
          ?format_: OpenAI::Models::custom_tool_input_format
        }

      class CustomTool < OpenAI::Internal::Type::BaseModel
        # The name of the custom tool, used to identify it in tool calls.
        attr_accessor name: String

        # The type of the custom tool. Always `custom`.
        attr_accessor type: :custom

        # The tool invocation context(s).
        attr_accessor allowed_callers: ::Array[OpenAI::Models::Responses::CustomTool::allowed_caller]?

        # Whether the tool response can be returned asynchronously versus immediately
        # returned on next response creation.
        attr_reader async: bool?

        # Whether the tool response can be returned asynchronously versus immediately
        # returned on next response creation.
        def async=: (bool) -> bool

        # Whether this tool should be deferred and discovered via tool search.
        attr_reader defer_loading: bool?

        # Whether this tool should be deferred and discovered via tool search.
        def defer_loading=: (bool) -> bool

        # Optional description of the custom tool, used to provide more context.
        attr_reader description: String?

        # Optional description of the custom tool, used to provide more context.
        def description=: (String) -> String

        # The input format for the custom tool. Default is unconstrained text.
        attr_reader format_: OpenAI::Models::custom_tool_input_format?

        # The input format for the custom tool. Default is unconstrained text.
        def format_=: (
          OpenAI::Models::custom_tool_input_format
        ) -> OpenAI::Models::custom_tool_input_format

        # @param name
        #   The name of the custom tool, used to identify it in tool calls.
        # @param allowed_callers
        #   The tool invocation context(s).
        # @param async
        #   Whether the tool response can be returned asynchronously versus immediately
        #   returned on next response creation.
        # @param defer_loading
        #   Whether this tool should be deferred and discovered via tool search.
        # @param description
        #   Optional description of the custom tool, used to provide more context.
        # @param format_
        #   The input format for the custom tool. Default is unconstrained text.
        # @param type
        #   The type of the custom tool. Always `custom`.
        def initialize: (
          name: String,
          ?allowed_callers: ::Array[OpenAI::Models::Responses::CustomTool::allowed_caller]?,
          ?async: bool,
          ?defer_loading: bool,
          ?description: String,
          ?format_: OpenAI::Models::custom_tool_input_format,
          ?type: :custom
        ) -> void

        def to_hash: -> {
          name: String,
          ?type: :custom,
          ?allowed_callers: ::Array[OpenAI::Models::Responses::CustomTool::allowed_caller]?,
          ?async: bool,
          ?defer_loading: bool,
          ?description: String,
          ?format_: OpenAI::Models::custom_tool_input_format
        }

        type allowed_caller = :direct | :programmatic

        module AllowedCaller
          extend OpenAI::Internal::Type::Enum

          DIRECT: :direct
          PROGRAMMATIC: :programmatic

          def self?.values: -> ::Array[OpenAI::Models::Responses::CustomTool::allowed_caller]
        end
      end
    end
  end
end
