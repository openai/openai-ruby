module OpenAI
  module Models
    module Responses
      type response_refusal_done_event =
        {
          content_index: Integer,
          item_id: String,
          output_index: Integer,
          refusal: String,
          sequence_number: Integer,
          ?type: :"response.refusal.done"
        }

      class ResponseRefusalDoneEvent < OpenAI::Internal::Type::BaseModel
        # The index of the content part that the refusal text is finalized.
        attr_accessor content_index: Integer

        # The ID of the output item that the refusal text is finalized.
        attr_accessor item_id: String

        # The index of the output item that the refusal text is finalized.
        attr_accessor output_index: Integer

        # The refusal text that is finalized.
        attr_accessor refusal: String

        # The sequence number of this event.
        attr_accessor sequence_number: Integer

        # The type of the event. Always `response.refusal.done`.
        attr_accessor type: :"response.refusal.done"

        # @param content_index
        #   The index of the content part that the refusal text is finalized.
        # @param item_id
        #   The ID of the output item that the refusal text is finalized.
        # @param output_index
        #   The index of the output item that the refusal text is finalized.
        # @param refusal
        #   The refusal text that is finalized.
        # @param sequence_number
        #   The sequence number of this event.
        # @param type
        #   The type of the event. Always `response.refusal.done`.
        def initialize: (
          content_index: Integer,
          item_id: String,
          output_index: Integer,
          refusal: String,
          sequence_number: Integer,
          ?type: :"response.refusal.done"
        ) -> void

        def to_hash: -> {
          content_index: Integer,
          item_id: String,
          output_index: Integer,
          refusal: String,
          sequence_number: Integer,
          ?type: :"response.refusal.done"
        }
      end
    end
  end
end
