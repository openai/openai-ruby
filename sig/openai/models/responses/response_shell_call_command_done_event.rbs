module OpenAI
  module Models
    module Responses
      type response_shell_call_command_done_event =
        {
          command: String,
          command_index: Integer,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.shell_call_command.done"
        }

      class ResponseShellCallCommandDoneEvent < OpenAI::Internal::Type::BaseModel
        # The final shell command that was emitted.
        attr_accessor command: String

        # The index of the shell command that was completed.
        attr_accessor command_index: Integer

        # The index of the output item that was updated.
        attr_accessor output_index: Integer

        # The sequence number of the event that was emitted.
        attr_accessor sequence_number: Integer

        # The type of the event, always `response.shell_call_command.done`.
        attr_accessor type: :"response.shell_call_command.done"

        # @param command
        #   The final shell command that was emitted.
        # @param command_index
        #   The index of the shell command that was completed.
        # @param output_index
        #   The index of the output item that was updated.
        # @param sequence_number
        #   The sequence number of the event that was emitted.
        # @param type
        #   The type of the event, always `response.shell_call_command.done`.
        def initialize: (
          command: String,
          command_index: Integer,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.shell_call_command.done"
        ) -> void

        def to_hash: -> {
          command: String,
          command_index: Integer,
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.shell_call_command.done"
        }
      end
    end
  end
end
