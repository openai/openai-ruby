          role: OpenAI::Models::Responses::EasyInputMessage::role,
          ?phase: OpenAI::Models::Responses::EasyInputMessage::phase?,
          ?type: OpenAI::Models::Responses::EasyInputMessage::type_
        ) -> void

        def to_hash: -> {
