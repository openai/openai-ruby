        attr_accessor phase: OpenAI::Models::Responses::EasyInputMessage::phase?

        # The type of the message input. Always `message`.
        attr_reader type: OpenAI::Models::Responses::EasyInputMessage::type_?

        # The type of the message input. Always `message`.
