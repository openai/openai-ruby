module OpenAI
  module Models
    module Responses
      type response_create_params =
        {
          ?background: bool?,
          ?context_management: ::Array[OpenAI::Responses::ResponseCreateParams::ContextManagement]?,
          ?conversation: OpenAI::Models::Responses::ResponseCreateParams::conversation?,
