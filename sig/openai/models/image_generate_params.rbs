module OpenAI
  module Models
    type image_generate_params =
      {
        prompt: String,
        ?background: OpenAI::Models::ImageGenerateParams::background?,
        ?complexity: OpenAI::Models::ImageGenerateParams::complexity?,
        ?frame_count: Integer?,
        ?frame_duration_ms: Integer?,
        ?model: OpenAI::Models::ImageGenerateParams::model?,
        ?moderation: OpenAI::Models::ImageGenerateParams::moderation?,
        ?n: Integer?,
        ?output_compression: Integer?,
        ?output_format: OpenAI::Models::ImageGenerateParams::output_format?,
        ?partial_images: Integer?,
        ?quality: OpenAI::Models::ImageGenerateParams::quality?,
        ?response_format: OpenAI::Models::ImageGenerateParams::response_format?,
        ?safety_identifier: String?,
        ?size: OpenAI::Models::ImageGenerateParams::size?,
        ?style: OpenAI::Models::ImageGenerateParams::style?,
        ?svg: OpenAI::ImageGenerateParams::Svg?,
        ?user: String,
        ?request_options: OpenAI::request_opts
      }

    class ImageGenerateParams < OpenAI::Internal::Type::BaseModel
      extend OpenAI::Internal::Type::RequestParameters::Converter
      include OpenAI::Internal::Type::RequestParameters

      # A text description of the desired image(s). The maximum length is 32000
      # characters.
      attr_accessor prompt: String

      # Allows to set transparency for the background of the generated image(s). Must be
      # one of `transparent`, `opaque`, or `auto` (default value). When `auto` is used,
      # the model will automatically determine the best background for the image.
      #
      # `gpt-image-2.5-sunburst` and `gpt-image-2.5-flare`, including their `2026-09-08`
      # snapshots, support `opaque` and `transparent` backgrounds. Transparent
      # backgrounds are available for supported GPT Image models. For `gpt-image-2` and
      # `gpt-image-2-2026-04-21`, this support is in preview. When using `transparent`,
      # set the output format to `png` or `webp`.
      attr_accessor background: OpenAI::Models::ImageGenerateParams::background?

      # Computation spent planning the image, independently of rendering quality. Uses
      # the image model's configured default when omitted. For SVG output, controls the
      # reference image, independently of the SVG author's reasoning.
      attr_accessor complexity: OpenAI::Models::ImageGenerateParams::complexity?

      # Number of frames for GIF output. Accepts integers from 2 through 16. Defaults to
      # 9 when omitted. Only supported with output_format=gif. The requested size must
      # satisfy the selected model's GIF size limits. GIF output does not support
      # streaming, partial images, masks, or custom output compression. Requires access
      # to the GIF preview for the selected model.
      attr_accessor frame_count: Integer?

      # Requested delay per GIF frame, in milliseconds. Defaults to 200 when omitted.
      # GIF output rounds to the nearest 10 ms and caps the encoded delay at 655,350 ms
      # per frame. Only supported with output_format=gif.
      attr_accessor frame_duration_ms: Integer?

      # The GPT image model to use for image generation. Specify a model explicitly.
      # Supported models include `gpt-image-1-mini`, `gpt-image-1.5`, `gpt-image-2`,
      # `gpt-image-2-2026-04-21`, `gpt-image-2.5-sunburst`,
      # `gpt-image-2.5-sunburst-2026-09-08`, `gpt-image-2.5-flare`,
      # `gpt-image-2.5-flare-2026-09-08`, `gpt-image-2.6-sunburst`,
      # `gpt-image-2.6-flare`, and `chatgpt-image-latest`.
      #
      # `gpt-image-1` was shut down on October 23, 2026. Use `gpt-image-2.5-sunburst` or
      # `gpt-image-2.5-flare` instead.
      attr_accessor model: OpenAI::Models::ImageGenerateParams::model?

      # Control the content-moderation level for images generated by the GPT image
      # models. Must be either `low` for less restrictive filtering or `auto` (default
      # value).
      attr_accessor moderation: OpenAI::Models::ImageGenerateParams::moderation?

      # The number of images to generate. Must be between 1 and 10.
      attr_accessor n: Integer?

      # The compression level (0-100%) for the generated images. This parameter is only
      # supported for the GPT image models with the `webp` or `jpeg` output formats, and
      # defaults to 100.
      attr_accessor output_compression: Integer?

      # The format in which the generated images are returned. This parameter is only
      # supported for the GPT image models.
      attr_accessor output_format: OpenAI::Models::ImageGenerateParams::output_format?

      # The number of partial images to generate. This parameter is used for streaming
      # responses that return partial images. Value must be between 0 and 3. When set to
      # 0, the response will be a single image sent in one streaming event.
      #
      # Note that the final image may be sent before the full number of partial images
      # are generated if the full image is generated more quickly.
      attr_accessor partial_images: Integer?

      # The quality of the image that will be generated.
      #
      # - `auto` (default value) will automatically select the best quality for the
      #   given model.
      # - `high`, `medium` and `low` are supported for the GPT image models.
      # - `gpt-image-2.5-sunburst` and `gpt-image-2.5-flare`, including their
      #   `2026-09-08` snapshots, also support `xhigh` and `max`.
      attr_accessor quality: OpenAI::Models::ImageGenerateParams::quality?

      # Legacy response format parameter for retired image models. Unsupported for GPT
      # image models, which always return base64-encoded images.
      attr_accessor response_format: OpenAI::Models::ImageGenerateParams::response_format?

      # A stable identifier for an end user in your organization, used for safety
      # monitoring and abuse detection. Hash a username or email address to avoid
      # sending identifying information. A non-empty value takes precedence over the
      # deprecated `user` parameter. If omitted, null, or empty, the API uses `user`
      # when available.
      # [Learn more](https://developers.openai.com/api/docs/guides/safety-best-practices#implement-safety-identifiers).
      attr_accessor safety_identifier: String?

      # The size of the generated images. For `gpt-image-2`, `gpt-image-2-2026-04-21`,
      # `gpt-image-2.5-sunburst`, `gpt-image-2.5-sunburst-2026-09-08`,
      # `gpt-image-2.5-flare`, and `gpt-image-2.5-flare-2026-09-08`, arbitrary
      # resolutions are supported as `WIDTHxHEIGHT` strings, for example `1536x864`.
      # Width and height must both be divisible by 16 and the requested aspect ratio
      # must be between 1:3 and 3:1. Resolutions above `2560x1440` are experimental, and
      # the maximum supported resolution is `3840x2160`. The requested size must also
      # satisfy the model's current pixel and edge limits. The standard sizes
      # `1024x1024`, `1536x1024`, and `1024x1536` are supported by the GPT image models;
      # `auto` is supported for models that allow automatic sizing.
      attr_accessor size: OpenAI::Models::ImageGenerateParams::size?

      # Legacy style parameter for retired image models. Unsupported for GPT image
      # models; describe the desired style in the prompt instead.
      attr_accessor style: OpenAI::Models::ImageGenerateParams::style?

      # Selects the model and reasoning effort used to author SVG output. Requires
      # output_format=svg and access to SVG model selection. When model selection is
      # enabled, supply svg.model. When model selection is disabled, omit this object.
      # The top-level model selects the image model that creates the reference image.
      # SVG generation requires n=1 and does not support streaming, partial images,
      # prompt_rewriter, or output_compression. SVG edits are not supported.
      attr_accessor svg: OpenAI::ImageGenerateParams::Svg?

      # Deprecated: use `safety_identifier` instead. This parameter remains accepted for
      # backward compatibility and is used when `safety_identifier` is omitted, null, or
      # empty.
      # [Learn more](https://developers.openai.com/api/docs/guides/safety-best-practices#implement-safety-identifiers).
      attr_reader user: String?

      # Deprecated: use `safety_identifier` instead. This parameter remains accepted for
      # backward compatibility and is used when `safety_identifier` is omitted, null, or
      # empty.
      # [Learn more](https://developers.openai.com/api/docs/guides/safety-best-practices#implement-safety-identifiers).
      def user=: (String) -> String

      # @param prompt
      #   A text description of the desired image(s). The maximum length is 32000
      #   characters.
      # @param background
      #   Allows to set transparency for the background of the generated image(s). Must be
      #   one of `transparent`, `opaque`, or `auto` (default value). When `auto` is used,
      #   the model will automatically determine the best background for the image.
      #
      #   `gpt-image-2.5-sunburst` and `gpt-image-2.5-flare`, including their `2026-09-08`
      #   snapshots, support `opaque` and `transparent` backgrounds. Transparent
      #   backgrounds are available for supported GPT Image models. For `gpt-image-2` and
      #   `gpt-image-2-2026-04-21`, this support is in preview. When using `transparent`,
      #   set the output format to `png` or `webp`.
      # @param complexity
      #   Computation spent planning the image, independently of rendering quality. Uses
      #   the image model's configured default when omitted. For SVG output, controls the
      #   reference image, independently of the SVG author's reasoning.
      # @param frame_count
      #   Number of frames for GIF output. Accepts integers from 2 through 16. Defaults to
      #   9 when omitted. Only supported with output_format=gif. The requested size must
      #   satisfy the selected model's GIF size limits. GIF output does not support
      #   streaming, partial images, masks, or custom output compression. Requires access
      #   to the GIF preview for the selected model.
      # @param frame_duration_ms
      #   Requested delay per GIF frame, in milliseconds. Defaults to 200 when omitted.
      #   GIF output rounds to the nearest 10 ms and caps the encoded delay at 655,350 ms
      #   per frame. Only supported with output_format=gif.
      # @param model
      #   The GPT image model to use for image generation. Specify a model explicitly.
      #   Supported models include `gpt-image-1-mini`, `gpt-image-1.5`, `gpt-image-2`,
      #   `gpt-image-2-2026-04-21`, `gpt-image-2.5-sunburst`,
      #   `gpt-image-2.5-sunburst-2026-09-08`, `gpt-image-2.5-flare`,
      #   `gpt-image-2.5-flare-2026-09-08`, `gpt-image-2.6-sunburst`,
      #   `gpt-image-2.6-flare`, and `chatgpt-image-latest`.
      #
      #   `gpt-image-1` was shut down on October 23, 2026. Use `gpt-image-2.5-sunburst` or
      #   `gpt-image-2.5-flare` instead.
      # @param moderation
      #   Control the content-moderation level for images generated by the GPT image
      #   models. Must be either `low` for less restrictive filtering or `auto` (default
      #   value).
      # @param n
      #   The number of images to generate. Must be between 1 and 10.
      # @param output_compression
      #   The compression level (0-100%) for the generated images. This parameter is only
      #   supported for the GPT image models with the `webp` or `jpeg` output formats, and
      #   defaults to 100.
      # @param output_format
      #   The format in which the generated images are returned. This parameter is only
      #   supported for the GPT image models.
      # @param partial_images
      #   The number of partial images to generate. This parameter is used for streaming
      #   responses that return partial images. Value must be between 0 and 3. When set to
      #   0, the response will be a single image sent in one streaming event.
      #
      #   Note that the final image may be sent before the full number of partial images
      #   are generated if the full image is generated more quickly.
      # @param quality
      #   The quality of the image that will be generated.
      #
      #   - `auto` (default value) will automatically select the best quality for the
      #     given model.
      #   - `high`, `medium` and `low` are supported for the GPT image models.
      #   - `gpt-image-2.5-sunburst` and `gpt-image-2.5-flare`, including their
      #     `2026-09-08` snapshots, also support `xhigh` and `max`.
      # @param response_format
      #   Legacy response format parameter for retired image models. Unsupported for GPT
      #   image models, which always return base64-encoded images.
      # @param safety_identifier
      #   A stable identifier for an end user in your organization, used for safety
      #   monitoring and abuse detection. Hash a username or email address to avoid
      #   sending identifying information. A non-empty value takes precedence over the
      #   deprecated `user` parameter. If omitted, null, or empty, the API uses `user`
      #   when available.
      #   [Learn more](https://developers.openai.com/api/docs/guides/safety-best-practices#implement-safety-identifiers).
      # @param size
      #   The size of the generated images. For `gpt-image-2`, `gpt-image-2-2026-04-21`,
      #   `gpt-image-2.5-sunburst`, `gpt-image-2.5-sunburst-2026-09-08`,
      #   `gpt-image-2.5-flare`, and `gpt-image-2.5-flare-2026-09-08`, arbitrary
      #   resolutions are supported as `WIDTHxHEIGHT` strings, for example `1536x864`.
      #   Width and height must both be divisible by 16 and the requested aspect ratio
      #   must be between 1:3 and 3:1. Resolutions above `2560x1440` are experimental, and
      #   the maximum supported resolution is `3840x2160`. The requested size must also
      #   satisfy the model's current pixel and edge limits. The standard sizes
      #   `1024x1024`, `1536x1024`, and `1024x1536` are supported by the GPT image models;
      #   `auto` is supported for models that allow automatic sizing.
      # @param style
      #   Legacy style parameter for retired image models. Unsupported for GPT image
      #   models; describe the desired style in the prompt instead.
      # @param svg
      #   Selects the model and reasoning effort used to author SVG output. Requires
      #   output_format=svg and access to SVG model selection. When model selection is
      #   enabled, supply svg.model. When model selection is disabled, omit this object.
      #   The top-level model selects the image model that creates the reference image.
      #   SVG generation requires n=1 and does not support streaming, partial images,
      #   prompt_rewriter, or output_compression. SVG edits are not supported.
      # @param user
      #   Deprecated: use `safety_identifier` instead. This parameter remains accepted for
      #   backward compatibility and is used when `safety_identifier` is omitted, null, or
      #   empty.
      #   [Learn more](https://developers.openai.com/api/docs/guides/safety-best-practices#implement-safety-identifiers).
      def initialize: (
        prompt: String,
        ?background: OpenAI::Models::ImageGenerateParams::background?,
        ?complexity: OpenAI::Models::ImageGenerateParams::complexity?,
        ?frame_count: Integer?,
        ?frame_duration_ms: Integer?,
        ?model: OpenAI::Models::ImageGenerateParams::model?,
        ?moderation: OpenAI::Models::ImageGenerateParams::moderation?,
        ?n: Integer?,
        ?output_compression: Integer?,
        ?output_format: OpenAI::Models::ImageGenerateParams::output_format?,
        ?partial_images: Integer?,
        ?quality: OpenAI::Models::ImageGenerateParams::quality?,
        ?response_format: OpenAI::Models::ImageGenerateParams::response_format?,
        ?safety_identifier: String?,
        ?size: OpenAI::Models::ImageGenerateParams::size?,
        ?style: OpenAI::Models::ImageGenerateParams::style?,
        ?svg: OpenAI::ImageGenerateParams::Svg?,
        ?user: String,
        ?request_options: OpenAI::request_opts
      ) -> void

      def to_hash: -> {
        prompt: String,
        ?background: OpenAI::Models::ImageGenerateParams::background?,
        ?complexity: OpenAI::Models::ImageGenerateParams::complexity?,
        ?frame_count: Integer?,
        ?frame_duration_ms: Integer?,
        ?model: OpenAI::Models::ImageGenerateParams::model?,
        ?moderation: OpenAI::Models::ImageGenerateParams::moderation?,
        ?n: Integer?,
        ?output_compression: Integer?,
        ?output_format: OpenAI::Models::ImageGenerateParams::output_format?,
        ?partial_images: Integer?,
        ?quality: OpenAI::Models::ImageGenerateParams::quality?,
        ?response_format: OpenAI::Models::ImageGenerateParams::response_format?,
        ?safety_identifier: String?,
        ?size: OpenAI::Models::ImageGenerateParams::size?,
        ?style: OpenAI::Models::ImageGenerateParams::style?,
        ?svg: OpenAI::ImageGenerateParams::Svg?,
        ?user: String,
        ?request_options: OpenAI::RequestOptions
      }

      type background = :transparent | :opaque | :auto

      module Background
        extend OpenAI::Internal::Type::Enum

        TRANSPARENT: :transparent
        OPAQUE: :opaque
        AUTO: :auto

        def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::background]
      end

      type complexity = :low | :medium | :high

      module Complexity
        extend OpenAI::Internal::Type::Enum

        LOW: :low
        MEDIUM: :medium
        HIGH: :high

        def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::complexity]
      end

      type model = String | OpenAI::Models::image_model

      module Model
        extend OpenAI::Internal::Type::Union

        def self?.variants: -> ::Array[OpenAI::Models::ImageGenerateParams::model]
      end

      type moderation = :low | :auto

      module Moderation
        extend OpenAI::Internal::Type::Enum

        LOW: :low
        AUTO: :auto

        def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::moderation]
      end

      type output_format = :png | :jpeg | :webp | :gif | :svg

      module OutputFormat
        extend OpenAI::Internal::Type::Enum

        PNG: :png
        JPEG: :jpeg
        WEBP: :webp
        GIF: :gif
        SVG: :svg

        def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::output_format]
      end

      type quality =
        :low | :medium | :high | :xhigh | :max | :auto | :standard | :hd

      module Quality
        extend OpenAI::Internal::Type::Enum

        LOW: :low
        MEDIUM: :medium
        HIGH: :high
        XHIGH: :xhigh
        MAX: :max
        AUTO: :auto
        STANDARD: :standard
        HD: :hd

        def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::quality]
      end

      type response_format = :url | :b64_json

      module ResponseFormat
        extend OpenAI::Internal::Type::Enum

        URL: :url
        B64_JSON: :b64_json

        def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::response_format]
      end

      type size =
        String
        | :auto
        | :"1024x1024"
        | :"1536x1024"
        | :"1024x1536"
        | :"256x256"
        | :"512x512"
        | :"1792x1024"
        | :"1024x1792"

      module Size
        extend OpenAI::Internal::Type::Union

        def self?.variants: -> ::Array[OpenAI::Models::ImageGenerateParams::size]

        AUTO: :auto
        SIZE_1024X1024: :"1024x1024"
        SIZE_1536X1024: :"1536x1024"
        SIZE_1024X1536: :"1024x1536"
        SIZE_256X256: :"256x256"
        SIZE_512X512: :"512x512"
        SIZE_1792X1024: :"1792x1024"
        SIZE_1024X1792: :"1024x1792"
      end

      type style = :vivid | :natural

      module Style
        extend OpenAI::Internal::Type::Enum

        VIVID: :vivid
        NATURAL: :natural

        def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::style]
      end

      type svg =
        {
          model: String,
          ?reasoning: OpenAI::ImageGenerateParams::Svg::Reasoning?
        }

      class Svg < OpenAI::Internal::Type::BaseModel
        # Model used to author the SVG. Required when SVG model selection is enabled.
        attr_accessor model: String

        # Reasoning settings for the SVG author, independent of image complexity. Omitted
        # or null effort uses the author model's default. Supported efforts depend on the
        # selected author model.
        attr_accessor reasoning: OpenAI::ImageGenerateParams::Svg::Reasoning?

        # @param model
        #   Model used to author the SVG. Required when SVG model selection is enabled.
        # @param reasoning
        #   Reasoning settings for the SVG author, independent of image complexity. Omitted
        #   or null effort uses the author model's default. Supported efforts depend on the
        #   selected author model.
        def initialize: (
          model: String,
          ?reasoning: OpenAI::ImageGenerateParams::Svg::Reasoning?
        ) -> void

        def to_hash: -> {
          model: String,
          ?reasoning: OpenAI::ImageGenerateParams::Svg::Reasoning?
        }

        type reasoning =
          {
            ?effort: OpenAI::Models::ImageGenerateParams::Svg::Reasoning::effort?
          }

        class Reasoning < OpenAI::Internal::Type::BaseModel
          # Controls how much effort the SVG author spends on reasoning. Uses the author
          # model's default when omitted or null.
          attr_accessor effort: OpenAI::Models::ImageGenerateParams::Svg::Reasoning::effort?

          # @param effort
          #   Controls how much effort the SVG author spends on reasoning. Uses the author
          #   model's default when omitted or null.
          def initialize: (
            ?effort: OpenAI::Models::ImageGenerateParams::Svg::Reasoning::effort?
          ) -> void

          def to_hash: -> {
            ?effort: OpenAI::Models::ImageGenerateParams::Svg::Reasoning::effort?
          }

          type effort =
            :none | :minimal | :low | :medium | :high | :xhigh | :max

          module Effort
            extend OpenAI::Internal::Type::Enum

            NONE: :none
            MINIMAL: :minimal
            LOW: :low
            MEDIUM: :medium
            HIGH: :high
            XHIGH: :xhigh
            MAX: :max

            def self?.values: -> ::Array[OpenAI::Models::ImageGenerateParams::Svg::Reasoning::effort]
          end
        end
      end
    end
  end
end
