module OpenAI
  module Models
    module Realtime
      type input_audio_buffer_speech_started_event =
        {
          audio_start_ms: Integer,
          event_id: String,
          item_id: String,
          ?type: :"input_audio_buffer.speech_started"
        }

      class InputAudioBufferSpeechStartedEvent < OpenAI::Internal::Type::BaseModel
        # Milliseconds from the start of all audio written to the buffer during the
        # session when speech was first detected. This will correspond to the beginning of
        # audio sent to the model, and thus includes the `prefix_padding_ms` configured in
        # the Session.
        attr_accessor audio_start_ms: Integer

        # The unique ID of the server event.
        attr_accessor event_id: String

        # The ID of the user message item that will be created when speech stops.
        attr_accessor item_id: String

        # The event type, must be `input_audio_buffer.speech_started`.
        attr_accessor type: :"input_audio_buffer.speech_started"

        # @param audio_start_ms
        #   Milliseconds from the start of all audio written to the buffer during the
        #   session when speech was first detected. This will correspond to the beginning of
        #   audio sent to the model, and thus includes the `prefix_padding_ms` configured in
        #   the Session.
        # @param event_id
        #   The unique ID of the server event.
        # @param item_id
        #   The ID of the user message item that will be created when speech stops.
        # @param type
        #   The event type, must be `input_audio_buffer.speech_started`.
        def initialize: (
          audio_start_ms: Integer,
          event_id: String,
          item_id: String,
          ?type: :"input_audio_buffer.speech_started"
        ) -> void

        def to_hash: -> {
          audio_start_ms: Integer,
          event_id: String,
          item_id: String,
          ?type: :"input_audio_buffer.speech_started"
        }
      end
    end
  end
end
