module OpenAI
  module Models
    module Realtime
      type conversation_item_truncated_event =
        {
          audio_end_ms: Integer,
          content_index: Integer,
          event_id: String,
          item_id: String,
          ?type: :"conversation.item.truncated"
        }

      class ConversationItemTruncatedEvent < OpenAI::Internal::Type::BaseModel
        # The duration up to which the audio was truncated, in milliseconds.
        attr_accessor audio_end_ms: Integer

        # The index of the content part that was truncated.
        attr_accessor content_index: Integer

        # The unique ID of the server event.
        attr_accessor event_id: String

        # The ID of the assistant message item that was truncated.
        attr_accessor item_id: String

        # The event type, must be `conversation.item.truncated`.
        attr_accessor type: :"conversation.item.truncated"

        # @param audio_end_ms
        #   The duration up to which the audio was truncated, in milliseconds.
        # @param content_index
        #   The index of the content part that was truncated.
        # @param event_id
        #   The unique ID of the server event.
        # @param item_id
        #   The ID of the assistant message item that was truncated.
        # @param type
        #   The event type, must be `conversation.item.truncated`.
        def initialize: (
          audio_end_ms: Integer,
          content_index: Integer,
          event_id: String,
          item_id: String,
          ?type: :"conversation.item.truncated"
        ) -> void

        def to_hash: -> {
          audio_end_ms: Integer,
          content_index: Integer,
          event_id: String,
          item_id: String,
          ?type: :"conversation.item.truncated"
        }
      end
    end
  end
end
