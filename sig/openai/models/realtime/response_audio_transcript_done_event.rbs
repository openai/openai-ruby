module OpenAI
  module Models
    module Realtime
      type response_audio_transcript_done_event =
        {
          content_index: Integer,
          event_id: String,
          item_id: String,
          output_index: Integer,
          response_id: String,
          transcript: String,
          ?type: :"response.output_audio_transcript.done"
        }

      class ResponseAudioTranscriptDoneEvent < OpenAI::Internal::Type::BaseModel
        # The index of the content part in the item's content array.
        attr_accessor content_index: Integer

        # The unique ID of the server event.
        attr_accessor event_id: String

        # The ID of the item.
        attr_accessor item_id: String

        # The index of the output item in the response.
        attr_accessor output_index: Integer

        # The ID of the response.
        attr_accessor response_id: String

        # The final transcript of the audio.
        attr_accessor transcript: String

        # The event type, must be `response.output_audio_transcript.done`.
        attr_accessor type: :"response.output_audio_transcript.done"

        # @param content_index
        #   The index of the content part in the item's content array.
        # @param event_id
        #   The unique ID of the server event.
        # @param item_id
        #   The ID of the item.
        # @param output_index
        #   The index of the output item in the response.
        # @param response_id
        #   The ID of the response.
        # @param transcript
        #   The final transcript of the audio.
        # @param type
        #   The event type, must be `response.output_audio_transcript.done`.
        def initialize: (
          content_index: Integer,
          event_id: String,
          item_id: String,
          output_index: Integer,
          response_id: String,
          transcript: String,
          ?type: :"response.output_audio_transcript.done"
        ) -> void

        def to_hash: -> {
          content_index: Integer,
          event_id: String,
          item_id: String,
          output_index: Integer,
          response_id: String,
          transcript: String,
          ?type: :"response.output_audio_transcript.done"
        }
      end
    end
  end
end
