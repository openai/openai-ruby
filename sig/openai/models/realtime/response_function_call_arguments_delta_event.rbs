module OpenAI
  module Models
    module Realtime
      type response_function_call_arguments_delta_event =
        {
          call_id: String,
          delta: String,
          event_id: String,
          item_id: String,
          output_index: Integer,
          response_id: String,
          ?type: :"response.function_call_arguments.delta"
