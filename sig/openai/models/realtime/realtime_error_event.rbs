module OpenAI
  module Models
    module Realtime
      type realtime_error_event =
        {
          error: OpenAI::Realtime::RealtimeError,
          event_id: String,
          ?type: :error
        }

      class RealtimeErrorEvent < OpenAI::Internal::Type::BaseModel
        # Details of the error.
        attr_accessor error: OpenAI::Realtime::RealtimeError

        # The unique ID of the server event.
        attr_accessor event_id: String

        # The event type, must be `error`.
        attr_accessor type: :error

        # @param error
        #   Details of the error.
        # @param event_id
        #   The unique ID of the server event.
        # @param type
        #   The event type, must be `error`.
        def initialize: (
          error: OpenAI::Realtime::RealtimeError,
          event_id: String,
          ?type: :error
        ) -> void

        def to_hash: -> {
          error: OpenAI::Realtime::RealtimeError,
          event_id: String,
          ?type: :error
        }
      end
    end
  end
end
