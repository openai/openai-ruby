module OpenAI
  module Models
    module Realtime
      type conversation_item_done =
        {
          event_id: String,
          item: OpenAI::Models::Realtime::conversation_item,
          ?type: :"conversation.item.done",
          ?previous_item_id: String?
        }

      class ConversationItemDone < OpenAI::Internal::Type::BaseModel
        # The unique ID of the server event.
        attr_accessor event_id: String

        # A single item within a Realtime conversation.
        attr_accessor item: OpenAI::Models::Realtime::conversation_item

        # The event type, must be `conversation.item.done`.
        attr_accessor type: :"conversation.item.done"

        # The ID of the item that precedes this one, if any. This is used to maintain
        # ordering when items are inserted.
        attr_accessor previous_item_id: String?

        # @param event_id
        #   The unique ID of the server event.
        # @param item
        #   A single item within a Realtime conversation.
        # @param previous_item_id
        #   The ID of the item that precedes this one, if any. This is used to maintain
        #   ordering when items are inserted.
        # @param type
        #   The event type, must be `conversation.item.done`.
        def initialize: (
          event_id: String,
          item: OpenAI::Models::Realtime::conversation_item,
          ?previous_item_id: String?,
          ?type: :"conversation.item.done"
        ) -> void

        def to_hash: -> {
          event_id: String,
          item: OpenAI::Models::Realtime::conversation_item,
          ?type: :"conversation.item.done",
          ?previous_item_id: String?
        }
      end
    end
  end
end
