        #   Optional client-generated ID used to identify this event.
        # @param type
        #   The event type, must be `conversation.item.delete`.
        def initialize: (
          item_id: String,
          ?event_id: String,
          ?type: :"conversation.item.delete"
        ) -> void

        def to_hash: -> {
          item_id: String,
          ?type: :"conversation.item.delete",
          ?event_id: String
        }
