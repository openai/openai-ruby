module OpenAI
  module Models
    module Realtime
      type response_cancel_event =
        { ?type: :"response.cancel", ?event_id: String, ?response_id: String }

      class ResponseCancelEvent < OpenAI::Internal::Type::BaseModel
        # The event type, must be `response.cancel`.
        attr_accessor type: :"response.cancel"

        # Optional client-generated ID used to identify this event.
        attr_reader event_id: String?

        # Optional client-generated ID used to identify this event.
        def event_id=: (String) -> String

        # A specific response ID to cancel - if not provided, will cancel an in-progress
        # response in the default conversation.
        attr_reader response_id: String?

        # A specific response ID to cancel - if not provided, will cancel an in-progress
        # response in the default conversation.
        def response_id=: (String) -> String

        # @param event_id
        #   Optional client-generated ID used to identify this event.
        # @param response_id
        #   A specific response ID to cancel - if not provided, will cancel an in-progress
        #   response in the default conversation.
        # @param type
        #   The event type, must be `response.cancel`.
        def initialize: (
          ?event_id: String,
          ?response_id: String,
          ?type: :"response.cancel"
        ) -> void

        def to_hash: -> {
          ?type: :"response.cancel",
          ?event_id: String,
          ?response_id: String
        }
      end
    end
  end
end
