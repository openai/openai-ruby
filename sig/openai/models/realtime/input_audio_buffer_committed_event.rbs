module OpenAI
  module Models
    module Realtime
      type input_audio_buffer_committed_event =
        {
          event_id: String,
          item_id: String,
          ?type: :"input_audio_buffer.committed",
          ?previous_item_id: String?
        }

      class InputAudioBufferCommittedEvent < OpenAI::Internal::Type::BaseModel
        # The unique ID of the server event.
        attr_accessor event_id: String

        # The ID of the user message item that will be created.
        attr_accessor item_id: String

        # The event type, must be `input_audio_buffer.committed`.
        attr_accessor type: :"input_audio_buffer.committed"

        # The ID of the preceding item after which the new item will be inserted. Can be
        # `null` if the item has no predecessor.
        attr_accessor previous_item_id: String?

        # @param event_id
        #   The unique ID of the server event.
        # @param item_id
        #   The ID of the user message item that will be created.
        # @param previous_item_id
        #   The ID of the preceding item after which the new item will be inserted. Can be
        #   `null` if the item has no predecessor.
        # @param type
        #   The event type, must be `input_audio_buffer.committed`.
        def initialize: (
          event_id: String,
          item_id: String,
          ?previous_item_id: String?,
          ?type: :"input_audio_buffer.committed"
        ) -> void

        def to_hash: -> {
          event_id: String,
          item_id: String,
          ?type: :"input_audio_buffer.committed",
          ?previous_item_id: String?
        }
      end
    end
  end
end
