module OpenAI
  module Models
    module Realtime
      type conversation_item_truncate_event =
        {
          audio_end_ms: Integer,
          content_index: Integer,
          item_id: String,
          ?type: :"conversation.item.truncate",
          ?event_id: String
        }

      class ConversationItemTruncateEvent < OpenAI::Internal::Type::BaseModel
        # Inclusive duration up to which audio is truncated, in milliseconds. If the
        # audio_end_ms is greater than the actual audio duration, the server will respond
        # with an error.
        attr_accessor audio_end_ms: Integer

        # The index of the content part to truncate. Set this to `0`.
        attr_accessor content_index: Integer

        # The ID of the assistant message item to truncate. Only assistant message items
        # can be truncated.
        attr_accessor item_id: String

        # The event type, must be `conversation.item.truncate`.
        attr_accessor type: :"conversation.item.truncate"

        # Optional client-generated ID used to identify this event.
        attr_reader event_id: String?

        # Optional client-generated ID used to identify this event.
        def event_id=: (String) -> String

        # @param audio_end_ms
        #   Inclusive duration up to which audio is truncated, in milliseconds. If the
        #   audio_end_ms is greater than the actual audio duration, the server will respond
        #   with an error.
        # @param content_index
        #   The index of the content part to truncate. Set this to `0`.
        # @param item_id
        #   The ID of the assistant message item to truncate. Only assistant message items
        #   can be truncated.
        # @param event_id
        #   Optional client-generated ID used to identify this event.
        # @param type
        #   The event type, must be `conversation.item.truncate`.
        def initialize: (
          audio_end_ms: Integer,
          content_index: Integer,
          item_id: String,
          ?event_id: String,
          ?type: :"conversation.item.truncate"
        ) -> void

        def to_hash: -> {
          audio_end_ms: Integer,
          content_index: Integer,
          item_id: String,
          ?type: :"conversation.item.truncate",
          ?event_id: String
        }
      end
    end
  end
end
