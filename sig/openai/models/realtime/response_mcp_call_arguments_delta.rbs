module OpenAI
  module Models
    module Realtime
      type response_mcp_call_arguments_delta =
        {
          delta: String,
          event_id: String,
          item_id: String,
          output_index: Integer,
          response_id: String,
          ?type: :"response.mcp_call_arguments.delta",
          ?obfuscation: String?
        }

      class ResponseMcpCallArgumentsDelta < OpenAI::Internal::Type::BaseModel
        # The JSON-encoded arguments delta.
        attr_accessor delta: String

        # The unique ID of the server event.
        attr_accessor event_id: String

        # The ID of the MCP tool call item.
        attr_accessor item_id: String

        # The index of the output item in the response.
        attr_accessor output_index: Integer

        # The ID of the response.
        attr_accessor response_id: String

        # The event type, must be `response.mcp_call_arguments.delta`.
        attr_accessor type: :"response.mcp_call_arguments.delta"

        # If present, indicates the delta text was obfuscated.
        attr_accessor obfuscation: String?

        # @param delta
        #   The JSON-encoded arguments delta.
        # @param event_id
        #   The unique ID of the server event.
        # @param item_id
        #   The ID of the MCP tool call item.
        # @param output_index
        #   The index of the output item in the response.
        # @param response_id
        #   The ID of the response.
        # @param obfuscation
        #   If present, indicates the delta text was obfuscated.
        # @param type
        #   The event type, must be `response.mcp_call_arguments.delta`.
        def initialize: (
          delta: String,
          event_id: String,
          item_id: String,
          output_index: Integer,
          response_id: String,
          ?obfuscation: String?,
          ?type: :"response.mcp_call_arguments.delta"
        ) -> void

        def to_hash: -> {
          delta: String,
          event_id: String,
          item_id: String,
          output_index: Integer,
          response_id: String,
          ?type: :"response.mcp_call_arguments.delta",
          ?obfuscation: String?
        }
      end
    end
  end
end
