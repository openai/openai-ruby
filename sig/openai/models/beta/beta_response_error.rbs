module OpenAI
  module Models
    class BetaResponseError = Beta::BetaResponseError

    module Beta
      type beta_response_error =
        {
          code: OpenAI::Models::Beta::BetaResponseError::code,
          message: String,
          ?misalignment: OpenAI::Beta::BetaResponseError::Misalignment
        }

      class BetaResponseError < OpenAI::Internal::Type::BaseModel
        attr_accessor code: OpenAI::Models::Beta::BetaResponseError::code

        attr_accessor message: String

        attr_reader misalignment: OpenAI::Beta::BetaResponseError::Misalignment?

        def misalignment=: (
          OpenAI::Beta::BetaResponseError::Misalignment
        ) -> OpenAI::Beta::BetaResponseError::Misalignment

        def initialize: (
          code: OpenAI::Models::Beta::BetaResponseError::code,
          message: String,
          ?misalignment: OpenAI::Beta::BetaResponseError::Misalignment
        ) -> void

        def to_hash: -> {
          code: OpenAI::Models::Beta::BetaResponseError::code,
          message: String,
          ?misalignment: OpenAI::Beta::BetaResponseError::Misalignment
        }

        type code =
          :server_error
          | :rate_limit_exceeded
          | :invalid_prompt
          | :data_residency_mismatch
          | :bio_policy
          | :misalignment_policy_violation
          | :vector_store_timeout
          | :invalid_image
          | :invalid_image_format
          | :invalid_base64_image
          | :invalid_image_url
          | :image_too_large
          | :image_too_small
          | :image_parse_error
          | :image_content_policy_violation
          | :invalid_image_mode
          | :image_file_too_large
          | :unsupported_image_media_type
          | :empty_image_file
          | :failed_to_download_image
          | :image_file_not_found

        module Code
          extend OpenAI::Internal::Type::Enum

          SERVER_ERROR: :server_error
          RATE_LIMIT_EXCEEDED: :rate_limit_exceeded
          INVALID_PROMPT: :invalid_prompt
          DATA_RESIDENCY_MISMATCH: :data_residency_mismatch
          BIO_POLICY: :bio_policy
          MISALIGNMENT_POLICY_VIOLATION: :misalignment_policy_violation
          VECTOR_STORE_TIMEOUT: :vector_store_timeout
          INVALID_IMAGE: :invalid_image
          INVALID_IMAGE_FORMAT: :invalid_image_format
          INVALID_BASE64_IMAGE: :invalid_base64_image
          INVALID_IMAGE_URL: :invalid_image_url
          IMAGE_TOO_LARGE: :image_too_large
          IMAGE_TOO_SMALL: :image_too_small
          IMAGE_PARSE_ERROR: :image_parse_error
          IMAGE_CONTENT_POLICY_VIOLATION: :image_content_policy_violation
          INVALID_IMAGE_MODE: :invalid_image_mode
          IMAGE_FILE_TOO_LARGE: :image_file_too_large
          UNSUPPORTED_IMAGE_MEDIA_TYPE: :unsupported_image_media_type
          EMPTY_IMAGE_FILE: :empty_image_file
          FAILED_TO_DOWNLOAD_IMAGE: :failed_to_download_image
          IMAGE_FILE_NOT_FOUND: :image_file_not_found

          def self?.values: -> ::Array[OpenAI::Models::Beta::BetaResponseError::code]
        end

        type misalignment =
          {
            ?detailed_explanation: String,
            ?error_type: OpenAI::Models::Beta::BetaResponseError::Misalignment::error_type,
            ?steer: OpenAI::Beta::BetaResponseError::Misalignment::Steer
          }

        class Misalignment < OpenAI::Internal::Type::BaseModel
          attr_reader detailed_explanation: String?

          def detailed_explanation=: (String) -> String

          attr_reader error_type: OpenAI::Models::Beta::BetaResponseError::Misalignment::error_type?

          def error_type=: (
            OpenAI::Models::Beta::BetaResponseError::Misalignment::error_type
          ) -> OpenAI::Models::Beta::BetaResponseError::Misalignment::error_type

          attr_reader steer: OpenAI::Beta::BetaResponseError::Misalignment::Steer?

          def steer=: (
            OpenAI::Beta::BetaResponseError::Misalignment::Steer
          ) -> OpenAI::Beta::BetaResponseError::Misalignment::Steer

          def initialize: (
            ?detailed_explanation: String,
            ?error_type: OpenAI::Models::Beta::BetaResponseError::Misalignment::error_type,
            ?steer: OpenAI::Beta::BetaResponseError::Misalignment::Steer
          ) -> void

          def to_hash: -> {
            ?detailed_explanation: String,
            ?error_type: OpenAI::Models::Beta::BetaResponseError::Misalignment::error_type,
            ?steer: OpenAI::Beta::BetaResponseError::Misalignment::Steer
          }

          type error_type =
            String
            | :potentially_unintended_data_transfer
            | :potentially_unintended_data_access
            | :potentially_unintended_destructive_activity
            | :other

          module ErrorType
            extend OpenAI::Internal::Type::Union

            def self?.variants: -> ::Array[OpenAI::Models::Beta::BetaResponseError::Misalignment::error_type]

            POTENTIALLY_UNINTENDED_DATA_TRANSFER: :potentially_unintended_data_transfer
            POTENTIALLY_UNINTENDED_DATA_ACCESS: :potentially_unintended_data_access
            POTENTIALLY_UNINTENDED_DESTRUCTIVE_ACTIVITY: :potentially_unintended_destructive_activity
            OTHER: :other
          end

          type steer = { message: String }

          class Steer < OpenAI::Internal::Type::BaseModel
            attr_accessor message: String

            def initialize: (message: String) -> void

            def to_hash: -> { message: String }
          end
        end
      end
    end
  end
end
