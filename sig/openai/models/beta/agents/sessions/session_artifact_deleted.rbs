module OpenAI
  module Models
    module Beta
      module Agents
        class SessionArtifactDeleted = Sessions::SessionArtifactDeleted

        module Sessions
          type session_artifact_deleted =
            {
              id: String,
              deleted: bool,
              ?object: :"agent.session.artifact.deleted"
            }

          class SessionArtifactDeleted < OpenAI::Internal::Type::BaseModel
            # The ID of the deleted session artifact.
            attr_accessor id: String

            # Whether the session artifact was deleted. Always `true`.
            attr_accessor deleted: bool

            # The object type. Always `agent.session.artifact.deleted`.
            attr_accessor object: :"agent.session.artifact.deleted"

            # @param id
            #   The ID of the deleted session artifact.
            # @param deleted
            #   Whether the session artifact was deleted. Always `true`.
            # @param object
            #   The object type. Always `agent.session.artifact.deleted`.
            def initialize: (
              id: String,
              deleted: bool,
              ?object: :"agent.session.artifact.deleted"
            ) -> void

            def to_hash: -> {
              id: String,
              deleted: bool,
              ?object: :"agent.session.artifact.deleted"
            }
          end
        end
      end
    end
  end
end
