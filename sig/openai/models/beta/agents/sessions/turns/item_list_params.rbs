module OpenAI
  module Models
    module Beta
      module Agents
        module Sessions
          module Turns
            type item_list_params =
              {
                session_id: String,
                turn_id: String,
                ?after: String,
                ?limit: Integer,
                ?order: OpenAI::Models::Beta::Agents::Sessions::Turns::ItemListParams::order,
                ?request_options: OpenAI::request_opts
              }

            class ItemListParams < OpenAI::Internal::Type::BaseModel
              extend OpenAI::Internal::Type::RequestParameters::Converter
              include OpenAI::Internal::Type::RequestParameters

              attr_accessor session_id: String

              attr_accessor turn_id: String

              # Return items after this cursor in the selected order. Pass the previous
              # response's last_id, which can differ from the last item's ID.
              attr_reader after: String?

              # Return items after this cursor in the selected order. Pass the previous
              # response's last_id, which can differ from the last item's ID.
              def after=: (String) -> String

              # The maximum number of resources to return, between 1 and 100. Defaults to 20.
              attr_reader limit: Integer?

              # The maximum number of resources to return, between 1 and 100. Defaults to 20.
              def limit=: (Integer) -> Integer

              # The order in which resources are returned. Defaults to `desc`.
              attr_reader order: OpenAI::Models::Beta::Agents::Sessions::Turns::ItemListParams::order?

              # The order in which resources are returned. Defaults to `desc`.
              def order=: (
                OpenAI::Models::Beta::Agents::Sessions::Turns::ItemListParams::order
              ) -> OpenAI::Models::Beta::Agents::Sessions::Turns::ItemListParams::order

              # @param after
              #   Return items after this cursor in the selected order. Pass the previous
              #   response's last_id, which can differ from the last item's ID.
              # @param limit
              #   The maximum number of resources to return, between 1 and 100. Defaults to 20.
              # @param order
              #   The order in which resources are returned. Defaults to `desc`.
              def initialize: (
                session_id: String,
                turn_id: String,
                ?after: String,
                ?limit: Integer,
                ?order: OpenAI::Models::Beta::Agents::Sessions::Turns::ItemListParams::order,
                ?request_options: OpenAI::request_opts
              ) -> void

              def to_hash: -> {
                session_id: String,
                turn_id: String,
                ?after: String,
                ?limit: Integer,
                ?order: OpenAI::Models::Beta::Agents::Sessions::Turns::ItemListParams::order,
                ?request_options: OpenAI::RequestOptions
              }

              type order = :asc | :desc

              module Order
                extend OpenAI::Internal::Type::Enum

                # Returns resources in ascending order.
                ASC: :asc

                # Returns resources in descending order.
                DESC: :desc

                def self?.values: -> ::Array[OpenAI::Models::Beta::Agents::Sessions::Turns::ItemListParams::order]
              end
            end
          end
        end
