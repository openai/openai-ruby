module OpenAI
  module Models
    module Beta
      module Agents
        module Environments
          type template_update_params =
            {
              environment_template_id: String,
              ?capability_directories: ::Array[String]?,
              ?desktop: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Desktop?,
              ?env: ::Hash[Symbol, String]?,
              ?files: ::Array[OpenAI::Models::Beta::hosted_environment_file_param]?,
              ?name: String?,
              ?network: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Network?,
              ?packages: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Packages?,
              ?plugins: ::Array[OpenAI::Beta::HostedPluginParam]?,
              ?setup_commands: ::Array[OpenAI::Beta::SetupCommandParam]?,
              ?skills: ::Array[OpenAI::Models::Beta::hosted_skill_param]?,
              ?request_options: OpenAI::request_opts
            }

          class TemplateUpdateParams < OpenAI::Internal::Type::BaseModel
            extend OpenAI::Internal::Type::RequestParameters::Converter
            include OpenAI::Internal::Type::RequestParameters

            attr_accessor environment_template_id: String

            # Directories that expose capabilities to the agent.
            attr_accessor capability_directories: ::Array[String]?

            # Replacement desktop configuration, or null to disable the desktop.
            attr_accessor desktop: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Desktop?

            # Replacement confidential environment values.
            attr_accessor env: ::Hash[Symbol, String]?

            # Replacement file configuration materialized for each new session.
            attr_accessor files: ::Array[OpenAI::Models::Beta::hosted_environment_file_param]?

            # A replacement human-readable display name, or `null` to clear the name.
            attr_accessor name: String?

            # Network access available after setup completes. Omit to preserve the current
            # policy, or pass `null` to reset to disabled for GA requests or enabled for beta
            # requests.
            attr_accessor network: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Network?

            # Packages installed before the runtime network policy applies.
            attr_accessor packages: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Packages?

            # Replacement plugin configuration installed for each new session.
            attr_accessor plugins: ::Array[OpenAI::Beta::HostedPluginParam]?

            # Replacement confidential setup commands, never included in returned resources.
            attr_accessor setup_commands: ::Array[OpenAI::Beta::SetupCommandParam]?

            # Replacement skill configuration installed for each new session.
            attr_accessor skills: ::Array[OpenAI::Models::Beta::hosted_skill_param]?

            # @param capability_directories
            #   Directories that expose capabilities to the agent.
            # @param desktop
            #   Replacement desktop configuration, or null to disable the desktop.
            # @param env
            #   Replacement confidential environment values.
            # @param files
            #   Replacement file configuration materialized for each new session.
            # @param name
            #   A replacement human-readable display name, or `null` to clear the name.
            # @param network
            #   Network access available after setup completes. Omit to preserve the current
            #   policy, or pass `null` to reset to disabled for GA requests or enabled for beta
            #   requests.
            # @param packages
            #   Packages installed before the runtime network policy applies.
            # @param plugins
            #   Replacement plugin configuration installed for each new session.
            # @param setup_commands
            #   Replacement confidential setup commands, never included in returned resources.
            # @param skills
            #   Replacement skill configuration installed for each new session.
            def initialize: (
              environment_template_id: String,
              ?capability_directories: ::Array[String]?,
              ?desktop: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Desktop?,
              ?env: ::Hash[Symbol, String]?,
              ?files: ::Array[OpenAI::Models::Beta::hosted_environment_file_param]?,
              ?name: String?,
              ?network: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Network?,
              ?packages: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Packages?,
              ?plugins: ::Array[OpenAI::Beta::HostedPluginParam]?,
              ?setup_commands: ::Array[OpenAI::Beta::SetupCommandParam]?,
              ?skills: ::Array[OpenAI::Models::Beta::hosted_skill_param]?,
              ?request_options: OpenAI::request_opts
            ) -> void

            def to_hash: -> {
              environment_template_id: String,
              ?capability_directories: ::Array[String]?,
              ?desktop: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Desktop?,
              ?env: ::Hash[Symbol, String]?,
              ?files: ::Array[OpenAI::Models::Beta::hosted_environment_file_param]?,
              ?name: String?,
              ?network: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Network?,
              ?packages: OpenAI::Beta::Agents::Environments::TemplateUpdateParams::Packages?,
              ?plugins: ::Array[OpenAI::Beta::HostedPluginParam]?,
              ?setup_commands: ::Array[OpenAI::Beta::SetupCommandParam]?,
              ?skills: ::Array[OpenAI::Models::Beta::hosted_skill_param]?,
              ?request_options: OpenAI::RequestOptions
            }

            type desktop = { enabled: bool }

            class Desktop < OpenAI::Internal::Type::BaseModel
              # Whether to provision the desktop and its browser proxy.
              attr_accessor enabled: bool

              # @param enabled
              #   Whether to provision the desktop and its browser proxy.
              def initialize: (enabled: bool) -> void

              def to_hash: -> { enabled: bool }
            end

            type network =
              {
                access: OpenAI::Models::Beta::Agents::Environments::TemplateUpdateParams::Network::access,
                ?allowed_domains: ::Array[String]?,
                ?blocked_domains: ::Array[String]?
              }

            class Network < OpenAI::Internal::Type::BaseModel
              # The environment's network access mode.
              attr_accessor access: OpenAI::Models::Beta::Agents::Environments::TemplateUpdateParams::Network::access

              # Domains the environment may access when network access is restricted.
              attr_accessor allowed_domains: ::Array[String]?

              # Domains blocked for both executor and browser when access is restricted. A
              # nonempty list requires `access: restricted` and cannot be combined with nonempty
              # `allowed_domains`. Wildcard domains are not supported.
              attr_accessor blocked_domains: ::Array[String]?

              # @param access
              #   The environment's network access mode.
              # @param allowed_domains
              #   Domains the environment may access when network access is restricted.
              # @param blocked_domains
              #   Domains blocked for both executor and browser when access is restricted. A
              #   nonempty list requires `access: restricted` and cannot be combined with nonempty
              #   `allowed_domains`. Wildcard domains are not supported.
              def initialize: (
                access: OpenAI::Models::Beta::Agents::Environments::TemplateUpdateParams::Network::access,
                ?allowed_domains: ::Array[String]?,
                ?blocked_domains: ::Array[String]?
              ) -> void

              def to_hash: -> {
                access: OpenAI::Models::Beta::Agents::Environments::TemplateUpdateParams::Network::access,
                ?allowed_domains: ::Array[String]?,
                ?blocked_domains: ::Array[String]?
              }

              type access = :enabled | :disabled | :restricted

              module Access
                extend OpenAI::Internal::Type::Enum

                # Allows unrestricted network access.
                ENABLED: :enabled

                # Disables network access.
                DISABLED: :disabled

                # Applies the configured domain restrictions.
                RESTRICTED: :restricted

                def self?.values: -> ::Array[OpenAI::Models::Beta::Agents::Environments::TemplateUpdateParams::Network::access]
              end
            end

            type packages =
              {
                ?npm: ::Array[String]?,
                ?python: ::Array[String]?,
                ?system_: ::Array[String]?
              }

            class Packages < OpenAI::Internal::Type::BaseModel
              # npm packages to install globally. Defaults to an empty list.
              attr_accessor npm: ::Array[String]?

              # Python packages to install. Defaults to an empty list.
              attr_accessor python: ::Array[String]?

              # System packages to install. Defaults to an empty list.
              attr_accessor system_: ::Array[String]?

              # @param npm
              #   npm packages to install globally. Defaults to an empty list.
              # @param python
              #   Python packages to install. Defaults to an empty list.
              # @param system_
              #   System packages to install. Defaults to an empty list.
              def initialize: (
                ?npm: ::Array[String]?,
                ?python: ::Array[String]?,
                ?system_: ::Array[String]?
              ) -> void

              def to_hash: -> {
                ?npm: ::Array[String]?,
                ?python: ::Array[String]?,
                ?system_: ::Array[String]?
              }
            end
          end
        end
      end
    end
  end
end
