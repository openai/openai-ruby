              ?page: String,
              ?path: String?,
              ?request_options: OpenAI::RequestOptions
            }

            type order = :asc | :desc

            module Order
              extend OpenAI::Internal::Type::Enum

              # Returns resources in ascending order.
              ASC: :asc

              # Returns resources in descending order.
              DESC: :desc

              def self?.values: -> ::Array[OpenAI::Models::Beta::Agents::Environments::FileListParams::order]
