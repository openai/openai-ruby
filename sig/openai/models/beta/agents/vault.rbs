module OpenAI
  module Models
    module Beta
      module Agents
        type vault =
          {
            id: String,
            created_at: Integer,
            metadata: ::Hash[Symbol, String],
            name: String?,
            ?object: :vault
          }

        class Vault < OpenAI::Internal::Type::BaseModel
          # The ID of the vault.
          attr_accessor id: String

          # The Unix timestamp, in seconds, when the vault was created.
          attr_accessor created_at: Integer

          # Key-value pairs associated with the vault, such as an application or team
          # identifier.
          attr_accessor metadata: ::Hash[Symbol, String]

          # The human-readable name of the vault, if set.
          attr_accessor name: String?

          # The object type. Always `vault`.
          attr_accessor object: :vault

          # @param id
          #   The ID of the vault.
          # @param created_at
          #   The Unix timestamp, in seconds, when the vault was created.
          # @param metadata
          #   Key-value pairs associated with the vault, such as an application or team
          #   identifier.
          # @param name
          #   The human-readable name of the vault, if set.
          # @param object
          #   The object type. Always `vault`.
          def initialize: (
            id: String,
            created_at: Integer,
            metadata: ::Hash[Symbol, String],
            name: String?,
            ?object: :vault
          ) -> void

          def to_hash: -> {
            id: String,
            created_at: Integer,
            metadata: ::Hash[Symbol, String],
            name: String?,
            ?object: :vault
          }
        end
      end
    end
  end
end
