module OpenAI
  module Models
    module Beta
      module Agents
        type session_create_params =
          {
            environment: OpenAI::Models::Beta::environment_param,
            ?agent: OpenAI::Beta::Agents::SessionCreateParams::Agent,
            ?agent_id: String,
            ?input: OpenAI::Models::Beta::Agents::SessionCreateParams::input?,
            ?metadata: ::Hash[Symbol, String]?,
            ?review: OpenAI::Models::Beta::Agents::SessionCreateParams::review,
            ?spend_control: OpenAI::Beta::Agents::SessionCreateParams::SpendControl?,
            ?vault_ids: ::Array[String]?,
            ?request_options: OpenAI::request_opts
          }

        class SessionCreateParams < OpenAI::Internal::Type::BaseModel
          extend OpenAI::Internal::Type::RequestParameters::Converter
          include OpenAI::Internal::Type::RequestParameters

          # An inline execution environment or a reference to an environment template.
          attr_accessor environment: OpenAI::Models::Beta::environment_param

          # Agent configuration. With `agent_id`, supplied fields override the saved agent
          # for this session. Without `agent_id`, `model` is required.
          attr_reader agent: OpenAI::Beta::Agents::SessionCreateParams::Agent?

          # Agent configuration. With `agent_id`, supplied fields override the saved agent
          # for this session. Without `agent_id`, `model` is required.
          def agent=: (
            OpenAI::Beta::Agents::SessionCreateParams::Agent
          ) -> OpenAI::Beta::Agents::SessionCreateParams::Agent

          # The ID of a saved reusable agent. Omit `agent` to use its configuration
          # unchanged.
          attr_reader agent_id: String?

          # The ID of a saved reusable agent. Omit `agent` to use its configuration
          # unchanged.
          def agent_id=: (String) -> String

          # Initial input to submit when the session is created. A string is shorthand for a
          # single user message. Required when `environment.type` is `none`, or when
          # `stream` is `true` for an environment that is not `self_hosted`; optional for
          # self-hosted and non-streaming execution environments.
          attr_accessor input: OpenAI::Models::Beta::Agents::SessionCreateParams::input?

          # Up to 16 string key-value pairs, with keys up to 64 and values up to 512
          # characters. Omission or null defaults to an empty map.
          attr_accessor metadata: ::Hash[Symbol, String]?

          # Action review mode. Omit to use none.
          attr_reader review: OpenAI::Models::Beta::Agents::SessionCreateParams::review?

          # Action review mode. Omit to use none.
          def review=: (
            OpenAI::Models::Beta::Agents::SessionCreateParams::review
          ) -> OpenAI::Models::Beta::Agents::SessionCreateParams::review

          # Optional spending limit in USD cents. Omission or null creates an unlimited
          # session.
          attr_accessor spend_control: OpenAI::Beta::Agents::SessionCreateParams::SpendControl?

          # The IDs of vaults made available to the session.
          attr_accessor vault_ids: ::Array[String]?

          # @param environment
          #   An inline execution environment or a reference to an environment template.
          # @param agent
          #   Agent configuration. With `agent_id`, supplied fields override the saved agent
          #   for this session. Without `agent_id`, `model` is required.
          # @param agent_id
          #   The ID of a saved reusable agent. Omit `agent` to use its configuration
          #   unchanged.
          # @param input
          #   Initial input to submit when the session is created. A string is shorthand for a
          #   single user message. Required when `environment.type` is `none`, or when
          #   `stream` is `true` for an environment that is not `self_hosted`; optional for
          #   self-hosted and non-streaming execution environments.
          # @param metadata
          #   Up to 16 string key-value pairs, with keys up to 64 and values up to 512
          #   characters. Omission or null defaults to an empty map.
          # @param review
          #   Action review mode. Omit to use none.
          # @param spend_control
          #   Optional spending limit in USD cents. Omission or null creates an unlimited
          #   session.
          # @param vault_ids
          #   The IDs of vaults made available to the session.
          def initialize: (
            environment: OpenAI::Models::Beta::environment_param,
            ?agent: OpenAI::Beta::Agents::SessionCreateParams::Agent,
            ?agent_id: String,
            ?input: OpenAI::Models::Beta::Agents::SessionCreateParams::input?,
            ?metadata: ::Hash[Symbol, String]?,
            ?review: OpenAI::Models::Beta::Agents::SessionCreateParams::review,
            ?spend_control: OpenAI::Beta::Agents::SessionCreateParams::SpendControl?,
            ?vault_ids: ::Array[String]?,
            ?request_options: OpenAI::request_opts
          ) -> void

          def to_hash: -> {
            environment: OpenAI::Models::Beta::environment_param,
            ?agent: OpenAI::Beta::Agents::SessionCreateParams::Agent,
            ?agent_id: String,
            ?input: OpenAI::Models::Beta::Agents::SessionCreateParams::input?,
            ?metadata: ::Hash[Symbol, String]?,
            ?review: OpenAI::Models::Beta::Agents::SessionCreateParams::review,
            ?spend_control: OpenAI::Beta::Agents::SessionCreateParams::SpendControl?,
            ?vault_ids: ::Array[String]?,
            ?request_options: OpenAI::RequestOptions
          }

          type agent =
            {
              ?compaction: OpenAI::Beta::Agents::SessionCreateParams::Agent::Compaction?,
              ?experimental: OpenAI::Beta::Agents::SessionCreateParams::Agent::Experimental,
              ?instructions: String?,
              ?model: String,
              ?multi_agent: OpenAI::Beta::MultiAgentConfigParam?,
              ?reasoning: OpenAI::Beta::AgentReasoningParam?,
              ?service_tier: OpenAI::Models::Beta::Agents::SessionCreateParams::Agent::service_tier?,
              ?text: OpenAI::Beta::AgentTextParam?,
              ?tools: ::Array[OpenAI::Models::Beta::agent_tool_param]?
            }

          class Agent < OpenAI::Internal::Type::BaseModel
            # Context compaction settings. Omit to keep the current settings. A supplied
            # object replaces the settings; null or an empty object enables background
            # compaction.
            attr_accessor compaction: OpenAI::Beta::Agents::SessionCreateParams::Agent::Compaction?

            # Experimental settings to merge by key. Omitted settings keep their current
            # values.
            attr_reader experimental: OpenAI::Beta::Agents::SessionCreateParams::Agent::Experimental?

            # Experimental settings to merge by key. Omitted settings keep their current
            # values.
            def experimental=: (
              OpenAI::Beta::Agents::SessionCreateParams::Agent::Experimental
            ) -> OpenAI::Beta::Agents::SessionCreateParams::Agent::Experimental

            # Additional instructions appended to the agent's default base instructions. Omit
            # to leave unchanged.
            attr_accessor instructions: String?

            # The model to use for the agent. The requested model name is preserved.
            attr_reader model: String?

            # The model to use for the agent. The requested model name is preserved.
            def model=: (String) -> String

            # Configuration for creating and coordinating subagents.
            attr_accessor multi_agent: OpenAI::Beta::MultiAgentConfigParam?

            # Configuration for model reasoning. Omit to keep the current settings; pass
            # `null` to reset to the model's default effort.
            attr_accessor reasoning: OpenAI::Beta::AgentReasoningParam?

            # The service tier used for model requests.
            attr_accessor service_tier: OpenAI::Models::Beta::Agents::SessionCreateParams::Agent::service_tier?

            # Configuration for text generated by the agent.
            attr_accessor text: OpenAI::Beta::AgentTextParam?

            # Tools available to the agent. Omit to inherit, or pass null to clear them. The
            # resolved tool list must fit within 3 MiB (3,145,728 bytes) of compact UTF-8
            # JSON.
            attr_accessor tools: ::Array[OpenAI::Models::Beta::agent_tool_param]?

            # @param compaction
            #   Context compaction settings. Omit to keep the current settings. A supplied
            #   object replaces the settings; null or an empty object enables background
            #   compaction.
            # @param experimental
            #   Experimental settings to merge by key. Omitted settings keep their current
            #   values.
            # @param instructions
            #   Additional instructions appended to the agent's default base instructions. Omit
            #   to leave unchanged.
            # @param model
            #   The model to use for the agent. The requested model name is preserved.
            # @param multi_agent
            #   Configuration for creating and coordinating subagents.
            # @param reasoning
            #   Configuration for model reasoning. Omit to keep the current settings; pass
            #   `null` to reset to the model's default effort.
            # @param service_tier
            #   The service tier used for model requests.
            # @param text
            #   Configuration for text generated by the agent.
            # @param tools
            #   Tools available to the agent. Omit to inherit, or pass null to clear them. The
            #   resolved tool list must fit within 3 MiB (3,145,728 bytes) of compact UTF-8
            #   JSON.
            def initialize: (
              ?compaction: OpenAI::Beta::Agents::SessionCreateParams::Agent::Compaction?,
              ?experimental: OpenAI::Beta::Agents::SessionCreateParams::Agent::Experimental,
              ?instructions: String?,
              ?model: String,
              ?multi_agent: OpenAI::Beta::MultiAgentConfigParam?,
              ?reasoning: OpenAI::Beta::AgentReasoningParam?,
              ?service_tier: OpenAI::Models::Beta::Agents::SessionCreateParams::Agent::service_tier?,
              ?text: OpenAI::Beta::AgentTextParam?,
              ?tools: ::Array[OpenAI::Models::Beta::agent_tool_param]?
            ) -> void

            def to_hash: -> {
              ?compaction: OpenAI::Beta::Agents::SessionCreateParams::Agent::Compaction?,
              ?experimental: OpenAI::Beta::Agents::SessionCreateParams::Agent::Experimental,
              ?instructions: String?,
              ?model: String,
              ?multi_agent: OpenAI::Beta::MultiAgentConfigParam?,
              ?reasoning: OpenAI::Beta::AgentReasoningParam?,
              ?service_tier: OpenAI::Models::Beta::Agents::SessionCreateParams::Agent::service_tier?,
              ?text: OpenAI::Beta::AgentTextParam?,
              ?tools: ::Array[OpenAI::Models::Beta::agent_tool_param]?
            }

            type compaction = { ?async: bool? }

            class Compaction < OpenAI::Internal::Type::BaseModel
              # Whether to compact context in the background. Omission or null defaults to true.
              # Set to false to use blocking compaction. Background compaction may increase
              # token usage.
              attr_accessor async: bool?

              # @param async
              #   Whether to compact context in the background. Omission or null defaults to true.
              #   Set to false to use blocking compaction. Background compaction may increase
              #   token usage.
              def initialize: (?async: bool?) -> void

              def to_hash: -> { ?async: bool? }
            end

            type experimental = { ?time_awareness: bool }

            class Experimental < OpenAI::Internal::Type::BaseModel
              # Whether to give the model periodic current-time reminders. Omit to keep the
              # current setting.
              attr_reader time_awareness: bool?

              # Whether to give the model periodic current-time reminders. Omit to keep the
              # current setting.
              def time_awareness=: (bool) -> bool

              # @param time_awareness
              #   Whether to give the model periodic current-time reminders. Omit to keep the
              #   current setting.
              def initialize: (?time_awareness: bool) -> void

              def to_hash: -> { ?time_awareness: bool }
            end

            type service_tier =
              :auto | :default | :flex | :priority | :fast | :ultrafast

            module ServiceTier
              extend OpenAI::Internal::Type::Enum

              # Selects the service tier automatically.
              AUTO: :auto

              # Uses the default service tier.
              DEFAULT: :default

              # Uses the flex service tier.
              FLEX: :flex

              # Uses the priority service tier.
              PRIORITY: :priority

              # Uses the fast service tier.
              FAST: :fast

              # Uses the ultrafast service tier.
              ULTRAFAST: :ultrafast

              def self?.values: -> ::Array[OpenAI::Models::Beta::Agents::SessionCreateParams::Agent::service_tier]
            end
          end

          type input =
            String | ::Array[OpenAI::Beta::AgentSessionInputMessageParam]

          module Input
            extend OpenAI::Internal::Type::Union

            def self?.variants: -> ::Array[OpenAI::Models::Beta::Agents::SessionCreateParams::input]

            AgentSessionInputMessageParamArray: OpenAI::Internal::Type::Converter
          end

          type review = :none | :auto_review

          module Review
            extend OpenAI::Internal::Type::Enum

            # Keep the existing execution behavior without automatic action review.
            NONE: :none

            # Review eligible actions automatically. Deny manual approval fallbacks.
            AUTO_REVIEW: :auto_review

            def self?.values: -> ::Array[OpenAI::Models::Beta::Agents::SessionCreateParams::review]
          end

          type spend_control = { limit: Integer? }

          class SpendControl < OpenAI::Internal::Type::BaseModel
            # Positive USD cents, or null to remove the limit.
            attr_accessor limit: Integer?

            # @param limit
            #   Positive USD cents, or null to remove the limit.
            def initialize: (limit: Integer?) -> void

            def to_hash: -> { limit: Integer? }
          end
        end
      end
