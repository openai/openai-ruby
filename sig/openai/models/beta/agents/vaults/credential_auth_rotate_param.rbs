                ?expires_at: String?,
                ?refresh: OpenAI::Beta::Agents::Vaults::CredentialAuthRotateParam::McpOauth::Refresh?
              }

              type refresh =
                {
                  ?refresh_token: String?,
                  ?scope: String?,
                  ?token_endpoint_auth: OpenAI::Models::Beta::Agents::Vaults::mcp_oauth_token_endpoint_auth_rotate_param?
                }

              class Refresh < OpenAI::Internal::Type::BaseModel
                attr_accessor refresh_token: String?

                attr_accessor scope: String?

                attr_accessor token_endpoint_auth: OpenAI::Models::Beta::Agents::Vaults::mcp_oauth_token_endpoint_auth_rotate_param?

                def initialize: (
