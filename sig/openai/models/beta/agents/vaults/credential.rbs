module OpenAI
  module Models
    module Beta
      module Agents
        module Vaults
          type credential =
            {
              id: String,
              auth: OpenAI::Models::Beta::Agents::Vaults::credential_auth,
              created_at: Integer,
              name: String,
              ?object: :"vault.credential",
              updated_at: Integer,
              vault_id: String
            }

          class Credential < OpenAI::Internal::Type::BaseModel
            # The ID of the credential.
            attr_accessor id: String

            # The authentication method and non-secret configuration of the credential.
            attr_accessor auth: OpenAI::Models::Beta::Agents::Vaults::credential_auth

            # The Unix timestamp, in seconds, when the credential was created.
            attr_accessor created_at: Integer

            # The human-readable name of the credential.
            attr_accessor name: String

            # The object type. Always `vault.credential`.
            attr_accessor object: :"vault.credential"

            # The Unix timestamp, in seconds, when the credential was last updated.
            attr_accessor updated_at: Integer

            # The ID of the vault containing this credential.
            attr_accessor vault_id: String

            # @param id
            #   The ID of the credential.
            # @param auth
            #   The authentication method and non-secret configuration of the credential.
            # @param created_at
            #   The Unix timestamp, in seconds, when the credential was created.
            # @param name
            #   The human-readable name of the credential.
            # @param updated_at
            #   The Unix timestamp, in seconds, when the credential was last updated.
            # @param vault_id
            #   The ID of the vault containing this credential.
            # @param object
            #   The object type. Always `vault.credential`.
            def initialize: (
              id: String,
              auth: OpenAI::Models::Beta::Agents::Vaults::credential_auth,
              created_at: Integer,
              name: String,
              updated_at: Integer,
              vault_id: String,
              ?object: :"vault.credential"
            ) -> void

            def to_hash: -> {
              id: String,
              auth: OpenAI::Models::Beta::Agents::Vaults::credential_auth,
              created_at: Integer,
              name: String,
              ?object: :"vault.credential",
              updated_at: Integer,
              vault_id: String
            }
          end
        end
      end
    end
  end
end
