module OpenAI
  module Models
    module Beta
      module Agents
        module Vaults
          type credential_auth =
            OpenAI::Beta::Agents::Vaults::CredentialAuth::McpOauth
            | OpenAI::Beta::Agents::Vaults::CredentialAuth::StaticBearer
            | OpenAI::Beta::Agents::Vaults::CredentialAuth::EnvironmentVariable

          module CredentialAuth
            extend OpenAI::Internal::Type::Union

            type mcp_oauth =
              {
                expires_at: String?,
                mcp_server_url: String,
                refresh: OpenAI::Beta::Agents::Vaults::CredentialAuth::McpOauth::Refresh?,
                ?type: :mcp_oauth
              }

            class McpOauth < OpenAI::Internal::Type::BaseModel
              # When the OAuth access token expires, as an RFC 3339 timestamp, if known.
              attr_accessor expires_at: String?

              # The HTTPS MCP server URL authorized by this credential.
              attr_accessor mcp_server_url: String

              # Public refresh metadata without refresh tokens or OAuth client secrets.
              attr_accessor refresh: OpenAI::Beta::Agents::Vaults::CredentialAuth::McpOauth::Refresh?

              # The type of the object. Always `mcp_oauth`.
              attr_accessor type: :mcp_oauth

              # @param expires_at
              #   When the OAuth access token expires, as an RFC 3339 timestamp, if known.
              # @param mcp_server_url
              #   The HTTPS MCP server URL authorized by this credential.
              # @param refresh
              #   Public refresh metadata without refresh tokens or OAuth client secrets.
              # @param type
              #   The type of the object. Always `mcp_oauth`.
              def initialize: (
                expires_at: String?,
                mcp_server_url: String,
                refresh: OpenAI::Beta::Agents::Vaults::CredentialAuth::McpOauth::Refresh?,
                ?type: :mcp_oauth
              ) -> void

              def to_hash: -> {
                expires_at: String?,
                mcp_server_url: String,
                refresh: OpenAI::Beta::Agents::Vaults::CredentialAuth::McpOauth::Refresh?,
                ?type: :mcp_oauth
              }

              type refresh =
                {
                  client_id: String,
                  resource: String?,
                  scope: String?,
                  token_endpoint: String,
                  token_endpoint_auth: OpenAI::Models::Beta::Agents::Vaults::mcp_oauth_token_endpoint_auth
                }

              class Refresh < OpenAI::Internal::Type::BaseModel
                # The OAuth client ID used when requesting a new access token.
                attr_accessor client_id: String

                # The resource URI sent to the OAuth token endpoint during refresh, if configured.
                attr_accessor resource: String?

                # Space-separated OAuth scopes requested during refresh, if configured.
                attr_accessor scope: String?

                # The HTTPS OAuth token endpoint used for refresh.
                attr_accessor token_endpoint: String

                # How the OAuth client authenticates to the token endpoint, excluding its client
                # secret.
                attr_accessor token_endpoint_auth: OpenAI::Models::Beta::Agents::Vaults::mcp_oauth_token_endpoint_auth

                # @param client_id
                #   The OAuth client ID used when requesting a new access token.
                # @param resource
                #   The resource URI sent to the OAuth token endpoint during refresh, if configured.
                # @param scope
                #   Space-separated OAuth scopes requested during refresh, if configured.
                # @param token_endpoint
                #   The HTTPS OAuth token endpoint used for refresh.
                # @param token_endpoint_auth
                #   How the OAuth client authenticates to the token endpoint, excluding its client
                #   secret.
                def initialize: (
                  client_id: String,
                  resource: String?,
                  scope: String?,
                  token_endpoint: String,
                  token_endpoint_auth: OpenAI::Models::Beta::Agents::Vaults::mcp_oauth_token_endpoint_auth
                ) -> void

                def to_hash: -> {
                  client_id: String,
                  resource: String?,
                  scope: String?,
                  token_endpoint: String,
                  token_endpoint_auth: OpenAI::Models::Beta::Agents::Vaults::mcp_oauth_token_endpoint_auth
                }
              end
            end

            type static_bearer =
              { mcp_server_url: String, ?type: :static_bearer }

            class StaticBearer < OpenAI::Internal::Type::BaseModel
              # The HTTPS MCP server URL authorized by this credential.
              attr_accessor mcp_server_url: String

              # The type of the object. Always `static_bearer`.
              attr_accessor type: :static_bearer

              # @param mcp_server_url
              #   The HTTPS MCP server URL authorized by this credential.
              # @param type
              #   The type of the object. Always `static_bearer`.
              def initialize: (
                mcp_server_url: String,
                ?type: :static_bearer
              ) -> void

              def to_hash: -> { mcp_server_url: String, ?type: :static_bearer }
            end

            type environment_variable =
              {
                networking: OpenAI::Models::Beta::Agents::Vaults::credential_networking,
                secret_name: String,
                ?type: :environment_variable
              }

            class EnvironmentVariable < OpenAI::Internal::Type::BaseModel
              # The destinations where the proxy can substitute the secret, subject to the
              # environment network policy.
              attr_accessor networking: OpenAI::Models::Beta::Agents::Vaults::credential_networking

              # The environment variable name that receives the placeholder in the sandbox.
              attr_accessor secret_name: String

              # The type of the object. Always `environment_variable`.
              attr_accessor type: :environment_variable

              # @param networking
              #   The destinations where the proxy can substitute the secret, subject to the
              #   environment network policy.
              # @param secret_name
              #   The environment variable name that receives the placeholder in the sandbox.
              # @param type
              #   The type of the object. Always `environment_variable`.
              def initialize: (
                networking: OpenAI::Models::Beta::Agents::Vaults::credential_networking,
                secret_name: String,
                ?type: :environment_variable
              ) -> void

              def to_hash: -> {
                networking: OpenAI::Models::Beta::Agents::Vaults::credential_networking,
                secret_name: String,
                ?type: :environment_variable
              }
            end

            def self?.variants: -> ::Array[OpenAI::Models::Beta::Agents::Vaults::credential_auth]
          end
        end
      end
    end
  end
end
