module OpenAI
  module Models
    module Beta
      module Agents
        module Vaults
          type credential_networking =
            OpenAI::Beta::Agents::Vaults::CredentialNetworking::Unrestricted
            | OpenAI::Beta::Agents::Vaults::CredentialNetworking::Limited

          module CredentialNetworking
            extend OpenAI::Internal::Type::Union

            type unrestricted = { ?type: :unrestricted }

            class Unrestricted < OpenAI::Internal::Type::BaseModel
              # The type of the object. Always `unrestricted`.
              attr_accessor type: :unrestricted

              # @param type
              #   The type of the object. Always `unrestricted`.
              def initialize: (?type: :unrestricted) -> void

              def to_hash: -> { ?type: :unrestricted }
            end

            type limited = { allowed_hosts: ::Array[String], ?type: :limited }

            class Limited < OpenAI::Internal::Type::BaseModel
              # The 1 to 16 distinct allowed hostnames or IPv4 addresses, normalized to
              # lowercase. Entries contain no scheme, path, port, or wildcard. IPv6 addresses
              # are not supported.
              attr_accessor allowed_hosts: ::Array[String]

              # The type of the object. Always `limited`.
              attr_accessor type: :limited

              # @param allowed_hosts
              #   The 1 to 16 distinct allowed hostnames or IPv4 addresses, normalized to
              #   lowercase. Entries contain no scheme, path, port, or wildcard. IPv6 addresses
              #   are not supported.
              # @param type
              #   The type of the object. Always `limited`.
              def initialize: (
                allowed_hosts: ::Array[String],
                ?type: :limited
              ) -> void

              def to_hash: -> {
                allowed_hosts: ::Array[String],
                ?type: :limited
              }
            end

            def self?.variants: -> ::Array[OpenAI::Models::Beta::Agents::Vaults::credential_networking]
          end
        end
      end
    end
  end
end
