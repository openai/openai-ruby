            }

            type type_ = :auto | :last_messages

            module Type
              extend OpenAI::Internal::Type::Enum

              AUTO: :auto
              LAST_MESSAGES: :last_messages

              def self?.values: -> ::Array[OpenAI::Models::Beta::Threads::RunCreateParams::TruncationStrategy::type_]
