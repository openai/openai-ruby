            module Content
              extend OpenAI::Internal::Type::Union

              def self?.variants: -> ::Array[OpenAI::Models::Beta::Threads::RunCreateParams::AdditionalMessage::content]

              MessageContentPartParamArray: OpenAI::Internal::Type::Converter
