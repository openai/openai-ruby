module OpenAI
  module Models
    module Beta
      module Threads
        class RunStep = Runs::RunStep

        module Runs
          type run_step =
            {
              id: String,
              assistant_id: String,
              cancelled_at: Integer?,
              completed_at: Integer?,
              created_at: Integer,
              expired_at: Integer?,
              failed_at: Integer?,
              last_error: OpenAI::Beta::Threads::Runs::RunStep::LastError?,
              metadata: OpenAI::Models::metadata?,
