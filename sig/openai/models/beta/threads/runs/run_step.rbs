            attr_accessor status: OpenAI::Models::Beta::Threads::Runs::RunStep::status

            # The details of the run step.
            attr_accessor step_details: OpenAI::Models::Beta::Threads::Runs::RunStep::step_details

            # The ID of the
            # [thread](https://developers.openai.com/api/docs/assistants/migration) that was
            # run.
            attr_accessor thread_id: String

            # The type of run step, which can be either `message_creation` or `tool_calls`.
            attr_accessor type: OpenAI::Models::Beta::Threads::Runs::RunStep::type_

            # Usage statistics related to the run step. This value will be `null` while the
            # run step's status is `in_progress`.
            attr_accessor usage: OpenAI::Beta::Threads::Runs::RunStep::Usage?

            # @param id
            #   The identifier of the run step, which can be referenced in API endpoints.
            # @param assistant_id
            #   The ID of the
            #   [assistant](https://developers.openai.com/api/docs/assistants/migration)
            #   associated with the run step.
            # @param cancelled_at
            #   The Unix timestamp (in seconds) for when the run step was cancelled.
            # @param completed_at
            #   The Unix timestamp (in seconds) for when the run step completed.
            # @param created_at
            #   The Unix timestamp (in seconds) for when the run step was created.
            # @param expired_at
            #   The Unix timestamp (in seconds) for when the run step expired. A step is
            #   considered expired if the parent run is expired.
            # @param failed_at
            #   The Unix timestamp (in seconds) for when the run step failed.
            # @param last_error
            #   The last error associated with this run step. Will be `null` if there are no
            #   errors.
            # @param metadata
            #   Set of 16 key-value pairs that can be attached to an object. This can be useful
            #   for storing additional information about the object in a structured format, and
            #   querying for objects via API or the dashboard.
            #
            #   Keys are strings with a maximum length of 64 characters. Values are strings with
            #   a maximum length of 512 characters.
            # @param run_id
            #   The ID of the [run](https://developers.openai.com/api/docs/assistants/migration)
            #   that this run step is a part of.
            # @param status
            #   The status of the run step, which can be either `in_progress`, `cancelled`,
            #   `failed`, `completed`, or `expired`.
