module OpenAI
  module Models
    module Beta
      type persisted_mcp_transport_param =
        OpenAI::Beta::PersistedMcpTransportParam::HTTP
        | OpenAI::Beta::PersistedMcpTransportParam::Stdio

      module PersistedMcpTransportParam
        extend OpenAI::Internal::Type::Union

        type http =
          {
            server_url: String,
            ?type: :http,
            ?headers: ::Hash[Symbol, String]?
          }

        class HTTP < OpenAI::Internal::Type::BaseModel
          # The URL of the MCP server.
          attr_accessor server_url: String

          # The type of the object. Always `http`.
          attr_accessor type: :http

          # Non-secret HTTP headers sent to the MCP server.
          attr_accessor headers: ::Hash[Symbol, String]?

          # @param server_url
          #   The URL of the MCP server.
          # @param headers
          #   Non-secret HTTP headers sent to the MCP server.
          # @param type
          #   The type of the object. Always `http`.
          def initialize: (
            server_url: String,
            ?headers: ::Hash[Symbol, String]?,
            ?type: :http
          ) -> void

          def to_hash: -> {
            server_url: String,
            ?type: :http,
            ?headers: ::Hash[Symbol, String]?
          }
        end

        type stdio =
          {
            command: String,
            cwd: String,
            ?type: :stdio,
            ?args: ::Array[String]?,
            ?env_vars: ::Array[String]?
          }

        class Stdio < OpenAI::Internal::Type::BaseModel
          # The command used to start the MCP server.
          attr_accessor command: String

          # The working directory used to start the MCP server.
          attr_accessor cwd: String

          # The type of the object. Always `stdio`.
          attr_accessor type: :stdio

          # Arguments passed to the MCP server command.
          attr_accessor args: ::Array[String]?

          # Environment variable names to inherit from the selected execution environment.
          attr_accessor env_vars: ::Array[String]?

          # @param command
          #   The command used to start the MCP server.
          # @param cwd
          #   The working directory used to start the MCP server.
          # @param args
          #   Arguments passed to the MCP server command.
          # @param env_vars
          #   Environment variable names to inherit from the selected execution environment.
          # @param type
          #   The type of the object. Always `stdio`.
          def initialize: (
            command: String,
            cwd: String,
            ?args: ::Array[String]?,
            ?env_vars: ::Array[String]?,
            ?type: :stdio
          ) -> void

          def to_hash: -> {
            command: String,
            cwd: String,
            ?type: :stdio,
            ?args: ::Array[String]?,
            ?env_vars: ::Array[String]?
          }
        end

        def self?.variants: -> ::Array[OpenAI::Models::Beta::persisted_mcp_transport_param]
      end
    end
  end
end
