module OpenAI
  module Models
    module Beta
      type agent_session_idle_event =
        {
          event_id: String,
          session: OpenAI::Beta::AgentSession,
          ?type: :"agent.session.idle",
          ?obfuscation: String
        }

      class AgentSessionIdleEvent < OpenAI::Internal::Type::BaseModel
        # The unique ID of the event.
        attr_accessor event_id: String

        # The session that became idle.
        attr_accessor session: OpenAI::Beta::AgentSession

        # The type of the object. Always `agent.session.idle`.
        attr_accessor type: :"agent.session.idle"

        # Random alphanumeric padding. Present when stream obfuscation is enabled.
        attr_reader obfuscation: String?

        # Random alphanumeric padding. Present when stream obfuscation is enabled.
        def obfuscation=: (String) -> String

        # @param event_id
        #   The unique ID of the event.
        # @param session
        #   The session that became idle.
        # @param obfuscation
        #   Random alphanumeric padding. Present when stream obfuscation is enabled.
        # @param type
        #   The type of the object. Always `agent.session.idle`.
        def initialize: (
          event_id: String,
          session: OpenAI::Beta::AgentSession,
          ?obfuscation: String,
          ?type: :"agent.session.idle"
        ) -> void

        def to_hash: -> {
          event_id: String,
          session: OpenAI::Beta::AgentSession,
          ?type: :"agent.session.idle",
          ?obfuscation: String
        }
      end
    end
  end
end
