module OpenAI
  module Models
    module Beta
      type agent_session_failed_event =
        {
          event_id: String,
          session: OpenAI::Beta::AgentSession,
          ?type: :"agent.session.failed",
          ?obfuscation: String
        }

      class AgentSessionFailedEvent < OpenAI::Internal::Type::BaseModel
        # The unique ID of the event.
        attr_accessor event_id: String

        # The failed session.
        attr_accessor session: OpenAI::Beta::AgentSession

        # The type of the object. Always `agent.session.failed`.
        attr_accessor type: :"agent.session.failed"

        # Random alphanumeric padding. Present when stream obfuscation is enabled.
        attr_reader obfuscation: String?

        # Random alphanumeric padding. Present when stream obfuscation is enabled.
        def obfuscation=: (String) -> String

        # @param event_id
        #   The unique ID of the event.
        # @param session
        #   The failed session.
        # @param obfuscation
        #   Random alphanumeric padding. Present when stream obfuscation is enabled.
        # @param type
        #   The type of the object. Always `agent.session.failed`.
        def initialize: (
          event_id: String,
          session: OpenAI::Beta::AgentSession,
          ?obfuscation: String,
          ?type: :"agent.session.failed"
        ) -> void

        def to_hash: -> {
          event_id: String,
          session: OpenAI::Beta::AgentSession,
          ?type: :"agent.session.failed",
          ?obfuscation: String
        }
      end
    end
  end
end
