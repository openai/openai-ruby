              module CategoryAppliedInputType
                extend OpenAI::Internal::Type::Enum

                TEXT: :text
                IMAGE: :image

                def self?.values: -> ::Array[OpenAI::Models::Beta::BetaResponse::Moderation::Input::ModerationResult::category_applied_input_type]
