module OpenAI
  module Models
    module Beta
      type hosted_skill_param =
        OpenAI::Beta::HostedSkillParam::SkillReference
        | OpenAI::Beta::HostedSkillParam::Inline

      module HostedSkillParam
        extend OpenAI::Internal::Type::Union

        type skill_reference =
          { skill_id: String, ?type: :skill_reference, ?version: String? }

        class SkillReference < OpenAI::Internal::Type::BaseModel
          # The ID of the skill created through `/v1/skills`.
          attr_accessor skill_id: String

          # The type of the object. Always `skill_reference`.
          attr_accessor type: :skill_reference

          # The skill version, a positive integer or `latest`; omission selects the default.
          attr_accessor version: String?

          # @param skill_id
          #   The ID of the skill created through `/v1/skills`.
          # @param version
          #   The skill version, a positive integer or `latest`; omission selects the default.
          # @param type
          #   The type of the object. Always `skill_reference`.
          def initialize: (
            skill_id: String,
            ?version: String?,
            ?type: :skill_reference
          ) -> void

          def to_hash: -> {
            skill_id: String,
            ?type: :skill_reference,
            ?version: String?
          }
        end

        type inline =
          {
            description: String,
            name: String,
            source: OpenAI::Beta::InlineCapabilitySourceParam,
            ?type: :inline
          }

        class Inline < OpenAI::Internal::Type::BaseModel
          # The skill description declared in `SKILL.md`.
          attr_accessor description: String

          # The skill name declared in `SKILL.md`.
          attr_accessor name: String

          # Provides ZIP bytes encoded with standard base64.
          attr_accessor source: OpenAI::Beta::InlineCapabilitySourceParam

          # The type of the object. Always `inline`.
          attr_accessor type: :inline

          # @param description
          #   The skill description declared in `SKILL.md`.
          # @param name
          #   The skill name declared in `SKILL.md`.
          # @param source
          #   Provides ZIP bytes encoded with standard base64.
          # @param type
          #   The type of the object. Always `inline`.
          def initialize: (
            description: String,
            name: String,
            source: OpenAI::Beta::InlineCapabilitySourceParam,
            ?type: :inline
          ) -> void

          def to_hash: -> {
            description: String,
            name: String,
            source: OpenAI::Beta::InlineCapabilitySourceParam,
            ?type: :inline
          }
        end

        def self?.variants: -> ::Array[OpenAI::Models::Beta::hosted_skill_param]
      end
    end
  end
end
