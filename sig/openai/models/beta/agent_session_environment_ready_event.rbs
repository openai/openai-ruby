module OpenAI
  module Models
    module Beta
      type agent_session_environment_ready_event =
        {
          environment: OpenAI::Beta::AgentSessionEnvironmentState,
          event_id: String,
          session_id: String,
          turn_id: String?,
          ?type: :"agent.session.environment.ready"
        }

      class AgentSessionEnvironmentReadyEvent < OpenAI::Internal::Type::BaseModel
        # The current environment state.
        attr_accessor environment: OpenAI::Beta::AgentSessionEnvironmentState

        # The unique ID of the event.
        attr_accessor event_id: String

        # The ID of the session associated with the event.
        attr_accessor session_id: String

        # The ID of the turn associated with the event, when applicable.
        attr_accessor turn_id: String?

        # The type of the object. Always `agent.session.environment.ready`.
        attr_accessor type: :"agent.session.environment.ready"

        # @param environment
        #   The current environment state.
        # @param event_id
        #   The unique ID of the event.
        # @param session_id
        #   The ID of the session associated with the event.
        # @param turn_id
        #   The ID of the turn associated with the event, when applicable.
        # @param type
        #   The type of the object. Always `agent.session.environment.ready`.
        def initialize: (
          environment: OpenAI::Beta::AgentSessionEnvironmentState,
          event_id: String,
          session_id: String,
          turn_id: String?,
          ?type: :"agent.session.environment.ready"
        ) -> void

        def to_hash: -> {
          environment: OpenAI::Beta::AgentSessionEnvironmentState,
          event_id: String,
          session_id: String,
          turn_id: String?,
          ?type: :"agent.session.environment.ready"
        }
      end
    end
  end
end
