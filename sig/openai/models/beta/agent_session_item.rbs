module OpenAI
  module Models
    module Beta
      type agent_session_item =
        OpenAI::Beta::AgentSessionMessage
        | OpenAI::Beta::AgentReasoningItem
        | OpenAI::Beta::AgentFunctionCallItem
        | OpenAI::Beta::AgentSessionItem::FunctionCallOutput
        | OpenAI::Beta::AgentSessionItem::AgentMessage
        | OpenAI::Beta::AgentMcpCallItem
        | OpenAI::Beta::AgentSessionItem::ComputerUseCall
        | OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest
        | OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequestResult
        | OpenAI::Beta::AgentWebSearchCallItem
        | OpenAI::Beta::AgentCommandExecutionItem
        | OpenAI::Beta::AgentCreateSubagentCallItem
        | OpenAI::Beta::AgentSendSubagentInputCallItem
        | OpenAI::Beta::AgentResumeSubagentCallItem
        | OpenAI::Beta::AgentWaitForSubagentsCallItem
        | OpenAI::Beta::AgentInterruptSubagentCallItem
        | OpenAI::Beta::AgentCloseSubagentCallItem

      module AgentSessionItem
        extend OpenAI::Internal::Type::Union

        type function_call_output =
          {
            id: String,
            call_id: String,
            error: String?,
            output: OpenAI::Models::Beta::agent_function_call_output?,
            status: OpenAI::Models::Beta::agent_function_call_status,
            turn_id: String,
            ?type: :function_call_output
          }

        class FunctionCallOutput < OpenAI::Internal::Type::BaseModel
          # The ID of the function call output item.
          attr_accessor id: String

          # The ID of the function call that produced this output.
          attr_accessor call_id: String

          # The error message, if the call failed.
          attr_accessor error: String?

          # The function result, if the call succeeded.
          attr_accessor output: OpenAI::Models::Beta::agent_function_call_output?

          # The status of the function call.
          attr_accessor status: OpenAI::Models::Beta::agent_function_call_status

          # The ID of the turn that contains this item.
          attr_accessor turn_id: String

          # The item type. Always `function_call_output`.
          attr_accessor type: :function_call_output

          # @param id
          #   The ID of the function call output item.
          # @param call_id
          #   The ID of the function call that produced this output.
          # @param error
          #   The error message, if the call failed.
          # @param output
          #   The function result, if the call succeeded.
          # @param status
          #   The status of the function call.
          # @param turn_id
          #   The ID of the turn that contains this item.
          # @param type
          #   The item type. Always `function_call_output`.
          def initialize: (
            id: String,
            call_id: String,
            error: String?,
            output: OpenAI::Models::Beta::agent_function_call_output?,
            status: OpenAI::Models::Beta::agent_function_call_status,
            turn_id: String,
            ?type: :function_call_output
          ) -> void

          def to_hash: -> {
            id: String,
            call_id: String,
            error: String?,
            output: OpenAI::Models::Beta::agent_function_call_output?,
            status: OpenAI::Models::Beta::agent_function_call_status,
            turn_id: String,
            ?type: :function_call_output
          }
        end

        type agent_message =
          {
            id: String,
            content: ::Array[OpenAI::Models::Beta::agent_content],
            recipient_agent_id: String,
            sender_agent_id: String,
            turn_id: String,
            ?type: :agent_message
          }

        class AgentMessage < OpenAI::Internal::Type::BaseModel
          # The ID of the message.
          attr_accessor id: String

          # The content exchanged between the agents.
          attr_accessor content: ::Array[OpenAI::Models::Beta::agent_content]

          # The ID or name of the receiving agent.
          attr_accessor recipient_agent_id: String

          # The ID or name of the sending agent.
          attr_accessor sender_agent_id: String

          # The ID of the turn that contains this item.
          attr_accessor turn_id: String

          # The item type. Always `agent_message`.
          attr_accessor type: :agent_message

          # @param id
          #   The ID of the message.
          # @param content
          #   The content exchanged between the agents.
          # @param recipient_agent_id
          #   The ID or name of the receiving agent.
          # @param sender_agent_id
          #   The ID or name of the sending agent.
          # @param turn_id
          #   The ID of the turn that contains this item.
          # @param type
          #   The item type. Always `agent_message`.
          def initialize: (
            id: String,
            content: ::Array[OpenAI::Models::Beta::agent_content],
            recipient_agent_id: String,
            sender_agent_id: String,
            turn_id: String,
            ?type: :agent_message
          ) -> void

          def to_hash: -> {
            id: String,
            content: ::Array[OpenAI::Models::Beta::agent_content],
            recipient_agent_id: String,
            sender_agent_id: String,
            turn_id: String,
            ?type: :agent_message
          }
        end

        type computer_use_call =
          {
            id: String,
            output: OpenAI::Beta::AgentSessionItem::ComputerUseCall::Output?,
            status: OpenAI::Models::Beta::agent_function_call_status,
            title: String?,
            turn_id: String,
            ?type: :computer_use_call
          }

        class ComputerUseCall < OpenAI::Internal::Type::BaseModel
          # The ID of the activity item.
          attr_accessor id: String

          # The last screenshot emitted by the model. Null when screenshot inclusion is
          # disabled or the call emitted no screenshot.
          attr_accessor output: OpenAI::Beta::AgentSessionItem::ComputerUseCall::Output?

          # The execution status of the activity.
          attr_accessor status: OpenAI::Models::Beta::agent_function_call_status

          # A model-generated description of the activity, when available.
          attr_accessor title: String?

          # The ID of the turn that contains this item.
          attr_accessor turn_id: String

          # The item type. Always `computer_use_call`.
          attr_accessor type: :computer_use_call

          # @param id
          #   The ID of the activity item.
          # @param output
          #   The last screenshot emitted by the model. Null when screenshot inclusion is
          #   disabled or the call emitted no screenshot.
          # @param status
          #   The execution status of the activity.
          # @param title
          #   A model-generated description of the activity, when available.
          # @param turn_id
          #   The ID of the turn that contains this item.
          # @param type
          #   The item type. Always `computer_use_call`.
          def initialize: (
            id: String,
            output: OpenAI::Beta::AgentSessionItem::ComputerUseCall::Output?,
            status: OpenAI::Models::Beta::agent_function_call_status,
            title: String?,
            turn_id: String,
            ?type: :computer_use_call
          ) -> void

          def to_hash: -> {
            id: String,
            output: OpenAI::Beta::AgentSessionItem::ComputerUseCall::Output?,
            status: OpenAI::Models::Beta::agent_function_call_status,
            title: String?,
            turn_id: String,
            ?type: :computer_use_call
          }

          type output = { image_url: String, ?type: :computer_screenshot }

          class Output < OpenAI::Internal::Type::BaseModel
            # The complete JPEG image as a base64 data URL.
            attr_accessor image_url: String

            # The content type. Always `computer_screenshot`.
            attr_accessor type: :computer_screenshot

            # @param image_url
            #   The complete JPEG image as a base64 data URL.
            # @param type
            #   The content type. Always `computer_screenshot`.
            def initialize: (
              image_url: String,
              ?type: :computer_screenshot
            ) -> void

            def to_hash: -> { image_url: String, ?type: :computer_screenshot }
          end
        end

        type computer_use_approval_request =
          {
            id: String,
            request: OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request,
            request_id: String,
            turn_id: String,
            ?type: :computer_use_approval_request
          }

        class ComputerUseApprovalRequest < OpenAI::Internal::Type::BaseModel
          # The stable history item ID.
          attr_accessor id: String

          # A registered form awaiting the application's response.
          attr_accessor request: OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request

          attr_accessor request_id: String

          attr_accessor turn_id: String

          # The item type. Always computer_use_approval_request.
          attr_accessor type: :computer_use_approval_request

          # @param id
          #   The stable history item ID.
          # @param request
          #   A registered form awaiting the application's response.
          # @param type
          #   The item type. Always computer_use_approval_request.
          def initialize: (
            id: String,
            request: OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request,
            request_id: String,
            turn_id: String,
            ?type: :computer_use_approval_request
          ) -> void

          def to_hash: -> {
            id: String,
            request: OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request,
            request_id: String,
            turn_id: String,
            ?type: :computer_use_approval_request
          }

          type request =
            {
              credential_origin: String?,
              fields: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Field],
              options: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Option],
              reason: String?,
              ?type: :browser_authentication
            }

          class Request < OpenAI::Internal::Type::BaseModel
            # The registered form or frame origin where values will be entered.
            attr_accessor credential_origin: String?

            # Controls to render. All submitted values are sensitive.
            attr_accessor fields: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Field]

            # Sign-in methods. Empty for a plain form.
            attr_accessor options: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Option]

            # Why the agent needs the user to sign in.
            attr_accessor reason: String?

            # The type of the object. Always `browser_authentication`.
            attr_accessor type: :browser_authentication

            # @param credential_origin
            #   The registered form or frame origin where values will be entered.
            # @param fields
            #   Controls to render. All submitted values are sensitive.
            # @param options
            #   Sign-in methods. Empty for a plain form.
            # @param reason
            #   Why the agent needs the user to sign in.
            # @param type
            #   The type of the object. Always `browser_authentication`.
            def initialize: (
              credential_origin: String?,
              fields: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Field],
              options: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Option],
              reason: String?,
              ?type: :browser_authentication
            ) -> void

            def to_hash: -> {
              credential_origin: String?,
              fields: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Field],
              options: ::Array[OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequest::Request::Option],
              reason: String?,
              ?type: :browser_authentication
            }

            type field =
              { id: String, label: String, required: bool, type: String }

            class Field < OpenAI::Internal::Type::BaseModel
              # The field ID to submit as field_id in a fields entry.
              attr_accessor id: String

              # The label to display beside the control.
              attr_accessor label: String

              # Whether this control requires a nonempty value.
              attr_accessor required: bool

              # The rendering type, such as email, password, or text.
              attr_accessor type: String

              # @param id
              #   The field ID to submit as field_id in a fields entry.
              # @param label
              #   The label to display beside the control.
              # @param required
              #   Whether this control requires a nonempty value.
              # @param type
              #   The rendering type, such as email, password, or text.
              def initialize: (
                id: String,
                label: String,
                required: bool,
                type: String
              ) -> void

              def to_hash: -> {
                id: String,
                label: String,
                required: bool,
                type: String
              }
            end

            type option =
              { id: String, field_ids: ::Array[String], label: String }

            class Option < OpenAI::Internal::Type::BaseModel
              # The option ID to submit as selected_option.
              attr_accessor id: String

              # IDs from the registered fields that this method accepts.
              attr_accessor field_ids: ::Array[String]

              # The method label to display.
              attr_accessor label: String

              # @param id
              #   The option ID to submit as selected_option.
              # @param field_ids
              #   IDs from the registered fields that this method accepts.
              # @param label
              #   The method label to display.
              def initialize: (
                id: String,
                field_ids: ::Array[String],
                label: String
              ) -> void

              def to_hash: -> {
                id: String,
                field_ids: ::Array[String],
                label: String
              }
            end
          end
        end

        type computer_use_approval_request_result =
          {
            id: String,
            request_id: String,
            response: OpenAI::Models::Beta::AgentSessionItem::ComputerUseApprovalRequestResult::response,
            turn_id: String,
            ?type: :computer_use_approval_request_result
          }

        class ComputerUseApprovalRequestResult < OpenAI::Internal::Type::BaseModel
          # The stable history item ID.
          attr_accessor id: String

          # The registered request answered by this item.
          attr_accessor request_id: String

          # The admitted response, without submitted credential values.
          attr_accessor response: OpenAI::Models::Beta::AgentSessionItem::ComputerUseApprovalRequestResult::response

          # The ID of the turn that contains this item.
          attr_accessor turn_id: String

          attr_accessor type: :computer_use_approval_request_result

          # @param id
          #   The stable history item ID.
          # @param request_id
          #   The registered request answered by this item.
          # @param response
          #   The admitted response, without submitted credential values.
          # @param turn_id
          #   The ID of the turn that contains this item.
          def initialize: (
            id: String,
            request_id: String,
            response: OpenAI::Models::Beta::AgentSessionItem::ComputerUseApprovalRequestResult::response,
            turn_id: String,
            ?type: :computer_use_approval_request_result
          ) -> void

          def to_hash: -> {
            id: String,
            request_id: String,
            response: OpenAI::Models::Beta::AgentSessionItem::ComputerUseApprovalRequestResult::response,
            turn_id: String,
            ?type: :computer_use_approval_request_result
          }

          type response =
            OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequestResult::Response::Submit
            | OpenAI::Beta::AgentSessionItem::ComputerUseApprovalRequestResult::Response::Cancel

          module Response
            extend OpenAI::Internal::Type::Union

            type submit =
              {
                ?action: :submit,
                selected_option: String?,
                ?type: :browser_authentication
              }

            class Submit < OpenAI::Internal::Type::BaseModel
              attr_accessor action: :submit

              # The chosen sign-in method, or null when no options were offered.
              attr_accessor selected_option: String?

              attr_accessor type: :browser_authentication

              # @param selected_option
              #   The chosen sign-in method, or null when no options were offered.
              def initialize: (
                selected_option: String?,
                ?action: :submit,
                ?type: :browser_authentication
              ) -> void

              def to_hash: -> {
                ?action: :submit,
                selected_option: String?,
                ?type: :browser_authentication
              }
            end

            type cancel = { ?action: :cancel, ?type: :browser_authentication }

            class Cancel < OpenAI::Internal::Type::BaseModel
              attr_accessor action: :cancel

              attr_accessor type: :browser_authentication

              def initialize: (
                ?action: :cancel,
                ?type: :browser_authentication
              ) -> void

              def to_hash: -> {
                ?action: :cancel,
                ?type: :browser_authentication
              }
            end

            def self?.variants: -> ::Array[OpenAI::Models::Beta::AgentSessionItem::ComputerUseApprovalRequestResult::response]
          end
        end

        def self?.variants: -> ::Array[OpenAI::Models::Beta::agent_session_item]
      end
    end
  end
end
