module OpenAI
  module Models
    class BetaResponseTextDeltaEvent = Beta::BetaResponseTextDeltaEvent

    module Beta
      type beta_response_text_delta_event =
        {
          content_index: Integer,
          delta: String,
          item_id: String,
          logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob],
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_text.delta",
          ?agent: OpenAI::Beta::BetaResponseTextDeltaEvent::Agent?
        }

      class BetaResponseTextDeltaEvent < OpenAI::Internal::Type::BaseModel
        # The index of the content part that the text delta was added to.
        attr_accessor content_index: Integer

        # The text delta that was added.
        attr_accessor delta: String

        # The ID of the output item that the text delta was added to.
        attr_accessor item_id: String

        # The log probabilities of the tokens in the delta.
        attr_accessor logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob]

        # The index of the output item that the text delta was added to.
        attr_accessor output_index: Integer

        # The sequence number for this event.
        attr_accessor sequence_number: Integer

        # The type of the event. Always `response.output_text.delta`.
        attr_accessor type: :"response.output_text.delta"

        # The agent that owns this multi-agent streaming event.
        attr_accessor agent: OpenAI::Beta::BetaResponseTextDeltaEvent::Agent?

        # @param content_index
        #   The index of the content part that the text delta was added to.
        # @param delta
        #   The text delta that was added.
        # @param item_id
        #   The ID of the output item that the text delta was added to.
        # @param logprobs
        #   The log probabilities of the tokens in the delta.
        # @param output_index
        #   The index of the output item that the text delta was added to.
        # @param sequence_number
        #   The sequence number for this event.
        # @param agent
        #   The agent that owns this multi-agent streaming event.
        # @param type
        #   The type of the event. Always `response.output_text.delta`.
        def initialize: (
          content_index: Integer,
          delta: String,
          item_id: String,
          logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob],
          output_index: Integer,
          sequence_number: Integer,
          ?agent: OpenAI::Beta::BetaResponseTextDeltaEvent::Agent?,
          ?type: :"response.output_text.delta"
        ) -> void

        def to_hash: -> {
          content_index: Integer,
          delta: String,
          item_id: String,
          logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob],
          output_index: Integer,
          sequence_number: Integer,
          ?type: :"response.output_text.delta",
          ?agent: OpenAI::Beta::BetaResponseTextDeltaEvent::Agent?
        }

        type logprob =
          {
            token: String,
            logprob: Float,
            ?top_logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob::TopLogprob]
          }

        class Logprob < OpenAI::Internal::Type::BaseModel
          # A possible text token.
          attr_accessor token: String

          # The log probability of this token.
          attr_accessor logprob: Float

          # The log probabilities of up to 20 of the most likely tokens.
          attr_reader top_logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob::TopLogprob]?

          # The log probabilities of up to 20 of the most likely tokens.
          def top_logprobs=: (
            ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob::TopLogprob]
          ) -> ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob::TopLogprob]

          # @param token
          #   A possible text token.
          # @param logprob
          #   The log probability of this token.
          # @param top_logprobs
          #   The log probabilities of up to 20 of the most likely tokens.
          def initialize: (
            token: String,
            logprob: Float,
            ?top_logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob::TopLogprob]
          ) -> void

          def to_hash: -> {
            token: String,
            logprob: Float,
            ?top_logprobs: ::Array[OpenAI::Beta::BetaResponseTextDeltaEvent::Logprob::TopLogprob]
          }

          type top_logprob = { ?token: String, ?logprob: Float }

          class TopLogprob < OpenAI::Internal::Type::BaseModel
            # A possible text token.
            attr_reader token: String?

            # A possible text token.
            def token=: (String) -> String

            # The log probability of this token.
            attr_reader logprob: Float?

            # The log probability of this token.
            def logprob=: (Float) -> Float

            # @param token
            #   A possible text token.
            # @param logprob
            #   The log probability of this token.
            def initialize: (?token: String, ?logprob: Float) -> void

            def to_hash: -> { ?token: String, ?logprob: Float }
          end
        end

        type agent = { agent_name: String }

        class Agent < OpenAI::Internal::Type::BaseModel
          # The canonical name of the agent that produced this item.
          attr_accessor agent_name: String

          # @param agent_name
          #   The canonical name of the agent that produced this item.
          def initialize: (agent_name: String) -> void

          def to_hash: -> { agent_name: String }
        end
      end
    end
  end
end
