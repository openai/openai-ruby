module OpenAI
  module Models
    class BetaResponseReasoningTextDoneEvent = Beta::BetaResponseReasoningTextDoneEvent

    module Beta
      type beta_response_reasoning_text_done_event =
        {
          content_index: Integer,
          item_id: String,
          output_index: Integer,
          sequence_number: Integer,
          text: String,
          ?type: :"response.reasoning_text.done",
          ?agent: OpenAI::Beta::BetaResponseReasoningTextDoneEvent::Agent?
        }

      class BetaResponseReasoningTextDoneEvent < OpenAI::Internal::Type::BaseModel
        # The index of the reasoning content part.
        attr_accessor content_index: Integer

        # The ID of the item this reasoning text is associated with.
        attr_accessor item_id: String

        # The index of the output item this reasoning text is associated with.
        attr_accessor output_index: Integer

        # The sequence number of this event.
        attr_accessor sequence_number: Integer

        # The full text of the completed reasoning content.
        attr_accessor text: String

        # The type of the event. Always `response.reasoning_text.done`.
        attr_accessor type: :"response.reasoning_text.done"

        # The agent that owns this multi-agent streaming event.
        attr_accessor agent: OpenAI::Beta::BetaResponseReasoningTextDoneEvent::Agent?

        # @param content_index
        #   The index of the reasoning content part.
        # @param item_id
        #   The ID of the item this reasoning text is associated with.
        # @param output_index
        #   The index of the output item this reasoning text is associated with.
        # @param sequence_number
        #   The sequence number of this event.
        # @param text
        #   The full text of the completed reasoning content.
        # @param agent
        #   The agent that owns this multi-agent streaming event.
        # @param type
        #   The type of the event. Always `response.reasoning_text.done`.
        def initialize: (
          content_index: Integer,
          item_id: String,
          output_index: Integer,
          sequence_number: Integer,
          text: String,
          ?agent: OpenAI::Beta::BetaResponseReasoningTextDoneEvent::Agent?,
          ?type: :"response.reasoning_text.done"
        ) -> void

        def to_hash: -> {
          content_index: Integer,
          item_id: String,
          output_index: Integer,
          sequence_number: Integer,
          text: String,
          ?type: :"response.reasoning_text.done",
          ?agent: OpenAI::Beta::BetaResponseReasoningTextDoneEvent::Agent?
        }

        type agent = { agent_name: String }

        class Agent < OpenAI::Internal::Type::BaseModel
          # The canonical name of the agent that produced this item.
          attr_accessor agent_name: String

          # @param agent_name
          #   The canonical name of the agent that produced this item.
          def initialize: (agent_name: String) -> void

          def to_hash: -> { agent_name: String }
        end
      end
    end
  end
