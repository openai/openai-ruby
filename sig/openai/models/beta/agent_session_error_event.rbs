module OpenAI
  module Models
    module Beta
      type agent_session_error_event =
        {
          error: OpenAI::Beta::SessionError,
          event_id: String,
          session_id: String,
          ?type: :error,
          ?obfuscation: String
        }

      class AgentSessionErrorEvent < OpenAI::Internal::Type::BaseModel
        # The error that occurred.
        attr_accessor error: OpenAI::Beta::SessionError

        # The unique ID of the event.
        attr_accessor event_id: String

        # The ID of the session associated with the event.
        attr_accessor session_id: String

        # The type of the object. Always `error`.
        attr_accessor type: :error

        # Random alphanumeric padding. Present when stream obfuscation is enabled.
        attr_reader obfuscation: String?

        # Random alphanumeric padding. Present when stream obfuscation is enabled.
        def obfuscation=: (String) -> String

        # @param error
        #   The error that occurred.
        # @param event_id
        #   The unique ID of the event.
        # @param session_id
        #   The ID of the session associated with the event.
        # @param obfuscation
        #   Random alphanumeric padding. Present when stream obfuscation is enabled.
        # @param type
        #   The type of the object. Always `error`.
        def initialize: (
          error: OpenAI::Beta::SessionError,
          event_id: String,
          session_id: String,
          ?obfuscation: String,
          ?type: :error
        ) -> void

        def to_hash: -> {
          error: OpenAI::Beta::SessionError,
          event_id: String,
          session_id: String,
          ?type: :error,
          ?obfuscation: String
        }
      end
    end
  end
end
