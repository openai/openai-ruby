module OpenAI
  module Models
    class BetaResponseInputText = Beta::BetaResponseInputText

    module Beta
      type beta_response_input_text =
        {
          text: String,
          ?type: :input_text,
          ?prompt_cache_breakpoint: OpenAI::Beta::BetaResponseInputText::PromptCacheBreakpoint
        }

      class BetaResponseInputText < OpenAI::Internal::Type::BaseModel
        # The text input to the model.
        attr_accessor text: String

        # The type of the input item. Always `input_text`.
        attr_accessor type: :input_text

        # Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        # from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        # token block.
        attr_reader prompt_cache_breakpoint: OpenAI::Beta::BetaResponseInputText::PromptCacheBreakpoint?

        # Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        # from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        # token block.
        def prompt_cache_breakpoint=: (
          OpenAI::Beta::BetaResponseInputText::PromptCacheBreakpoint
        ) -> OpenAI::Beta::BetaResponseInputText::PromptCacheBreakpoint

        # @param text
        #   The text input to the model.
        # @param prompt_cache_breakpoint
        #   Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        #   from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        #   token block.
        # @param type
        #   The type of the input item. Always `input_text`.
        def initialize: (
          text: String,
          ?prompt_cache_breakpoint: OpenAI::Beta::BetaResponseInputText::PromptCacheBreakpoint,
          ?type: :input_text
        ) -> void

        def to_hash: -> {
          text: String,
          ?type: :input_text,
          ?prompt_cache_breakpoint: OpenAI::Beta::BetaResponseInputText::PromptCacheBreakpoint
        }

        type prompt_cache_breakpoint = { ?mode: :explicit }

        class PromptCacheBreakpoint < OpenAI::Internal::Type::BaseModel
          # The breakpoint mode. Always `explicit`.
          attr_accessor mode: :explicit

          # @param mode
          #   The breakpoint mode. Always `explicit`.
          def initialize: (?mode: :explicit) -> void

          def to_hash: -> { ?mode: :explicit }
        end
      end
    end
  end
end
