module OpenAI
  module Models
    module BetaComputerAction = Beta::BetaComputerAction

    module Beta
      type beta_computer_action =
        OpenAI::Beta::BetaComputerAction::Click
        | OpenAI::Beta::BetaComputerAction::DoubleClick
        | OpenAI::Beta::BetaComputerAction::Drag
        | OpenAI::Beta::BetaComputerAction::Keypress
        | OpenAI::Beta::BetaComputerAction::Move
        | OpenAI::Beta::BetaComputerAction::Screenshot
        | OpenAI::Beta::BetaComputerAction::Scroll
        | OpenAI::Beta::BetaComputerAction::Type
        | OpenAI::Beta::BetaComputerAction::Wait

      module BetaComputerAction
        extend OpenAI::Internal::Type::Union

        type click =
          {
            button: OpenAI::Models::Beta::BetaComputerAction::Click::button,
            ?type: :click,
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?
          }

        class Click < OpenAI::Internal::Type::BaseModel
          # Indicates which mouse button was pressed during the click. One of `left`,
          # `right`, `wheel`, `back`, or `forward`.
          attr_accessor button: OpenAI::Models::Beta::BetaComputerAction::Click::button

          # Specifies the event type. For a click action, this property is always `click`.
          attr_accessor type: :click

          # The x-coordinate where the click occurred.
          attr_accessor x: Integer

          # The y-coordinate where the click occurred.
          attr_accessor y_: Integer

          # The keys being held while clicking.
          attr_accessor keys: ::Array[String]?

          # @param button
          #   Indicates which mouse button was pressed during the click. One of `left`,
          #   `right`, `wheel`, `back`, or `forward`.
          # @param x
          #   The x-coordinate where the click occurred.
          # @param y_
          #   The y-coordinate where the click occurred.
          # @param keys
          #   The keys being held while clicking.
          # @param type
          #   Specifies the event type. For a click action, this property is always `click`.
          def initialize: (
            button: OpenAI::Models::Beta::BetaComputerAction::Click::button,
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?,
            ?type: :click
          ) -> void

          def to_hash: -> {
            button: OpenAI::Models::Beta::BetaComputerAction::Click::button,
            ?type: :click,
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?
          }

          type button = :left | :right | :wheel | :back | :forward

          module Button
            extend OpenAI::Internal::Type::Enum

            LEFT: :left
            RIGHT: :right
            WHEEL: :wheel
            BACK: :back
            FORWARD: :forward

            def self?.values: -> ::Array[OpenAI::Models::Beta::BetaComputerAction::Click::button]
          end
        end

        type double_click =
          {
            keys: ::Array[String]?,
            ?type: :double_click,
            x: Integer,
            y_: Integer
          }

        class DoubleClick < OpenAI::Internal::Type::BaseModel
          # The keys being held while double-clicking.
          attr_accessor keys: ::Array[String]?

          # Specifies the event type. For a double click action, this property is always set
          # to `double_click`.
          attr_accessor type: :double_click

          # The x-coordinate where the double click occurred.
          attr_accessor x: Integer

          # The y-coordinate where the double click occurred.
          attr_accessor y_: Integer

          # @param keys
          #   The keys being held while double-clicking.
          # @param x
          #   The x-coordinate where the double click occurred.
          # @param y_
          #   The y-coordinate where the double click occurred.
          # @param type
          #   Specifies the event type. For a double click action, this property is always set
          #   to `double_click`.
          def initialize: (
            keys: ::Array[String]?,
            x: Integer,
            y_: Integer,
            ?type: :double_click
          ) -> void

          def to_hash: -> {
            keys: ::Array[String]?,
            ?type: :double_click,
            x: Integer,
            y_: Integer
          }
        end

        type drag =
          {
            path: ::Array[OpenAI::Beta::BetaComputerAction::Drag::Path],
            ?type: :drag,
            ?keys: ::Array[String]?
          }

        class Drag < OpenAI::Internal::Type::BaseModel
          # An array of coordinates representing the path of the drag action. Coordinates
          # will appear as an array of objects, eg
          #
          # ```
          # [
          #   { x: 100, y: 200 },
          #   { x: 200, y: 300 }
          # ]
          # ```
          attr_accessor path: ::Array[OpenAI::Beta::BetaComputerAction::Drag::Path]

          # Specifies the event type. For a drag action, this property is always set to
          # `drag`.
          attr_accessor type: :drag

          # The keys being held while dragging the mouse.
          attr_accessor keys: ::Array[String]?

          # @param path
          #   An array of coordinates representing the path of the drag action. Coordinates
          #   will appear as an array of objects, eg
          #
          #   ```
          #   [
          #     { x: 100, y: 200 },
          #     { x: 200, y: 300 }
          #   ]
          #   ```
          # @param keys
          #   The keys being held while dragging the mouse.
          # @param type
          #   Specifies the event type. For a drag action, this property is always set to
          #   `drag`.
          def initialize: (
            path: ::Array[OpenAI::Beta::BetaComputerAction::Drag::Path],
            ?keys: ::Array[String]?,
            ?type: :drag
          ) -> void

          def to_hash: -> {
            path: ::Array[OpenAI::Beta::BetaComputerAction::Drag::Path],
            ?type: :drag,
            ?keys: ::Array[String]?
          }

          type path = { x: Integer, y_: Integer }

          class Path < OpenAI::Internal::Type::BaseModel
            # The x-coordinate.
            attr_accessor x: Integer

            # The y-coordinate.
            attr_accessor y_: Integer

            # @param x
            #   The x-coordinate.
            # @param y_
            #   The y-coordinate.
            def initialize: (x: Integer, y_: Integer) -> void

            def to_hash: -> { x: Integer, y_: Integer }
          end
        end

        type keypress = { keys: ::Array[String], ?type: :keypress }

        class Keypress < OpenAI::Internal::Type::BaseModel
          # The combination of keys the model is requesting to be pressed. This is an array
          # of strings, each representing a key.
          attr_accessor keys: ::Array[String]

          # Specifies the event type. For a keypress action, this property is always set to
          # `keypress`.
          attr_accessor type: :keypress

          # @param keys
          #   The combination of keys the model is requesting to be pressed. This is an array
          #   of strings, each representing a key.
          # @param type
          #   Specifies the event type. For a keypress action, this property is always set to
          #   `keypress`.
          def initialize: (keys: ::Array[String], ?type: :keypress) -> void

          def to_hash: -> { keys: ::Array[String], ?type: :keypress }
        end

        type move =
          { ?type: :move, x: Integer, y_: Integer, ?keys: ::Array[String]? }

        class Move < OpenAI::Internal::Type::BaseModel
          # Specifies the event type. For a move action, this property is always set to
          # `move`.
          attr_accessor type: :move

          # The x-coordinate to move to.
          attr_accessor x: Integer

          # The y-coordinate to move to.
          attr_accessor y_: Integer

          # The keys being held while moving the mouse.
          attr_accessor keys: ::Array[String]?

          # @param x
          #   The x-coordinate to move to.
          # @param y_
          #   The y-coordinate to move to.
          # @param keys
          #   The keys being held while moving the mouse.
          # @param type
          #   Specifies the event type. For a move action, this property is always set to
          #   `move`.
          def initialize: (
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?,
            ?type: :move
          ) -> void

          def to_hash: -> {
            ?type: :move,
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?
          }
        end

        type screenshot = { ?type: :screenshot }

        class Screenshot < OpenAI::Internal::Type::BaseModel
          # Specifies the event type. For a screenshot action, this property is always set
          # to `screenshot`.
          attr_accessor type: :screenshot

          # @param type
          #   Specifies the event type. For a screenshot action, this property is always set
          #   to `screenshot`.
          def initialize: (?type: :screenshot) -> void

          def to_hash: -> { ?type: :screenshot }
        end

        type scroll =
          {
            scroll_x: Integer,
            scroll_y: Integer,
            ?type: :scroll,
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?
          }

        class Scroll < OpenAI::Internal::Type::BaseModel
          # The horizontal scroll distance.
          attr_accessor scroll_x: Integer

          # The vertical scroll distance.
          attr_accessor scroll_y: Integer

          # Specifies the event type. For a scroll action, this property is always set to
          # `scroll`.
          attr_accessor type: :scroll

          # The x-coordinate where the scroll occurred.
          attr_accessor x: Integer

          # The y-coordinate where the scroll occurred.
          attr_accessor y_: Integer

          # The keys being held while scrolling.
          attr_accessor keys: ::Array[String]?

          # @param scroll_x
          #   The horizontal scroll distance.
          # @param scroll_y
          #   The vertical scroll distance.
          # @param x
          #   The x-coordinate where the scroll occurred.
          # @param y_
          #   The y-coordinate where the scroll occurred.
          # @param keys
          #   The keys being held while scrolling.
          # @param type
          #   Specifies the event type. For a scroll action, this property is always set to
          #   `scroll`.
          def initialize: (
            scroll_x: Integer,
            scroll_y: Integer,
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?,
            ?type: :scroll
          ) -> void

          def to_hash: -> {
            scroll_x: Integer,
            scroll_y: Integer,
            ?type: :scroll,
            x: Integer,
            y_: Integer,
            ?keys: ::Array[String]?
          }
        end

        type type_ = { text: String, ?type: :type }

        class Type < OpenAI::Internal::Type::BaseModel
          # The text to type.
          attr_accessor text: String

          # Specifies the event type. For a type action, this property is always set to
          # `type`.
          attr_accessor type: :type

          # @param text
          #   The text to type.
          # @param type
          #   Specifies the event type. For a type action, this property is always set to
          #   `type`.
          def initialize: (text: String, ?type: :type) -> void

          def to_hash: -> { text: String, ?type: :type }
        end

        type wait = { ?type: :wait }

        class Wait < OpenAI::Internal::Type::BaseModel
          # Specifies the event type. For a wait action, this property is always set to
          # `wait`.
          attr_accessor type: :wait

          # @param type
          #   Specifies the event type. For a wait action, this property is always set to
          #   `wait`.
          def initialize: (?type: :wait) -> void

          def to_hash: -> { ?type: :wait }
        end

        def self?.variants: -> ::Array[OpenAI::Models::Beta::beta_computer_action]
      end
    end
  end
end
