module OpenAI
  module Models
    module Beta
      type token_usage =
        {
          input_tokens: Integer,
          input_tokens_details: OpenAI::Beta::TokenUsage::InputTokensDetails,
          output_tokens: Integer,
          output_tokens_details: OpenAI::Beta::TokenUsage::OutputTokensDetails,
          total_tokens: Integer
        }

      class TokenUsage < OpenAI::Internal::Type::BaseModel
        # The number of input tokens used by the agent.
        attr_accessor input_tokens: Integer

        # A breakdown of the agent's input token usage.
        attr_accessor input_tokens_details: OpenAI::Beta::TokenUsage::InputTokensDetails

        # The number of output tokens generated by the agent.
        attr_accessor output_tokens: Integer

        # A breakdown of the agent's output token usage.
        attr_accessor output_tokens_details: OpenAI::Beta::TokenUsage::OutputTokensDetails

        # The total number of input and output tokens used by the agent.
        attr_accessor total_tokens: Integer

        # @param input_tokens
        #   The number of input tokens used by the agent.
        # @param input_tokens_details
        #   A breakdown of the agent's input token usage.
        # @param output_tokens
        #   The number of output tokens generated by the agent.
        # @param output_tokens_details
        #   A breakdown of the agent's output token usage.
        # @param total_tokens
        #   The total number of input and output tokens used by the agent.
        def initialize: (
          input_tokens: Integer,
          input_tokens_details: OpenAI::Beta::TokenUsage::InputTokensDetails,
          output_tokens: Integer,
          output_tokens_details: OpenAI::Beta::TokenUsage::OutputTokensDetails,
          total_tokens: Integer
        ) -> void

        def to_hash: -> {
          input_tokens: Integer,
          input_tokens_details: OpenAI::Beta::TokenUsage::InputTokensDetails,
          output_tokens: Integer,
          output_tokens_details: OpenAI::Beta::TokenUsage::OutputTokensDetails,
          total_tokens: Integer
        }

        type input_tokens_details = { cached_tokens: Integer }

        class InputTokensDetails < OpenAI::Internal::Type::BaseModel
          # The number of input tokens retrieved from the prompt cache.
          attr_accessor cached_tokens: Integer

          # @param cached_tokens
          #   The number of input tokens retrieved from the prompt cache.
          def initialize: (cached_tokens: Integer) -> void

          def to_hash: -> { cached_tokens: Integer }
        end

        type output_tokens_details = { reasoning_tokens: Integer }

        class OutputTokensDetails < OpenAI::Internal::Type::BaseModel
          # The number of output tokens used for reasoning.
          attr_accessor reasoning_tokens: Integer

          # @param reasoning_tokens
          #   The number of output tokens used for reasoning.
          def initialize: (reasoning_tokens: Integer) -> void

          def to_hash: -> { reasoning_tokens: Integer }
        end
      end
    end
  end
end
