module OpenAI
  module Models
    module Beta
      type agent_session_assistant_message =
        {
          id: String,
          content: ::Array[OpenAI::Beta::OutputText],
          phase: OpenAI::Models::Beta::AgentSessionAssistantMessage::phase?,
          ?role: :assistant,
          status: OpenAI::Models::Beta::agent_output_item_status,
          turn_id: String,
          ?type: :message
        }

      class AgentSessionAssistantMessage < OpenAI::Internal::Type::BaseModel
        # The ID of the message.
        attr_accessor id: String

        # The content of the message.
        attr_accessor content: ::Array[OpenAI::Beta::OutputText]

        # The phase of the assistant message.
        attr_accessor phase: OpenAI::Models::Beta::AgentSessionAssistantMessage::phase?

        # The role of the message author. Always `assistant`.
        attr_accessor role: :assistant

        # The status of the message.
        attr_accessor status: OpenAI::Models::Beta::agent_output_item_status

        # The ID of the turn that contains this item.
        attr_accessor turn_id: String

        # The item type. Always `message`.
        attr_accessor type: :message

        # @param id
        #   The ID of the message.
        # @param content
        #   The content of the message.
        # @param phase
        #   The phase of the assistant message.
        # @param status
        #   The status of the message.
        # @param turn_id
        #   The ID of the turn that contains this item.
        # @param role
        #   The role of the message author. Always `assistant`.
        # @param type
        #   The item type. Always `message`.
        def initialize: (
          id: String,
          content: ::Array[OpenAI::Beta::OutputText],
          phase: OpenAI::Models::Beta::AgentSessionAssistantMessage::phase?,
          status: OpenAI::Models::Beta::agent_output_item_status,
          turn_id: String,
          ?role: :assistant,
          ?type: :message
        ) -> void

        def to_hash: -> {
          id: String,
          content: ::Array[OpenAI::Beta::OutputText],
          phase: OpenAI::Models::Beta::AgentSessionAssistantMessage::phase?,
          ?role: :assistant,
          status: OpenAI::Models::Beta::agent_output_item_status,
          turn_id: String,
          ?type: :message
        }

        type phase = :commentary | :final_answer

        module Phase
          extend OpenAI::Internal::Type::Enum

          # Commentary produced while the agent works.
          COMMENTARY: :commentary

          # The agent's final answer.
          FINAL_ANSWER: :final_answer

          def self?.values: -> ::Array[OpenAI::Models::Beta::AgentSessionAssistantMessage::phase]
        end
      end
    end
  end
end
