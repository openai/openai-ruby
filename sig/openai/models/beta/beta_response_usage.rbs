module OpenAI
  module Models
    class BetaResponseUsage = Beta::BetaResponseUsage

    module Beta
      type beta_response_usage =
        {
          input_tokens: Integer,
          input_tokens_details: OpenAI::Beta::BetaResponseUsage::InputTokensDetails,
          output_tokens: Integer,
          output_tokens_details: OpenAI::Beta::BetaResponseUsage::OutputTokensDetails,
          total_tokens: Integer
        }

      class BetaResponseUsage < OpenAI::Internal::Type::BaseModel
        # The number of input tokens.
        attr_accessor input_tokens: Integer

        # A detailed breakdown of the input tokens.
        attr_accessor input_tokens_details: OpenAI::Beta::BetaResponseUsage::InputTokensDetails

        # The number of output tokens.
        attr_accessor output_tokens: Integer

        # A detailed breakdown of the output tokens.
        attr_accessor output_tokens_details: OpenAI::Beta::BetaResponseUsage::OutputTokensDetails

        # The total number of tokens used.
        attr_accessor total_tokens: Integer

        # @param input_tokens
        #   The number of input tokens.
        # @param input_tokens_details
        #   A detailed breakdown of the input tokens.
        # @param output_tokens
        #   The number of output tokens.
        # @param output_tokens_details
        #   A detailed breakdown of the output tokens.
        # @param total_tokens
        #   The total number of tokens used.
        def initialize: (
          input_tokens: Integer,
          input_tokens_details: OpenAI::Beta::BetaResponseUsage::InputTokensDetails,
          output_tokens: Integer,
          output_tokens_details: OpenAI::Beta::BetaResponseUsage::OutputTokensDetails,
          total_tokens: Integer
        ) -> void

        def to_hash: -> {
          input_tokens: Integer,
          input_tokens_details: OpenAI::Beta::BetaResponseUsage::InputTokensDetails,
          output_tokens: Integer,
          output_tokens_details: OpenAI::Beta::BetaResponseUsage::OutputTokensDetails,
          total_tokens: Integer
        }

        type input_tokens_details =
          { cache_write_tokens: Integer, cached_tokens: Integer }

        class InputTokensDetails < OpenAI::Internal::Type::BaseModel
          # The number of input tokens that were written to the cache.
          attr_accessor cache_write_tokens: Integer

          # The number of tokens that were retrieved from the cache.
          # [More on prompt caching](https://developers.openai.com/api/docs/guides/prompt-caching).
          attr_accessor cached_tokens: Integer

          # @param cache_write_tokens
          #   The number of input tokens that were written to the cache.
          # @param cached_tokens
          #   The number of tokens that were retrieved from the cache.
          #   [More on prompt caching](https://developers.openai.com/api/docs/guides/prompt-caching).
          def initialize: (
            cache_write_tokens: Integer,
            cached_tokens: Integer
          ) -> void

          def to_hash: -> {
            cache_write_tokens: Integer,
            cached_tokens: Integer
          }
        end

        type output_tokens_details = { reasoning_tokens: Integer }

        class OutputTokensDetails < OpenAI::Internal::Type::BaseModel
          # The number of reasoning tokens.
          attr_accessor reasoning_tokens: Integer

          # @param reasoning_tokens
          #   The number of reasoning tokens.
          def initialize: (reasoning_tokens: Integer) -> void

          def to_hash: -> { reasoning_tokens: Integer }
        end
      end
    end
  end
end
