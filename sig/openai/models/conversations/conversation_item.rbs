        class ImageGenerationCall < OpenAI::Internal::Type::BaseModel
          # The unique ID of the image generation call.
          attr_accessor id: String

          # The generated image encoded in base64.
          attr_accessor result: String?

          # The status of the image generation call.
          attr_accessor status: OpenAI::Models::Conversations::ConversationItem::ImageGenerationCall::status

          # The type of the image generation call. Always `image_generation_call`.
          attr_accessor type: :image_generation_call

          # The action used for image generation.
          attr_accessor action: OpenAI::Models::Conversations::ConversationItem::ImageGenerationCall::action?

          # The background setting used for generation.
          attr_accessor background: OpenAI::Models::Conversations::ConversationItem::ImageGenerationCall::background?

          # The output format used for generation.
          attr_accessor output_format: OpenAI::Models::Conversations::ConversationItem::ImageGenerationCall::output_format?

          # The quality of the image generated by the image generation tool call. One of
          # `low`, `medium`, `high`, `xhigh`, `max`, or `auto`.
          attr_accessor quality: OpenAI::Models::Conversations::ConversationItem::ImageGenerationCall::quality?

          # The prompt that was used after any model prompt rewriting.
          attr_accessor revised_prompt: String?

          # The image dimensions as a `WIDTHxHEIGHT` string, for example `1536x864`.
          attr_accessor size: OpenAI::Models::Conversations::ConversationItem::ImageGenerationCall::size?

          # @param id
          #   The unique ID of the image generation call.
          # @param result
          #   The generated image encoded in base64.
          # @param status
          #   The status of the image generation call.
          # @param action
          #   The action used for image generation.
          # @param background
          #   The background setting used for generation.
          # @param output_format
          #   The output format used for generation.
          # @param quality
          #   The quality of the image generated by the image generation tool call. One of
          #   `low`, `medium`, `high`, `xhigh`, `max`, or `auto`.
          # @param revised_prompt
          #   The prompt that was used after any model prompt rewriting.
          # @param size
          #   The image dimensions as a `WIDTHxHEIGHT` string, for example `1536x864`.
          # @param type
          #   The type of the image generation call. Always `image_generation_call`.
          def initialize: (
            id: String,
            result: String?,
