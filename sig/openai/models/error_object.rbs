module OpenAI
  module Models
    type error_object =
      {
        code: String?,
        message: String,
        param: String?,
        type: String,
        ?misalignment: OpenAI::ErrorObject::Misalignment
      }

    class ErrorObject < OpenAI::Internal::Type::BaseModel
      attr_accessor code: String?

      attr_accessor message: String

      attr_accessor param: String?

      attr_accessor type: String

      attr_reader misalignment: OpenAI::ErrorObject::Misalignment?

      def misalignment=: (
        OpenAI::ErrorObject::Misalignment
      ) -> OpenAI::ErrorObject::Misalignment

      def initialize: (
        code: String?,
        message: String,
        param: String?,
        type: String,
        ?misalignment: OpenAI::ErrorObject::Misalignment
      ) -> void

      def to_hash: -> {
        code: String?,
        message: String,
        param: String?,
        type: String,
        ?misalignment: OpenAI::ErrorObject::Misalignment
      }

      type misalignment =
        {
          ?detailed_explanation: String,
          ?error_type: OpenAI::Models::ErrorObject::Misalignment::error_type,
          ?steer: OpenAI::ErrorObject::Misalignment::Steer
        }

      class Misalignment < OpenAI::Internal::Type::BaseModel
        # The public explanation for this block.
        attr_reader detailed_explanation: String?

        # The public explanation for this block.
        def detailed_explanation=: (String) -> String

        # An optional classification; clients must accept additional values.
        attr_reader error_type: OpenAI::Models::ErrorObject::Misalignment::error_type?

        # An optional classification; clients must accept additional values.
        def error_type=: (
          OpenAI::Models::ErrorObject::Misalignment::error_type
        ) -> OpenAI::Models::ErrorObject::Misalignment::error_type

        # An optional public continuation instruction.
        attr_reader steer: OpenAI::ErrorObject::Misalignment::Steer?

        # An optional public continuation instruction.
        def steer=: (
          OpenAI::ErrorObject::Misalignment::Steer
        ) -> OpenAI::ErrorObject::Misalignment::Steer

        # @param detailed_explanation
        #   The public explanation for this block.
        # @param error_type
        #   An optional classification; clients must accept additional values.
        # @param steer
        #   An optional public continuation instruction.
        def initialize: (
          ?detailed_explanation: String,
          ?error_type: OpenAI::Models::ErrorObject::Misalignment::error_type,
          ?steer: OpenAI::ErrorObject::Misalignment::Steer
        ) -> void

        def to_hash: -> {
          ?detailed_explanation: String,
          ?error_type: OpenAI::Models::ErrorObject::Misalignment::error_type,
          ?steer: OpenAI::ErrorObject::Misalignment::Steer
        }

        type error_type =
          String
          | :potentially_unintended_data_transfer
          | :potentially_unintended_data_access
          | :potentially_unintended_destructive_activity
          | :other

        module ErrorType
          extend OpenAI::Internal::Type::Union

          def self?.variants: -> ::Array[OpenAI::Models::ErrorObject::Misalignment::error_type]

          POTENTIALLY_UNINTENDED_DATA_TRANSFER: :potentially_unintended_data_transfer
          POTENTIALLY_UNINTENDED_DATA_ACCESS: :potentially_unintended_data_access
          POTENTIALLY_UNINTENDED_DESTRUCTIVE_ACTIVITY: :potentially_unintended_destructive_activity
          OTHER: :other
        end

        type steer = { message: String }

        class Steer < OpenAI::Internal::Type::BaseModel
          # The public continuation instruction.
          attr_accessor message: String

          # @param message
          #   The public continuation instruction.
          def initialize: (message: String) -> void

          def to_hash: -> { message: String }
        end
      end
    end
  end
end
