module OpenAI
  module Models
    type model =
      {
        id: String,
        created: Integer,
        object: :model,
        owned_by: String,
        shutdown_date: Date?
      }

    class Model < OpenAI::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor created: Integer

      attr_accessor object: :model

      attr_accessor owned_by: String

      attr_accessor shutdown_date: Date?

      def initialize: (
        id: String,
        created: Integer,
        owned_by: String,
        ?shutdown_date: Date?,
        ?object: :model
      ) -> void

      def to_hash: -> {
        id: String,
        created: Integer,
        object: :model,
        owned_by: String,
        shutdown_date: Date?
      }
    end
  end
end
