module OpenAI
  module Models
    class ChatCompletionContentPartText = Chat::ChatCompletionContentPartText

    module Chat
      type chat_completion_content_part_text =
        {
          text: String,
          ?type: :text,
          ?prompt_cache_breakpoint: OpenAI::Chat::ChatCompletionContentPartText::PromptCacheBreakpoint
        }

      class ChatCompletionContentPartText < OpenAI::Internal::Type::BaseModel
        # The text content.
        attr_accessor text: String

        # The type of the content part.
        attr_accessor type: :text

        # Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        # from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        # token block.
        attr_reader prompt_cache_breakpoint: OpenAI::Chat::ChatCompletionContentPartText::PromptCacheBreakpoint?

        # Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        # from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        # token block.
        def prompt_cache_breakpoint=: (
          OpenAI::Chat::ChatCompletionContentPartText::PromptCacheBreakpoint
        ) -> OpenAI::Chat::ChatCompletionContentPartText::PromptCacheBreakpoint

        # @param text
        #   The text content.
        # @param prompt_cache_breakpoint
        #   Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
        #   from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
        #   token block.
        # @param type
        #   The type of the content part.
        def initialize: (
          text: String,
          ?prompt_cache_breakpoint: OpenAI::Chat::ChatCompletionContentPartText::PromptCacheBreakpoint,
          ?type: :text
        ) -> void

        def to_hash: -> {
          text: String,
          ?type: :text,
          ?prompt_cache_breakpoint: OpenAI::Chat::ChatCompletionContentPartText::PromptCacheBreakpoint
        }

        type prompt_cache_breakpoint = { ?mode: :explicit }

        class PromptCacheBreakpoint < OpenAI::Internal::Type::BaseModel
          # The breakpoint mode. Always `explicit`.
          attr_accessor mode: :explicit

          # @param mode
          #   The breakpoint mode. Always `explicit`.
          def initialize: (?mode: :explicit) -> void

          def to_hash: -> { ?mode: :explicit }
        end
      end
    end
  end
end
