module OpenAI
  module Models
    class ChatCompletionAudio = Chat::ChatCompletionAudio

    module Chat
      type chat_completion_audio =
        { id: String, data: String, expires_at: Integer, transcript: String }

      class ChatCompletionAudio < OpenAI::Internal::Type::BaseModel
        # Unique identifier for this audio response.
        attr_accessor id: String

        # Base64 encoded audio bytes generated by the model, in the format specified in
        # the request.
        attr_accessor data: String

        # The Unix timestamp (in seconds) for when this audio response will no longer be
        # accessible on the server for use in multi-turn conversations.
        attr_accessor expires_at: Integer

        # Transcript of the audio generated by the model.
        attr_accessor transcript: String

        # @param id
        #   Unique identifier for this audio response.
        # @param data
        #   Base64 encoded audio bytes generated by the model, in the format specified in
        #   the request.
        # @param expires_at
        #   The Unix timestamp (in seconds) for when this audio response will no longer be
        #   accessible on the server for use in multi-turn conversations.
        # @param transcript
        #   Transcript of the audio generated by the model.
        def initialize: (
          id: String,
          data: String,
          expires_at: Integer,
          transcript: String
        ) -> void

        def to_hash: -> {
          id: String,
          data: String,
          expires_at: Integer,
          transcript: String
        }
      end
    end
  end
end
