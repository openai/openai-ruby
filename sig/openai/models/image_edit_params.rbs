          def initialize: (
            ?effort: OpenAI::Models::ImageEditParams::Svg::Reasoning::effort
          ) -> void

          def to_hash: -> {
            ?effort: OpenAI::Models::ImageEditParams::Svg::Reasoning::effort
          }

          type effort =
            :none | :minimal | :low | :medium | :high | :xhigh | :max

          module Effort
            extend OpenAI::Internal::Type::Enum

            NONE: :none
            MINIMAL: :minimal
            LOW: :low
            MEDIUM: :medium
            HIGH: :high
            XHIGH: :xhigh
