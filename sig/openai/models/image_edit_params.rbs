          ?reasoning: OpenAI::ImageEditParams::Svg::Reasoning?
        }

        type reasoning =
          { ?effort: OpenAI::Models::ImageEditParams::Svg::Reasoning::effort }

        class Reasoning < OpenAI::Internal::Type::BaseModel
          # Controls how much effort the model should spend on reasoning for this request.
          attr_reader effort: OpenAI::Models::ImageEditParams::Svg::Reasoning::effort?

          # Controls how much effort the model should spend on reasoning for this request.
          def effort=: (
            OpenAI::Models::ImageEditParams::Svg::Reasoning::effort
          ) -> OpenAI::Models::ImageEditParams::Svg::Reasoning::effort

