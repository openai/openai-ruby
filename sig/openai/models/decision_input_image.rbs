module OpenAI
  module Models
    type decision_input_image =
      {
        image_url: String,
        ?type: :input_image,
        ?detail: OpenAI::Models::DecisionInputImage::detail?,
        ?prompt_cache_breakpoint: (OpenAI::DecisionPromptCacheBreakpoint
        | OpenAI::Models::decision_prompt_cache_breakpoint)?
      }

    class DecisionInputImage < OpenAI::Internal::Type::BaseModel
      # A base64-encoded image in a data URL or a publicly accessible HTTP(S) image URL.
      attr_accessor image_url: String

      attr_accessor type: :input_image

      # The image detail level, using the selected model's image profile. Defaults to
      # auto.
      attr_accessor detail: OpenAI::Models::DecisionInputImage::detail?

      # Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
      # from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
      # token block.
      attr_accessor prompt_cache_breakpoint: (OpenAI::DecisionPromptCacheBreakpoint
      | OpenAI::Models::decision_prompt_cache_breakpoint)?

      # @param image_url
      #   A base64-encoded image in a data URL or a publicly accessible HTTP(S) image URL.
      # @param detail
      #   The image detail level, using the selected model's image profile. Defaults to
      #   auto.
      # @param prompt_cache_breakpoint
      #   Marks the exact end of a reusable prompt prefix. The breakpoint inherits its TTL
      #   from the request's `prompt_cache_options.ttl`; the boundary is not rounded to a
      #   token block.
      def initialize: (
        image_url: String,
        ?detail: OpenAI::Models::DecisionInputImage::detail?,
        ?prompt_cache_breakpoint: (OpenAI::DecisionPromptCacheBreakpoint
        | OpenAI::Models::decision_prompt_cache_breakpoint)?,
        ?type: :input_image
      ) -> void

      def to_hash: -> {
        image_url: String,
        ?type: :input_image,
        ?detail: OpenAI::Models::DecisionInputImage::detail?,
        ?prompt_cache_breakpoint: (OpenAI::DecisionPromptCacheBreakpoint
        | OpenAI::Models::decision_prompt_cache_breakpoint)?
      }

      type detail = :low | :high | :auto | :original

      module Detail
        extend OpenAI::Internal::Type::Enum

        LOW: :low
        HIGH: :high
        AUTO: :auto
        ORIGINAL: :original

        def self?.values: -> ::Array[OpenAI::Models::DecisionInputImage::detail]
      end
    end
  end
end
