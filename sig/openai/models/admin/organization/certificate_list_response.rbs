module OpenAI
  module Models
    module Admin
      module Organization
        type certificate_list_response =
          {
            id: String,
            active: bool,
            certificate_details: OpenAI::Models::Admin::Organization::CertificateListResponse::CertificateDetails,
            created_at: Integer,
            name: String?,
            ?object: :"organization.certificate"
          }

        class CertificateListResponse < OpenAI::Internal::Type::BaseModel
          # The identifier, which can be referenced in API endpoints
          attr_accessor id: String

          # Whether the certificate is currently active at the organization level.
          attr_accessor active: bool

          attr_accessor certificate_details: OpenAI::Models::Admin::Organization::CertificateListResponse::CertificateDetails

          # The Unix timestamp (in seconds) of when the certificate was uploaded.
          attr_accessor created_at: Integer

          # The name of the certificate.
          attr_accessor name: String?

          # The object type, which is always `organization.certificate`.
          attr_accessor object: :"organization.certificate"

          # @param id
          #   The identifier, which can be referenced in API endpoints
          # @param active
          #   Whether the certificate is currently active at the organization level.
          # @param created_at
          #   The Unix timestamp (in seconds) of when the certificate was uploaded.
          # @param name
          #   The name of the certificate.
          # @param object
          #   The object type, which is always `organization.certificate`.
          def initialize: (
            id: String,
            active: bool,
            certificate_details: OpenAI::Models::Admin::Organization::CertificateListResponse::CertificateDetails,
            created_at: Integer,
            name: String?,
            ?object: :"organization.certificate"
          ) -> void

          def to_hash: -> {
            id: String,
            active: bool,
            certificate_details: OpenAI::Models::Admin::Organization::CertificateListResponse::CertificateDetails,
            created_at: Integer,
            name: String?,
            ?object: :"organization.certificate"
          }

          type certificate_details =
            { ?expires_at: Integer, ?valid_at: Integer }

          class CertificateDetails < OpenAI::Internal::Type::BaseModel
            # The Unix timestamp (in seconds) of when the certificate expires.
            attr_reader expires_at: Integer?

            # The Unix timestamp (in seconds) of when the certificate expires.
            def expires_at=: (Integer) -> Integer

            # The Unix timestamp (in seconds) of when the certificate becomes valid.
            attr_reader valid_at: Integer?

            # The Unix timestamp (in seconds) of when the certificate becomes valid.
            def valid_at=: (Integer) -> Integer

            # @param expires_at
            #   The Unix timestamp (in seconds) of when the certificate expires.
            # @param valid_at
            #   The Unix timestamp (in seconds) of when the certificate becomes valid.
            def initialize: (?expires_at: Integer, ?valid_at: Integer) -> void

            def to_hash: -> { ?expires_at: Integer, ?valid_at: Integer }
          end
        end
      end
    end
  end
end
