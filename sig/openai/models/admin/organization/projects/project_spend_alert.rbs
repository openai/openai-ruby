module OpenAI
  module Models
    module Admin
      module Organization
        class ProjectSpendAlert = Projects::ProjectSpendAlert

        module Projects
          type project_spend_alert =
            {
              id: String,
              currency: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::currency,
              interval: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::interval,
              notification_channel: OpenAI::Admin::Organization::Projects::ProjectSpendAlert::NotificationChannel,
              ?object: :"project.spend_alert",
              threshold_amount: Integer
            }

          class ProjectSpendAlert < OpenAI::Internal::Type::BaseModel
            # The identifier, which can be referenced in API endpoints.
            attr_accessor id: String

            # The currency for the threshold amount.
            attr_accessor currency: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::currency

            # The time interval for evaluating spend against the threshold.
            attr_accessor interval: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::interval

            # Email notification settings for a spend alert.
            attr_accessor notification_channel: OpenAI::Admin::Organization::Projects::ProjectSpendAlert::NotificationChannel

            # The object type, which is always `project.spend_alert`.
            attr_accessor object: :"project.spend_alert"

            # The alert threshold amount, in cents.
            attr_accessor threshold_amount: Integer

            # @param id
            #   The identifier, which can be referenced in API endpoints.
            # @param currency
            #   The currency for the threshold amount.
            # @param interval
            #   The time interval for evaluating spend against the threshold.
            # @param notification_channel
            #   Email notification settings for a spend alert.
            # @param threshold_amount
            #   The alert threshold amount, in cents.
            # @param object
            #   The object type, which is always `project.spend_alert`.
            def initialize: (
              id: String,
              currency: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::currency,
              interval: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::interval,
              notification_channel: OpenAI::Admin::Organization::Projects::ProjectSpendAlert::NotificationChannel,
              threshold_amount: Integer,
              ?object: :"project.spend_alert"
            ) -> void

            def to_hash: -> {
              id: String,
              currency: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::currency,
              interval: OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::interval,
              notification_channel: OpenAI::Admin::Organization::Projects::ProjectSpendAlert::NotificationChannel,
              ?object: :"project.spend_alert",
              threshold_amount: Integer
            }

            type currency = :USD

            module Currency
              extend OpenAI::Internal::Type::Enum

              USD: :USD

              def self?.values: -> ::Array[OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::currency]
            end

            type interval = :month

            module Interval
              extend OpenAI::Internal::Type::Enum

              MONTH: :month

              def self?.values: -> ::Array[OpenAI::Models::Admin::Organization::Projects::ProjectSpendAlert::interval]
            end

            type notification_channel =
              {
                recipients: ::Array[String],
                ?type: :email,
                ?subject_prefix: String?
              }

            class NotificationChannel < OpenAI::Internal::Type::BaseModel
              # Email addresses that receive the spend alert notification.
              attr_accessor recipients: ::Array[String]

              # The notification channel type. Currently only `email` is supported.
              attr_accessor type: :email

              # Optional subject prefix for alert emails.
              attr_accessor subject_prefix: String?

              # @param recipients
              #   Email addresses that receive the spend alert notification.
              # @param subject_prefix
              #   Optional subject prefix for alert emails.
              # @param type
              #   The notification channel type. Currently only `email` is supported.
              def initialize: (
                recipients: ::Array[String],
                ?subject_prefix: String?,
                ?type: :email
              ) -> void

              def to_hash: -> {
                recipients: ::Array[String],
                ?type: :email,
                ?subject_prefix: String?
              }
            end
          end
        end
      end
    end
