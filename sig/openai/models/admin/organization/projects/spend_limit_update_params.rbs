module OpenAI
  module Models
    module Admin
      module Organization
        module Projects
          type spend_limit_update_params =
            {
              project_id: String,
              currency: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::currency,
              interval: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::interval,
              threshold_amount: Integer,
              ?notification_channel: OpenAI::Admin::Organization::Projects::SpendLimitUpdateParams::NotificationChannel?,
              ?request_options: OpenAI::request_opts
            }

          class SpendLimitUpdateParams < OpenAI::Internal::Type::BaseModel
            extend OpenAI::Internal::Type::RequestParameters::Converter
            include OpenAI::Internal::Type::RequestParameters

            attr_accessor project_id: String

            # The currency for the threshold amount. Currently, only `USD` is supported.
            attr_accessor currency: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::currency

            # The time interval for evaluating spend against the threshold. Currently, only
            # `month` is supported.
            attr_accessor interval: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::interval

            # The hard spend limit amount, in cents.
            attr_accessor threshold_amount: Integer

            # Configure email notifications when the spend limit is reached. Leave this out to
            # keep the current settings, or send null to reset to owner-only notifications.
            attr_accessor notification_channel: OpenAI::Admin::Organization::Projects::SpendLimitUpdateParams::NotificationChannel?

            # @param currency
            #   The currency for the threshold amount. Currently, only `USD` is supported.
            # @param interval
            #   The time interval for evaluating spend against the threshold. Currently, only
            #   `month` is supported.
            # @param threshold_amount
            #   The hard spend limit amount, in cents.
            # @param notification_channel
            #   Configure email notifications when the spend limit is reached. Leave this out to
            #   keep the current settings, or send null to reset to owner-only notifications.
            def initialize: (
              project_id: String,
              currency: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::currency,
              interval: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::interval,
              threshold_amount: Integer,
              ?notification_channel: OpenAI::Admin::Organization::Projects::SpendLimitUpdateParams::NotificationChannel?,
              ?request_options: OpenAI::request_opts
            ) -> void

            def to_hash: -> {
              project_id: String,
              currency: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::currency,
              interval: OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::interval,
              threshold_amount: Integer,
              ?notification_channel: OpenAI::Admin::Organization::Projects::SpendLimitUpdateParams::NotificationChannel?,
              ?request_options: OpenAI::RequestOptions
            }

            type currency = :USD

            module Currency
              extend OpenAI::Internal::Type::Enum

              USD: :USD

              def self?.values: -> ::Array[OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::currency]
            end

            type interval = :month

            module Interval
              extend OpenAI::Internal::Type::Enum

              MONTH: :month

              def self?.values: -> ::Array[OpenAI::Models::Admin::Organization::Projects::SpendLimitUpdateParams::interval]
            end

            type notification_channel =
              {
                ?type: :email,
                ?recipients: ::Array[String],
                ?subject_prefix: String?
              }

            class NotificationChannel < OpenAI::Internal::Type::BaseModel
              attr_accessor type: :email

              # Additional email recipients. Omit to keep them unchanged; send [] to clear them.
              attr_reader recipients: ::Array[String]?

              # Additional email recipients. Omit to keep them unchanged; send [] to clear them.
              def recipients=: (::Array[String]) -> ::Array[String]

              # Email subject prefix. Omit to keep it unchanged; send null or an empty string to
              # clear it.
              attr_accessor subject_prefix: String?

              # @param recipients
              #   Additional email recipients. Omit to keep them unchanged; send [] to clear them.
              # @param subject_prefix
              #   Email subject prefix. Omit to keep it unchanged; send null or an empty string to
              #   clear it.
              def initialize: (
                ?recipients: ::Array[String],
                ?subject_prefix: String?,
                ?type: :email
              ) -> void

              def to_hash: -> {
                ?type: :email,
                ?recipients: ::Array[String],
                ?subject_prefix: String?
              }
            end
          end
        end
      end
    end
  end
