module OpenAI
  module Models
    module Admin
      module Organization
        class ProjectGroup = Projects::ProjectGroup

        module Projects
          type project_group =
            {
              created_at: Integer,
              group_id: String,
              group_name: String,
              group_type: OpenAI::Models::Admin::Organization::Projects::ProjectGroup::group_type,
              ?object: :"project.group",
              project_id: String
            }

          class ProjectGroup < OpenAI::Internal::Type::BaseModel
            # Unix timestamp (in seconds) when the group was granted project access.
            attr_accessor created_at: Integer

            # Identifier of the group that has access to the project.
            attr_accessor group_id: String

            # Display name of the group.
            attr_accessor group_name: String

            # The type of the group.
            attr_accessor group_type: OpenAI::Models::Admin::Organization::Projects::ProjectGroup::group_type

            # Always `project.group`.
            attr_accessor object: :"project.group"

            # Identifier of the project.
            attr_accessor project_id: String

            # @param created_at
            #   Unix timestamp (in seconds) when the group was granted project access.
            # @param group_id
            #   Identifier of the group that has access to the project.
            # @param group_name
            #   Display name of the group.
            # @param group_type
            #   The type of the group.
            # @param project_id
            #   Identifier of the project.
            # @param object
            #   Always `project.group`.
            def initialize: (
              created_at: Integer,
              group_id: String,
              group_name: String,
              group_type: OpenAI::Models::Admin::Organization::Projects::ProjectGroup::group_type,
              project_id: String,
              ?object: :"project.group"
            ) -> void

            def to_hash: -> {
              created_at: Integer,
              group_id: String,
              group_name: String,
              group_type: OpenAI::Models::Admin::Organization::Projects::ProjectGroup::group_type,
              ?object: :"project.group",
              project_id: String
            }

            type group_type = :group | :tenant_group

            module GroupType
              extend OpenAI::Internal::Type::Enum

              GROUP: :group
              TENANT_GROUP: :tenant_group

              def self?.values: -> ::Array[OpenAI::Models::Admin::Organization::Projects::ProjectGroup::group_type]
            end
          end
        end
      end
    end
  end
end
