module OpenAI
  module Models
    module Admin
      module Organization
        module Projects
          module ServiceAccounts
            type api_key_create_response =
              {
                id: String,
                created_at: Integer,
                name: String,
                ?object: :"organization.project.service_account.api_key",
                value: String,
                ?expires_at: Integer?
              }

            class APIKeyCreateResponse < OpenAI::Internal::Type::BaseModel
              # The identifier of the API key.
              attr_accessor id: String

              # The Unix timestamp (in seconds) when the API key was created.
              attr_accessor created_at: Integer

              # The name of the API key.
              attr_accessor name: String

              # The object type, which is always `organization.project.service_account.api_key`
              attr_accessor object: :"organization.project.service_account.api_key"

              # The unredacted API key value.
              attr_accessor value: String

              # The Unix timestamp (in seconds) when the API key expires, or null if it does not
              # expire.
              attr_accessor expires_at: Integer?

              # @param id
              #   The identifier of the API key.
              # @param created_at
              #   The Unix timestamp (in seconds) when the API key was created.
              # @param name
              #   The name of the API key.
              # @param value
              #   The unredacted API key value.
              # @param expires_at
              #   The Unix timestamp (in seconds) when the API key expires, or null if it does not
              #   expire.
              # @param object
              #   The object type, which is always `organization.project.service_account.api_key`
              def initialize: (
                id: String,
                created_at: Integer,
                name: String,
                value: String,
                ?expires_at: Integer?,
                ?object: :"organization.project.service_account.api_key"
              ) -> void

              def to_hash: -> {
                id: String,
                created_at: Integer,
                name: String,
                ?object: :"organization.project.service_account.api_key",
                value: String,
                ?expires_at: Integer?
              }
            end
          end
        end
      end
    end
  end
end
