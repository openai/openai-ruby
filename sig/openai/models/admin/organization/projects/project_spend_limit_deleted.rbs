module OpenAI
  module Models
    module Admin
      module Organization
        class ProjectSpendLimitDeleted = Projects::ProjectSpendLimitDeleted

        module Projects
          type project_spend_limit_deleted =
            { deleted: bool, ?object: :"project.spend_limit.deleted" }

          class ProjectSpendLimitDeleted < OpenAI::Internal::Type::BaseModel
            # Whether the hard spend limit was deleted.
            attr_accessor deleted: bool

            # The object type, which is always `project.spend_limit.deleted`.
            attr_accessor object: :"project.spend_limit.deleted"

            # @param deleted
            #   Whether the hard spend limit was deleted.
            # @param object
            #   The object type, which is always `project.spend_limit.deleted`.
            def initialize: (
              deleted: bool,
              ?object: :"project.spend_limit.deleted"
            ) -> void

            def to_hash: -> {
              deleted: bool,
              ?object: :"project.spend_limit.deleted"
            }
          end
        end
      end
    end
  end
end
