module OpenAI
  module Models
    module Admin
      module Organization
        module Projects
          type group_delete_response =
            { deleted: bool, ?object: :"project.group.deleted" }

          class GroupDeleteResponse < OpenAI::Internal::Type::BaseModel
            # Whether the group membership in the project was removed.
            attr_accessor deleted: bool

            # Always `project.group.deleted`.
            attr_accessor object: :"project.group.deleted"

            # @param deleted
            #   Whether the group membership in the project was removed.
            # @param object
            #   Always `project.group.deleted`.
            def initialize: (
              deleted: bool,
              ?object: :"project.group.deleted"
            ) -> void

            def to_hash: -> { deleted: bool, ?object: :"project.group.deleted" }
          end
        end
      end
    end
  end
end
