module OpenAI
  module Models
    module Admin
      module Organization
        type project_update_params =
          {
            project_id: String,
            ?external_key_id: String?,
            ?geography: String?,
            ?name: String?,
            ?request_options: OpenAI::request_opts
          }

        class ProjectUpdateParams < OpenAI::Internal::Type::BaseModel
          extend OpenAI::Internal::Type::RequestParameters::Converter
          include OpenAI::Internal::Type::RequestParameters

          attr_accessor project_id: String

          # External key ID to associate with the project.
          attr_accessor external_key_id: String?

          # Geography for the project. Deprecated: use `residency` when creating a project
          # to configure data residency. This field is retained for backward compatibility.
          attr_accessor geography: String?

          # The updated name of the project, this name appears in reports.
          attr_accessor name: String?

          # @param external_key_id
          #   External key ID to associate with the project.
          # @param geography
          #   Geography for the project. Deprecated: use `residency` when creating a project
          #   to configure data residency. This field is retained for backward compatibility.
          # @param name
          #   The updated name of the project, this name appears in reports.
          def initialize: (
            project_id: String,
            ?external_key_id: String?,
            ?geography: String?,
            ?name: String?,
            ?request_options: OpenAI::request_opts
          ) -> void

          def to_hash: -> {
            project_id: String,
            ?external_key_id: String?,
            ?geography: String?,
            ?name: String?,
            ?request_options: OpenAI::RequestOptions
          }
        end
      end
    end
  end
end
