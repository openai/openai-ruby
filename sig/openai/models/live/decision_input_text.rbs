module OpenAI
  module Models
    module Live
      type decision_input_text = { text: String, ?type: :input_text }

      class DecisionInputText < OpenAI::Internal::Type::BaseModel
        # The text input to the model.
        attr_accessor text: String

        attr_accessor type: :input_text

        # @param text
        #   The text input to the model.
        def initialize: (text: String, ?type: :input_text) -> void

        def to_hash: -> { text: String, ?type: :input_text }
      end
    end
  end
end
