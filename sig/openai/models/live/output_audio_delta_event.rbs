module OpenAI
  module Models
    module Live
      type output_audio_delta_event =
        {
          delta: String,
          ?type: :"session.output_audio.delta",
          ?end_ms: Integer,
          ?start_ms: Integer
        }

      class OutputAudioDeltaEvent < OpenAI::Internal::Type::BaseModel
        attr_accessor delta: String

