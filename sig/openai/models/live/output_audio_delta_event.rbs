        attr_reader end_ms: Integer?

        def end_ms=: (Integer) -> Integer

        attr_reader start_ms: Integer?

        def start_ms=: (Integer) -> Integer

        def initialize: (
          delta: String,
          ?end_ms: Integer,
          ?start_ms: Integer,
          ?type: :"session.output_audio.delta"
        ) -> void

        def to_hash: -> {
          delta: String,
          ?type: :"session.output_audio.delta",
          ?end_ms: Integer,
          ?start_ms: Integer
        }
      end
    end
  end
end
