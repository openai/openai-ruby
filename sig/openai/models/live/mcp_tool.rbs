          ?require_approval: OpenAI::Models::Live::McpTool::require_approval?,
          ?server_description: String?,
          ?server_label: String,
          ?server_url: String?,
          ?tunnel_id: String?
        }

        type allowed_caller = :direct | :programmatic

        module AllowedCaller
          extend OpenAI::Internal::Type::Enum

          DIRECT: :direct
          PROGRAMMATIC: :programmatic

          def self?.values: -> ::Array[OpenAI::Models::Live::McpTool::allowed_caller]
