        type allowed_tools = ::Array[String] | OpenAI::Live::McpToolFilter

        module AllowedTools
          extend OpenAI::Internal::Type::Union

          def self?.variants: -> ::Array[OpenAI::Models::Live::McpTool::allowed_tools]

