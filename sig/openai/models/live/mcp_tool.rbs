        {
          ?type: :mcp,
          ?allowed_callers: ::Array[OpenAI::Models::Live::McpTool::allowed_caller]?,
          ?allowed_tools: OpenAI::Models::Live::McpTool::allowed_tools?,
          ?authorization: String?,
          ?connector_id: String?,
          ?defer_loading: bool?,
          ?headers: ::Hash[Symbol, String]?,
