module OpenAI
  module Models
    module Live
      type media_session_fork_config =
        {
          ?client: OpenAI::Live::ClientConfig,
          ?delegation: OpenAI::Live::MediaSessionForkConfig::Delegation,
          ?store: bool
        }

      class MediaSessionForkConfig < OpenAI::Internal::Type::BaseModel
        # Startup-only capabilities for an untrusted frontend attached to a unified WebRTC
        # session. Trusted sideband connections are unaffected.
        attr_reader client: OpenAI::Live::ClientConfig?

        # Startup-only capabilities for an untrusted frontend attached to a unified WebRTC
        # session. Trusted sideband connections are unaffected.
        def client=: (OpenAI::Live::ClientConfig) -> OpenAI::Live::ClientConfig

        # Update the Responses backend for an existing Live session without changing
        # delegation ownership.
        attr_reader delegation: OpenAI::Live::MediaSessionForkConfig::Delegation?

        # Update the Responses backend for an existing Live session without changing
        # delegation ownership.
        def delegation=: (
          OpenAI::Live::MediaSessionForkConfig::Delegation
        ) -> OpenAI::Live::MediaSessionForkConfig::Delegation

        # Whether to store the forked session. Omission inherits the stored session's
        # setting.
        attr_reader store: bool?

        # Whether to store the forked session. Omission inherits the stored session's
        # setting.
        def store=: (bool) -> bool

        # @param client
        #   Startup-only capabilities for an untrusted frontend attached to a unified WebRTC
        #   session. Trusted sideband connections are unaffected.
        # @param delegation
        #   Update the Responses backend for an existing Live session without changing
        #   delegation ownership.
        # @param store
        #   Whether to store the forked session. Omission inherits the stored session's
        #   setting.
        def initialize: (
          ?client: OpenAI::Live::ClientConfig,
          ?delegation: OpenAI::Live::MediaSessionForkConfig::Delegation,
          ?store: bool
        ) -> void

        def to_hash: -> {
          ?client: OpenAI::Live::ClientConfig,
          ?delegation: OpenAI::Live::MediaSessionForkConfig::Delegation,
          ?store: bool
        }

        type delegation =
          {
            ?type: :responses,
            ?acknowledgement_delay_ms: Integer,
            ?responses: OpenAI::Live::ResponsesDelegationUpdateConfig
          }

        class Delegation < OpenAI::Internal::Type::BaseModel
          # The delegation owner. Always `responses` for tasks handled by the Responses API.
          attr_accessor type: :responses

          # Milliseconds to wait before requesting an automatic spoken acknowledgement for a
          # delegation. The model may still speak before this delay. Any commentary or
          # thinking appended to the session cancels all pending acknowledgements, including
          # those for other delegations. Defaults to 400 for Decisions sessions and 0
          # (request immediately) for other sessions. Omission in a session update preserves
          # the current value. Updates apply to subsequent delegations.
          attr_reader acknowledgement_delay_ms: Integer?

          # Milliseconds to wait before requesting an automatic spoken acknowledgement for a
          # delegation. The model may still speak before this delay. Any commentary or
          # thinking appended to the session cancels all pending acknowledgements, including
          # those for other delegations. Defaults to 400 for Decisions sessions and 0
          # (request immediately) for other sessions. Omission in a session update preserves
          # the current value. Updates apply to subsequent delegations.
          def acknowledgement_delay_ms=: (Integer) -> Integer

          # Responses backend settings to update. Omitted settings keep their existing
          # values.
          attr_reader responses: OpenAI::Live::ResponsesDelegationUpdateConfig?

          # Responses backend settings to update. Omitted settings keep their existing
          # values.
          def responses=: (
            OpenAI::Live::ResponsesDelegationUpdateConfig
          ) -> OpenAI::Live::ResponsesDelegationUpdateConfig

          # @param acknowledgement_delay_ms
          #   Milliseconds to wait before requesting an automatic spoken acknowledgement for a
          #   delegation. The model may still speak before this delay. Any commentary or
          #   thinking appended to the session cancels all pending acknowledgements, including
          #   those for other delegations. Defaults to 400 for Decisions sessions and 0
          #   (request immediately) for other sessions. Omission in a session update preserves
          #   the current value. Updates apply to subsequent delegations.
          # @param responses
          #   Responses backend settings to update. Omitted settings keep their existing
          #   values.
          # @param type
          #   The delegation owner. Always `responses` for tasks handled by the Responses API.
          def initialize: (
            ?acknowledgement_delay_ms: Integer,
            ?responses: OpenAI::Live::ResponsesDelegationUpdateConfig,
            ?type: :responses
          ) -> void

          def to_hash: -> {
            ?type: :responses,
            ?acknowledgement_delay_ms: Integer,
            ?responses: OpenAI::Live::ResponsesDelegationUpdateConfig
          }
        end
      end
    end
  end
end
