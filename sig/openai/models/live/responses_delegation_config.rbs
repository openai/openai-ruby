            MEDIUM: :medium
            HIGH: :high
            XHIGH: :xhigh

            def self?.values: -> ::Array[OpenAI::Models::Live::ResponsesDelegationConfig::Reasoning::effort]
          end

          type summary = :concise | :detailed | :auto

