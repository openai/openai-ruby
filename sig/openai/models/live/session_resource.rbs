        end

        type delegation =
          OpenAI::Live::ClientDelegation
          | OpenAI::Live::SessionResource::Delegation::Responses

        module Delegation
          extend OpenAI::Internal::Type::Union

          type responses =
            {
              responses: OpenAI::Live::ResponsesDelegationConfig,
              ?type: :responses
            }

          class Responses < OpenAI::Internal::Type::BaseModel
            attr_accessor responses: OpenAI::Live::ResponsesDelegationConfig

