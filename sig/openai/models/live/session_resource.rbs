          ?delegation: OpenAI::Models::Live::SessionResource::delegation?,
          ?input: ::Array[OpenAI::Models::Live::initial_item],
          ?instructions: String?,
          ?store: bool
        }

      class SessionResource < OpenAI::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor expires_at: Integer

        attr_accessor model: OpenAI::Models::Live::SessionResource::model

        attr_accessor status: :active

        attr_reader audio: OpenAI::Live::SessionResource::Audio?

        def audio=: (
