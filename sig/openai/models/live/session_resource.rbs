          ?delegation: OpenAI::Models::Live::SessionResource::delegation?,
          ?input: ::Array[OpenAI::Models::Live::initial_item],
          ?instructions: String?,
          ?store: bool
        }

        type model = String | :"gpt-live-1"

        module Model
          extend OpenAI::Internal::Type::Union

          def self?.variants: -> ::Array[OpenAI::Models::Live::SessionResource::model]

          GPT_LIVE_1: :"gpt-live-1"
        end

        type audio =
          {
            ?format_: OpenAI::Models::Live::audio_format,
            ?output: OpenAI::Live::SessionResource::Audio::Output
          }

        class Audio < OpenAI::Internal::Type::BaseModel
          attr_reader format_: OpenAI::Models::Live::audio_format?

