          expires_at: Integer,
          model: OpenAI::Models::Live::SessionResource::model,
          ?audio: OpenAI::Live::SessionResource::Audio,
          ?client: OpenAI::Live::ClientConfig,
          ?delegation: OpenAI::Models::Live::SessionResource::delegation?,
          ?input: ::Array[OpenAI::Models::Live::initial_item],
          ?instructions: String?,
