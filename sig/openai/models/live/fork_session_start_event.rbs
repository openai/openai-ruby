module OpenAI
  module Models
    module Live
      type fork_session_start_event =
        {
          session: OpenAI::Live::ForkSessionConfig,
          ?type: :"session.start",
          ?event_id: String?
        }

      class ForkSessionStartEvent < OpenAI::Internal::Type::BaseModel
        # Overrides for a stored session after connecting to the fork WebSocket. An empty
        # object inherits the stored configuration; do not supply a new model.
        # audio.format applies only to the new WebSocket connection. client overrides are
        # only supported for WebRTC forks.
        attr_accessor session: OpenAI::Live::ForkSessionConfig

        # The Live client event type. Always `session.start`.
        attr_accessor type: :"session.start"

        # Optional client identifier for correlating this command with a server event's
        # client_event_id or error.client_event_id.
        attr_accessor event_id: String?

        # @param session
        #   Overrides for a stored session after connecting to the fork WebSocket. An empty
        #   object inherits the stored configuration; do not supply a new model.
        #   audio.format applies only to the new WebSocket connection. client overrides are
        #   only supported for WebRTC forks.
        # @param event_id
        #   Optional client identifier for correlating this command with a server event's
        #   client_event_id or error.client_event_id.
        # @param type
        #   The Live client event type. Always `session.start`.
        def initialize: (
          session: OpenAI::Live::ForkSessionConfig,
          ?event_id: String?,
          ?type: :"session.start"
        ) -> void

        def to_hash: -> {
          session: OpenAI::Live::ForkSessionConfig,
          ?type: :"session.start",
          ?event_id: String?
        }
      end
    end
  end
end
