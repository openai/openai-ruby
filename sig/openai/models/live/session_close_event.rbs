module OpenAI
  module Models
    module Live
      type session_close_event = { ?type: :"session.close", ?event_id: String? }

      class SessionCloseEvent < OpenAI::Internal::Type::BaseModel
        # The Live client event type. Always `session.close`.
        attr_accessor type: :"session.close"

        # Optional client identifier for correlating this command with a server event's
        # client_event_id or error.client_event_id.
        attr_accessor event_id: String?

        # @param event_id
        #   Optional client identifier for correlating this command with a server event's
        #   client_event_id or error.client_event_id.
        # @param type
        #   The Live client event type. Always `session.close`.
        def initialize: (?event_id: String?, ?type: :"session.close") -> void

        def to_hash: -> { ?type: :"session.close", ?event_id: String? }
      end
    end
  end
end
