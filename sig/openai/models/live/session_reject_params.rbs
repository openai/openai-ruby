        attr_accessor session_id: String

        attr_accessor status_code: Integer

        def initialize: (
          session_id: String,
          status_code: Integer,
          ?request_options: OpenAI::request_opts
        ) -> void

        def to_hash: -> {
          session_id: String,
          status_code: Integer,
          ?request_options: OpenAI::RequestOptions
        }
