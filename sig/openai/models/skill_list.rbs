module OpenAI
  module Models
    type skill_list =
      {
        data: ::Array[OpenAI::Skill],
        first_id: String?,
        has_more: bool,
        last_id: String?,
        ?object: :list
      }

    class SkillList < OpenAI::Internal::Type::BaseModel
      # A list of items
      attr_accessor data: ::Array[OpenAI::Skill]

      # The ID of the first item in the list.
      attr_accessor first_id: String?

      # Whether there are more items available.
      attr_accessor has_more: bool

      # The ID of the last item in the list.
      attr_accessor last_id: String?

      # The type of object returned, must be `list`.
      attr_accessor object: :list

      # @param data
      #   A list of items
      # @param first_id
      #   The ID of the first item in the list.
      # @param has_more
      #   Whether there are more items available.
      # @param last_id
      #   The ID of the last item in the list.
      # @param object
      #   The type of object returned, must be `list`.
      def initialize: (
        data: ::Array[OpenAI::Skill],
        first_id: String?,
        has_more: bool,
        last_id: String?,
        ?object: :list
      ) -> void

      def to_hash: -> {
        data: ::Array[OpenAI::Skill],
        first_id: String?,
        has_more: bool,
        last_id: String?,
        ?object: :list
      }
    end
  end
end
