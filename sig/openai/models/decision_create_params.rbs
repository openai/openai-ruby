          ?mode: OpenAI::Models::DecisionCreateParams::PromptCacheOptions::mode?,
          ?ttl: OpenAI::Models::DecisionCreateParams::PromptCacheOptions::ttl
        }

        type mode = :implicit | :explicit

        module Mode
          extend OpenAI::Internal::Type::Enum

          IMPLICIT: :implicit
          EXPLICIT: :explicit

          def self?.values: -> ::Array[OpenAI::Models::DecisionCreateParams::PromptCacheOptions::mode]
        end

        type ttl = :"30m"

        module Ttl
