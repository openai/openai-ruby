          ?mode: OpenAI::Models::DecisionCreateParams::PromptCacheOptions::mode?,
          ?ttl: OpenAI::Models::DecisionCreateParams::PromptCacheOptions::ttl
        }

      class PromptCacheOptions < OpenAI::Internal::Type::BaseModel
        # Controls whether OpenAI automatically creates an implicit cache breakpoint.
        # Defaults to `implicit`. With `implicit`, OpenAI creates one implicit breakpoint
        # and writes up to the latest three explicit breakpoints in the request. With
        # `explicit`, OpenAI does not create an implicit breakpoint and writes up to the
        # latest four explicit breakpoints. If there are no explicit breakpoints, the
        # request does not use prompt caching.
        attr_accessor mode: OpenAI::Models::DecisionCreateParams::PromptCacheOptions::mode?

        # The minimum lifetime applied to every implicit and explicit cache breakpoint
        # written by the request. Defaults to `30m`, which is currently the only supported
        # value. The backend may retain cache entries for longer.
        attr_reader ttl: OpenAI::Models::DecisionCreateParams::PromptCacheOptions::ttl?

        # The minimum lifetime applied to every implicit and explicit cache breakpoint
        # written by the request. Defaults to `30m`, which is currently the only supported
        # value. The backend may retain cache entries for longer.
        def ttl=: (
          OpenAI::Models::DecisionCreateParams::PromptCacheOptions::ttl
        ) -> OpenAI::Models::DecisionCreateParams::PromptCacheOptions::ttl

        # @param mode
        #   Controls whether OpenAI automatically creates an implicit cache breakpoint.
        #   Defaults to `implicit`. With `implicit`, OpenAI creates one implicit breakpoint
        #   and writes up to the latest three explicit breakpoints in the request. With
        #   `explicit`, OpenAI does not create an implicit breakpoint and writes up to the
        #   latest four explicit breakpoints. If there are no explicit breakpoints, the
        #   request does not use prompt caching.
        # @param ttl
        #   The minimum lifetime applied to every implicit and explicit cache breakpoint
        #   written by the request. Defaults to `30m`, which is currently the only supported
        #   value. The backend may retain cache entries for longer.
        def initialize: (
