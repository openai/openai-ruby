module OpenAI
  module Models
    module FineTuning
      type job_list_params =
        {
          ?after: String,
          ?limit: Integer,
          ?metadata: ::Hash[Symbol, String]?,
          ?request_options: OpenAI::request_opts
        }

      class JobListParams < OpenAI::Internal::Type::BaseModel
        extend OpenAI::Internal::Type::RequestParameters::Converter
