module OpenAI
  module Auth
    # @api private
    class WorkloadIdentityAuth
      def initialize: (
        OpenAI::Auth::WorkloadIdentity
        | OpenAI::Auth::X509WorkloadIdentity config,
        String? organization_id,
        ?token_exchange_url: String,
        ?http_client: OpenAI::_HTTPClient?,
        ?sleeper: ^(Float) -> void,
        ?monotonic_clock: ^-> Float
      ) -> void

      # @api private
      def get_token: -> String

      # @api private
      def invalidate_token: (?String? rejected_token) -> void

      # @api private
      def current_token?: (String? token) -> bool

      # @api private
      def inspect: -> String

      private

      # @api private
      def fetch_token_from_exchange: -> OpenAI::Auth::TokenExchange::token_data

      # @api private
      def handle_token_response: (
        Net::HTTPResponse response
      ) -> OpenAI::Auth::TokenExchange::token_data

      # @api private
      def parse_response_body: (Net::HTTPResponse response) -> untyped
    end
  end
end
