#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "pathname"
require "yaml"

module OpenAI
  module RBSValidation
    # These dependencies either have no standalone RBS library or are already
    # loaded by RBS core. `net/http` is published under a different RBS name.
    EXCLUDED_LIBRARIES = %w[English etc rbconfig set stringio].freeze
    LIBRARY_NAMES = {"net/http" => "net-http"}.freeze
    ANSI_ESCAPE = /\e\[[\d;]*m/

    LOCATION = %r{
      (?<file>[^\s:]+\.rbs):
      (?<line>\d+):(?<column>\d+)
      (?:\.\.\.(?<end_line>\d+):(?<end_column>\d+))?
      :\s*(?<message>[^\n]+)
    }x

    module_function

    def run(root: Pathname.pwd, stdout: $stdout, stderr: $stderr, env: ENV.to_h)
      signatures = signature_paths(root)
      raise "No RBS files found under #{root.join("sig")}" if signatures.empty?
      return 1 unless valid_contents?(root, signatures, stdout: stdout, stderr: stderr, env: env)

      parse_status = run_command(
        root,
        [rbs_command(env), "parse", "sig"],
        stdout: stdout,
        stderr: stderr,
        env: env
      )
      return 1 unless parse_status.success?

      command = [rbs_command(env), "-I", "sig", "--no-collection"]
      libraries(root).each { command.push("-r", _1) }
      command << "validate"

      validation_status = run_command(root, command, stdout: stdout, stderr: stderr, env: env)
      return 1 unless validation_status.success?

      noun = signatures.one? ? "file" : "files"
      stdout.puts("Validated #{signatures.size} RBS #{noun} with no errors.")
      0
    rescue StandardError => e
      message = if e.respond_to?(:detailed_message)
        e.detailed_message(highlight: false)
      else
        "#{e.class}: #{e.message}"
      end

      stderr.puts(message)
      1
    end

    def signature_paths(root)
      Dir.glob(root.join("sig/**/*.rbs")).map { Pathname(_1) }
    end

    private_class_method :signature_paths

    def libraries(root)
      manifest = YAML.safe_load_file(root.join("manifest.yaml"), symbolize_names: true)
      dependencies = manifest.fetch(:dependencies)

      dependencies.filter_map do |dependency|
        next if EXCLUDED_LIBRARIES.include?(dependency)

        LIBRARY_NAMES.fetch(dependency, dependency)
      end
    end

    private_class_method :libraries

    def rbs_command(env)
      env.fetch("RBS_COMMAND", "rbs")
    end

    private_class_method :rbs_command

    def valid_contents?(root, signatures, stdout:, stderr:, env:)
      signatures.each do |path|
        contents = path.binread
        message = if !contents.force_encoding(Encoding::UTF_8).valid_encoding?
          "invalid byte sequence in UTF-8"
        elsif contents.include?("\0")
          "string contains null byte"
        end

        next unless message

        relative_path = path.relative_path_from(root).to_s
        diagnostic = "#{relative_path}: #{message}"
        stderr.puts(diagnostic)
        emit_annotation(relative_path, "1", "1", nil, nil, diagnostic, stdout: stdout) if env.key?("CI")
        return false
      end

      true
    end

    private_class_method :valid_contents?

    def run_command(root, command, stdout:, stderr:, env:)
      output, errors, status = Open3.capture3(env, *command, chdir: root.to_s)
      unless status.success?
        output = output.gsub(ANSI_ESCAPE, "")
        errors = errors.gsub(ANSI_ESCAPE, "")
        stdout.print(output)
        stderr.print(errors)
        emit_github_annotations(output, errors, stdout: stdout) if env.key?("CI")
      end

      status
    end

    private_class_method :run_command

    def emit_github_annotations(output, errors, stdout:)
      "#{output}\n#{errors}".scan(LOCATION).uniq.each do |match|
        file, line, column, end_line, end_column, message = match
        end_column = Integer(end_column) + 1 if end_column
        emit_annotation(file, line, Integer(column) + 1, end_line, end_column, message, stdout: stdout)
      end
    end

    private_class_method :emit_github_annotations

    def emit_annotation(file, line, column, end_line, end_column, message, stdout:)
      metadata = ["file=#{property_escape(file)}", "line=#{line}", "col=#{column}"]
      metadata << "endLine=#{end_line}" if end_line
      metadata << "endColumn=#{end_column}" if end_column
      stdout.puts("::error #{metadata.join(",")}::#{annotation_escape(message)}")
    end

    private_class_method :emit_annotation

    def property_escape(value)
      annotation_escape(value.to_s).gsub(":", "%3A").gsub(",", "%2C")
    end

    private_class_method :property_escape

    def annotation_escape(value)
      value.to_s.gsub("%", "%25").gsub("\r", "%0D").gsub("\n", "%0A")
    end

    private_class_method :annotation_escape
  end
end

exit(OpenAI::RBSValidation.run) if $PROGRAM_NAME == __FILE__
