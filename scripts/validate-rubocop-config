#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "rubocop_config_guard"

if $PROGRAM_NAME == __FILE__
  violations = RuboCopConfigGuard.validate
  if violations.empty?
    puts("Validated RuboCop configuration with no errors.")
  else
    warn(violations.join("\n"))
    exit(1)
  end
end
