#!/usr/bin/env bash

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

tmp_dir=$(mktemp -d)
trap 'rm -rf -- "$tmp_dir"' EXIT

for release in v0.78.0 v0.80.0; do
  mkdir "$tmp_dir/$release"
  git archive "$release" | tar -x -C "$tmp_dir/$release"
  ruby -I"$tmp_dir/$release/lib" scripts/union-characterization >"$tmp_dir/$release.json"
done

echo "Comparing published releases v0.78.0 and v0.80.0..."
diff -u "$tmp_dir/v0.78.0.json" "$tmp_dir/v0.80.0.json"

ruby -Ilib scripts/union-characterization >"$tmp_dir/main.json"

echo "Published releases agree. Their differential from the current checkout follows:"
if diff -u --label v0.78.0-and-v0.80.0 --label current-checkout \
  "$tmp_dir/v0.80.0.json" "$tmp_dir/main.json"
then
  echo "No differences."
else
  status=$?
  if ((status > 1)); then
    exit "$status"
  fi
fi
